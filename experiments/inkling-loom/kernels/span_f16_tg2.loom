          %sb1_0 = scalar.addf %sq1_0, %b1_0 : f32
          %s1_0 = scf.select %ok1_0, %sb1_0, %neg_inf : f32
          %sb1_1 = scalar.addf %sq1_1, %b1_1 : f32
          %s1_1 = scf.select %ok1_1, %sb1_1, %neg_inf : f32
          %bmc1_1 = scalar.maxnumf %s1_0, %s1_1 : f32
          %bx1_8, %by1_8 = kernel.subgroup.shuffle<xor> %bmc1_1, %i8, %i32 : f32, i32, i32
          %bmd1 = scalar.maxnumf %bmc1_1, %bx1_8 : f32
          %bx1_16, %by1_16 = kernel.subgroup.shuffle<xor> %bmd1, %i16, %i32 : f32, i32, i32
          %bm1 = scalar.maxnumf %bmd1, %bx1_16 : f32
          %mn1 = scalar.maxnumf %m1, %bm1 : f32
          %ms1 = scalar.subf %m1, %mn1 : f32
          %al1 = scalar.expf<afn> %ms1 : f32
          %alv1 = vector.splat %al1 : vector<16xf32>
          %as1 = vector.mulf %a1, %alv1 : vector<16xf32>
          %ls1 = scalar.mulf %l1, %al1 : f32
          %ds1_0 = scalar.subf %s1_0, %mn1 : f32
          %ex1_0 = scalar.expf<afn> %ds1_0 : f32
          %e1_0 = scf.select %ok1_0, %ex1_0, %zero_f : f32
          %ll1_0 = scalar.addf %ls1, %e1_0 : f32
          %ev1_0 = vector.splat %e1_0 : vector<16xf32>
          %aa1_0 = vector.fmaf %ev1_0, %v0, %as1 : vector<16xf32>
          %ds1_1 = scalar.subf %s1_1, %mn1 : f32
          %ex1_1 = scalar.expf<afn> %ds1_1 : f32
          %e1_1 = scf.select %ok1_1, %ex1_1, %zero_f : f32
          %ll1_1 = scalar.addf %ll1_0, %e1_1 : f32
          %ev1_1 = vector.splat %e1_1 : vector<16xf32>
          %aa1_1 = vector.fmaf %ev1_1, %v1, %aa1_0 : vector<16xf32>
          scf.yield %mn0, %ll0_1, %aa0_1, %mn1, %ll1_1, %aa1_1 : f32, f32, vector<16xf32>, f32, f32, vector<16xf32>
        }
        vector.store %fa0, %acc_l[%pgr, %quad, %h, %cjj0, %d, %c0] : vector<16xf32>, view<1x4x3x2x8x16xf32>
        vector.store %fa1, %acc_l[%pgr, %quad, %h, %cjj1, %d, %c0] : vector<16xf32>, view<1x4x3x2x8x16xf32>
        scf.if %is_d0 {
          view.store %fl0, %m_l[%pgr, %quad, %h, %cjj0] : f32, view<1x5x3x2xf32>
          view.store %fl1, %m_l[%pgr, %quad, %h, %cjj1] : f32, view<1x5x3x2xf32>
        }
        scf.if %is_l0 {
          view.store %fm0, %m_l[%pgr, %c4, %h, %cjj0] : f32, view<1x5x3x2xf32>
          view.store %fm1, %m_l[%pgr, %c4, %h, %cjj1] : f32, view<1x5x3x2xf32>
        }
        kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
        scf.for %idx = [%tid to %cOUT step %cT] {
          %oh_v = index.div %idx, %cTG128 : index
          %oh = index.assume %oh_v [range(%oh_v, 0, 2)] : index
          %ojr = index.rem %idx, %cTG128 : index
          %oj_v = index.div %ojr, %c128 : index
          %oj = index.assume %oj_v [range(%oj_v, 0, 1)] : index
          %dim_v = index.rem %idx, %c128 : index
          %dim = index.assume %dim_v [range(%dim_v, 0, 127)] : index
          %ojx = index.add %cb, %oj : index
          %owr = index.cmp ult, %ojx, %length : index
          scf.if %owr {
            %mm = scf.for %w = [%c0 to %npa step %c1](%mx = %neg_inf : f32) -> (f32) {
              %wb = index.assume %w [range(%w, 0, 0)] : index
              %mw = view.load %m_l[%wb, %c4, %oh, %oj] : view<1x5x3x2xf32> -> f32
              %mxn = scalar.maxnumf %mx, %mw : f32
              scf.yield %mxn : f32
            }
            %ls_t, %os_t = scf.for %w = [%c0 to %npa step %c1](%lt = %zero_f : f32, %ot = %zero_f : f32) -> (f32, f32) {
              %wb = index.assume %w [range(%w, 0, 0)] : index
              %mw = view.load %m_l[%wb, %c4, %oh, %oj] : view<1x5x3x2xf32> -> f32
              %dw = scalar.subf %mw, %mm : f32
              %fw = scalar.expf<afn> %dw : f32
              %cg0 = index.constant 0 : index
              %lw0 = view.load %m_l[%wb, %cg0, %oh, %oj] : view<1x5x3x2xf32> -> f32
              %ow0 = view.load %acc_r[%wb, %cg0, %oh, %oj, %dim] : view<1x4x3x2x128xf32> -> f32
              %cg1 = index.constant 1 : index
              %lw1 = view.load %m_l[%wb, %cg1, %oh, %oj] : view<1x5x3x2xf32> -> f32
              %ow1 = view.load %acc_r[%wb, %cg1, %oh, %oj, %dim] : view<1x4x3x2x128xf32> -> f32
              %cg2 = index.constant 2 : index
              %lw2 = view.load %m_l[%wb, %cg2, %oh, %oj] : view<1x5x3x2xf32> -> f32
              %ow2 = view.load %acc_r[%wb, %cg2, %oh, %oj, %dim] : view<1x4x3x2x128xf32> -> f32
              %cg3 = index.constant 3 : index
              %lw3 = view.load %m_l[%wb, %cg3, %oh, %oj] : view<1x5x3x2xf32> -> f32
              %ow3 = view.load %acc_r[%wb, %cg3, %oh, %oj, %dim] : view<1x4x3x2x128xf32> -> f32
              %lq01 = scalar.addf %lw0, %lw1 : f32
              %lq23 = scalar.addf %lw2, %lw3 : f32
              %lq = scalar.addf %lq01, %lq23 : f32
              %oq01 = scalar.addf %ow0, %ow1 : f32
              %oq23 = scalar.addf %ow2, %ow3 : f32
              %oq = scalar.addf %oq01, %oq23 : f32
              %ltn = scalar.fmaf %lq, %fw, %lt : f32
              %otn = scalar.fmaf %oq, %fw, %ot : f32
              scf.yield %ltn, %otn : f32, f32
            }
            %otk_v = index.add %first, %ojx : index
            %otk = index.assume %otk_v [range(%otk_v, 0, 8191), lt(%otk_v, %tokens)] : index
            %ohd_v = index.add %hd_base, %oh : index
            %ohd = index.assume %ohd_v [range(%ohd_v, 0, 23)] : index
            view.store %os_t, %po_v[%otk, %ohd, %sp, %dim] : f32, view<[%tokens]x24x64x128xf32>
            %dim0 = index.cmp eq, %dim, %c0 : index
            scf.if %dim0 {
              view.store %mm, %pm_v[%otk, %ohd, %sp] : f32, view<[%tokens]x24x64xf32>
              view.store %ls_t, %pl_v[%otk, %ohd, %sp] : f32, view<[%tokens]x24x64xf32>
            }
          }
        }
        // the next group rewrites the LDS partials
        kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      } else {
        // a later token of the group can have more splits than its first (the combine reads them): neutral partials
        scf.for %idx = [%tid to %cOUT step %cT] {
          %nh_v = index.div %idx, %cTG128 : index
          %njr = index.rem %idx, %cTG128 : index
          %nj = index.div %njr, %c128 : index
          %ndim_v = index.rem %idx, %c128 : index
          %ndim = index.assume %ndim_v [range(%ndim_v, 0, 127)] : index
          %njx = index.add %cb, %nj : index
          %nwr = index.cmp ult, %njx, %length : index
          scf.if %nwr {
            %ntk_v = index.add %first, %njx : index
            %ntk = index.assume %ntk_v [range(%ntk_v, 0, 8191), lt(%ntk_v, %tokens)] : index
            %nhd_v = index.add %hd_base, %nh_v : index
            %nhd = index.assume %nhd_v [range(%nhd_v, 0, 23)] : index
            view.store %zero_f, %po_v[%ntk, %nhd, %sp, %ndim] : f32, view<[%tokens]x24x64x128xf32>
            %ndim0 = index.cmp eq, %ndim, %c0 : index
            scf.if %ndim0 {
              view.store %neg_inf, %pm_v[%ntk, %nhd, %sp] : f32, view<[%tokens]x24x64xf32>
              view.store %zero_f, %pl_v[%ntk, %nhd, %sp] : f32, view<[%tokens]x24x64xf32>
            }
          }
        }
      }
    }
  }
  kernel.return
}
