From: blackhat-7 <44942105+blackhat-7@users.noreply.github.com>
Date: Sun, 1 Nov 2026 04:44:26 +0530
Subject: [PATCH 03/33] Router lever fix: build the warp-32 argmax kernels on
 wave32 HIP (only gfx906 keeps the one-block ones)

74cab323 put STRATA_MULTI_BLOCK_ARGMAX in the gfx1100 table but missed 9773eb79's guard change, so argmax_rows
exited with 'not built for this backend' at the first window capture.
---
 src/kernels/cuda/verify_kernels.cu | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/kernels/cuda/verify_kernels.cu b/src/kernels/cuda/verify_kernels.cu
index 94c68e8ab..b2d87e108 100644
--- a/src/kernels/cuda/verify_kernels.cu
+++ b/src/kernels/cuda/verify_kernels.cu
@@ -863,7 +863,7 @@ void row_top_prob(const float* logits, int n_rows, int n_vocab, const int32_t* i
     check("row_top_prob");
 }
 
-#if !defined(__HIPCC__)   // warp-32 kernels: an AMD card keeps the one-block row_top_prob and sampler_greedy_kernel
+#if !defined(STRATA_HIP_GFX906)   // warp-32 kernels: gfx906 (wave64) keeps the one-block row_top_prob and sampler_greedy_kernel
 namespace {
 
 constexpr int kArgMaxBlocks = 128, kArgThreads = 256, kTopBlocks = 8;
