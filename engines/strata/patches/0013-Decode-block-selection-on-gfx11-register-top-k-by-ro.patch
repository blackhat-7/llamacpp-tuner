+    ck(cudaMalloc(&d_scores, (size_t) (nq * max_blocks) * 4), "malloc");
+    ck(cudaMalloc(&ids_ref, (size_t) (nq * cap) * 4), "malloc");
+    ck(cudaMalloc(&ids_new, (size_t) (nq * cap) * 4), "malloc");
+    cudaStream_t cs;
+    ck(cudaStreamCreate(&cs), "stream");
+    cudaGraph_t graph;
+    cudaGraphExec_t exec;
+    ck(cudaStreamBeginCapture(cs, cudaStreamCaptureModeThreadLocal), "capture");
+    k::qsa_block_topk(d_scores, d_steps, nq, max_blocks, cap, s, ids_new, cs, -1);
+    ck(cudaStreamEndCapture(cs, &graph), "capture end");
+    ck(cudaGraphInstantiate(&exec, graph, nullptr, nullptr, 0), "instantiate");
+    std::mt19937 rng((uint32_t) (nq * 7 + capacity));
+    std::normal_distribution<float> nd(0.f, 1.f);
+    std::vector<int32_t> steps((size_t) (nq * k::kStepCount)), a((size_t) (nq * cap)), b(a.size());
+    std::vector<float> scores((size_t) (nq * max_blocks));
