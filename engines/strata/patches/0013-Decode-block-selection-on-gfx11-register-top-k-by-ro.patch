+#if defined(__HIPCC__)
+// ---- the decode top-k on gfx11 (wave32).  A decode window's call has no block count, so past 33,792 blocks of
+// capacity (--max-context 262144: 65,538) it took block_topk_kernel, ~0.2 ms a call at 200K cells on a 7900 XTX:
+// one CU making four passes of strided reads, 32-way same-bin LDS atomics (the scores share their top byte) and a
+// serial 256-bin digit search, 12 times a window.  Here 1,024 threads hold the keys in registers, laid out in rows:
+// warp w has the 32 * pa consecutive blocks from w * 32 * pa, lane l of row r block w * 32 * pa + 32 r + l (each row
+// one coalesced 128-byte read).  A row adds its matching keys' first two digits once each and the rest lane by lane;
+// the digit search is one warp's scan; the emit places cells with ballots and popcounts.  block_topk_kernel's
+// selection rule (radix threshold, ties to the lowest index, cells ascending): identical ids.
+constexpr int RW_T = 1024, RW_WARPS = RW_T / 32, RW_P = 66;   // RW_P = TK_PER_MAX: 270,336 cells
+typedef uint32_t rw_v32 __attribute__((ext_vector_type(32)));
+typedef uint32_t rw_v2 __attribute__((ext_vector_type(2)));
+
+__device__ __forceinline__ unsigned rw_ballot(bool p) { return __builtin_amdgcn_ballot_w32(p); }
+
+__global__ void __launch_bounds__(RW_T) block_topk_rows_kernel(const float* __restrict__ scores,
+                                                               const int32_t* __restrict__ steps, int64_t max_blocks,
+                                                               int64_t cap, int32_t* __restrict__ ids) {
+#if STRATA_SEL_GFX11   // wave32 code: the host launches it on the gfx11 parts this build has code for
+    __shared__ int hist[RW_WARPS][256];
+    __shared__ int s_sel[RW_WARPS], s_eqb[RW_WARPS];
+    __shared__ int s_digit, s_above;
+    const int64_t qi = blockIdx.x;
+    const int32_t* st = steps + qi * kStepCount;
+    const int n_kv = st[kStepNKv], n_bid = st[kStepNBid], width = st[kStepWidth];
+    int32_t* out = ids + qi * cap;
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    if (n_kv <= width) {
+        for (int j = t; j < n_kv; j += RW_T) out[j] = j;
+        return;
+    }
+    const float* sc = scores + qi * max_blocks;
+    const int wt = n_kv - n_bid * R;                   // the tail block's cells, 0..3
+    const int n_live = n_bid + (wt > 0 ? 1 : 0);       // the blocks holding cells
+    const int pa = n_bid / RW_T + 1;                   // rows per warp, ceil((n_bid + 1) / RW_T) <= RW_P (the host checks)
+    const int w0 = __builtin_amdgcn_readfirstlane(warp * 32 * pa);
+    const unsigned below = (1u << lane) - 1u;
+    // the cells of the blocks rb + l for the lanes l in m: R each, the tail block wt
+    auto cells = [&](unsigned m, int rb) -> int {
+        const int tl = n_bid - rb;
+        return R * __popc(m) - (((unsigned) tl < 32u && ((m >> tl) & 1u)) ? R - wt : 0);
+    };
+    // the keys of rows 0..65 in registers, all loads issued at once (clamped addresses: no branch between them).  The
+    // row loops below are rolled and read row r with a uniform index (v_movrels): unrolled, the kernel's straight code
+    // misses the instruction cache on every row (ctx 3,000: 19 us for one row).
+    rw_v32 ka, kb;
+    rw_v2 kc;
+    auto ld = [&](int r) -> uint32_t {   // a mask, not a select: a select on a load becomes a branch and a wait per row
+        const int b = w0 + r * 32 + lane;
+        return order_key(sc[b < n_live ? b : n_live - 1]) & (r < pa && b < n_live ? 0xffffffffu : 0u);
+    };
+#pragma unroll
+    for (int i = 0; i < 32; ++i) {
+        ka[i] = ld(i);
+        kb[i] = ld(32 + i);
+    }
+    kc[0] = ld(64);
+    kc[1] = ld(65);
+    // f(key, r) for this warp's rows in order
+    auto rows = [&](auto f) {
+        const int n0 = pa < 32 ? pa : 32, n1 = pa < 64 ? pa : 64;
+        for (int r = 0; r < n0; ++r) f(ka[r], r);
+        for (int r = 32; r < n1; ++r) f(kb[r - 32], r);
+        for (int r = 64; r < pa; ++r) f(kc[r - 64], r);
+    };
+    uint32_t prefix = 0;
+    int above = 0;                                     // cells strictly above the digits fixed so far
+    for (int shift = 24; shift >= 0; shift -= 8) {
+        for (int i = lane; i < 256; i += 32) hist[warp][i] = 0;
+        __syncwarp();
+        const uint32_t hi_mask = shift == 24 ? 0u : (0xffffffffu << (shift + 8));
+        rows([&](uint32_t key, int r) {
+            const int rb = w0 + r * 32, b = rb + lane;
+            const bool m = b < n_live && (key & hi_mask) == prefix;
+            unsigned rem = rw_ballot(m);
+            const int d = (int) ((key >> shift) & 255u);
+            for (int j = 0; j < 2 && rem != 0u; ++j) {   // the leading lanes' digits: one add each
+                const int lead = __ffs(rem) - 1;
+                const int d0 = __builtin_amdgcn_readlane(d, lead);
+                const unsigned same = rw_ballot(m && d == d0);
+                if (lane == lead) atomicAdd(&hist[warp][d0], cells(same, rb));
+                rem &= ~same;
+            }
+            if ((rem >> lane) & 1u) atomicAdd(&hist[warp][d], b < n_bid ? R : wt);
+        });
+        __syncthreads();
+        if (t < 256) {                                // fold the warps' histograms into warp 0's
+            int s = 0;
+            for (int w2 = 0; w2 < RW_WARPS; ++w2) s += hist[w2][t];
+            hist[0][t] = s;
+        }
+        __syncthreads();
+        if (warp == 0) {
+            // block_topk_kernel's digit: the largest d whose cells at or above it reach `need` (0 when none).  Lane l
+            // owns digits 255 - 8l down to 248 - 8l; the lane whose run crosses `need` walks its eight.
+            const int need = width - above;
+            int tot[8], part = 0;
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                tot[j] = hist[0][255 - 8 * lane - j];
+                part += tot[j];
+            }
+            int incl = part;
+#pragma unroll
+            for (int o = 1; o < 32; o <<= 1) {
+                const int y = __shfl_up_sync(0xffffffffu, incl, o);
+                if (lane >= o) incl += y;
+            }
+            const int excl = incl - part;
+            const unsigned hit = rw_ballot(excl < need && incl >= need);
+            if (lane == (hit ? __ffs(hit) - 1 : 31)) {
+                int acc = excl, j = 0;
+                for (; j < 7; ++j) {
+                    if (acc + tot[j] >= need) break;
+                    acc += tot[j];
+                }
+                s_digit = 255 - 8 * lane - j;
+                s_above = above + acc;
+            }
+        }
+        __syncthreads();
+        prefix |= (uint32_t) s_digit << shift;
+        above = s_above;
+    }
+    const uint32_t thr = prefix;
+    const int eq_budget = width - above;               // cells at thr that fit, lowest index first
+    int gt = 0, eq = 0;                                // this warp's cells above / at thr (the same in every lane)
+    rows([&](uint32_t key, int r) {
+        const int rb = w0 + r * 32, b = rb + lane;
+        const bool live = b < n_live;
+        gt += cells(rw_ballot(live && key > thr), rb);
+        eq += cells(rw_ballot(live && key == thr), rb);
+    });
+    if (lane == 0) { s_sel[warp] = gt; s_eqb[warp] = eq; }
+    __syncthreads();
+    if (warp == 0) {                                   // per warp: the cells selected and tied before it
+        const int g2 = s_sel[lane], e2 = s_eqb[lane];
+        int e_in = e2;
+#pragma unroll
+        for (int o = 1; o < 32; o <<= 1) {
+            const int y = __shfl_up_sync(0xffffffffu, e_in, o);
+            if (lane >= o) e_in += y;
+        }
+        const int eb = e_in - e2;
+        const int take = eq_budget - eb < 0 ? 0 : (eq_budget - eb > e2 ? e2 : eq_budget - eb);
+        int s_in = g2 + take;
+#pragma unroll
+        for (int o = 1; o < 32; o <<= 1) {
+            const int y = __shfl_up_sync(0xffffffffu, s_in, o);
+            if (lane >= o) s_in += y;
+        }
+        s_sel[lane] = s_in - g2 - take;
+        s_eqb[lane] = eb;
+    }
+    __syncthreads();
+    int run_sel = s_sel[warp], run_eq = s_eqb[warp];
+    rows([&](uint32_t key, int r) {
+        const int rb = w0 + r * 32, b = rb + lane;
+        const bool live = b < n_live;
+        const unsigned gm = rw_ballot(live && key > thr);
+        const unsigned em = rw_ballot(live && key == thr);
+        if ((gm | em) != 0u) {
+            const int budget = eq_budget - run_eq > 0 ? eq_budget - run_eq : 0;   // tied cells still to take
+            const int eq_bel = cells(em & below, rb);
+            const int pos = run_sel + cells(gm & below, rb) + (budget < eq_bel ? budget : eq_bel);
+            const int w = b < n_bid ? R : wt;
+            int n = 0;
+            if ((gm >> lane) & 1u) n = w;
+            else if ((em >> lane) & 1u) n = budget - eq_bel < 0 ? 0 : (budget - eq_bel > w ? w : budget - eq_bel);
+            for (int c = 0; c < n; ++c) out[pos + c] = b * R + c;
+            const int e_row = cells(em, rb);
+            run_sel += cells(gm, rb) + (budget < e_row ? budget : e_row);
+            run_eq += e_row;
+        }
+    });
+#endif
+}
+#endif
+
 // ---- a query with more blocks than the register kernel holds (contexts past 4 * 1024 * TK_PER cells): the register
 // kernel's threads, per-warp histograms and warp scans, with each key read from memory again on every pass.  A
 // histogram has no order, so on the four radix passes thread t reads blocks t, t + 1024, ...: a warp reads 32
@@ -1137,6 +1316,93 @@ __global__ void __launch_bounds__(SCORE_WARPS * 32) block_scores_rows_kernel(con
     }
 }
 
+#if defined(__HIPCC__)
+// v + (v of lane ^ O within the 16-lane row), O in 1..8: DPP row_xmask, bound_ctrl so the move folds into the add.  The
+// same addition, operand for operand, as `v += __shfl_xor_sync(m, v, O)`.
+template <int O> __device__ __forceinline__ float row_xor_add(float v) {
+    return v + __int_as_float(__builtin_amdgcn_mov_dpp(__float_as_int(v), 0x160 + O, 0xf, 0xf, true));
+}
+
+// block_scores_multi_kernel for NQ <= 4 queries on gfx11 (a decode window's call), the same bits.  A block's 128-term
+// dot is block_scores_kernel's: 32 four-term products (lane l: dims 4l..4l+3) summed by an xor butterfly over offsets
+// 16, 8, 4, 2, 1.  Here a 16-lane row takes a block, lane j the products j and j + 16: the offset-16 sum is its own
+// add, the four others DPP row_xmask adds - every addition the butterfly's - so a wave scores two blocks at once with
+// no LDS traffic, and the queries stay in registers.  The multi kernel at four queries is ALU-bound (~110 us a layer
+// at 200K cells, a quarter of DRAM speed).  The tail block n_bid (the dead key) is scored once per query apart.
+template <int NQ>
+__global__ void __launch_bounds__(SCORE_WARPS * 32) block_scores_dpp_kernel(const float* __restrict__ pooled,
+                                                                            const float* __restrict__ dead,
+                                                                            const float* __restrict__ q_idx,
+                                                                            const int32_t* __restrict__ steps,
+                                                                            int64_t max_blocks, float* __restrict__ out) {
+#if STRATA_SEL_GFX11   // wave32 code: the host launches it on the gfx11 parts this build has code for
+    __shared__ int s_nkv[NQ], s_nbid[NQ];
+    if (threadIdx.x < NQ) {
+        s_nkv[threadIdx.x] = steps[threadIdx.x * kStepCount + kStepNKv];
+        s_nbid[threadIdx.x] = steps[threadIdx.x * kStepCount + kStepNBid];
+    }
+    __syncthreads();
+    int nbid[NQ], top = 0;
+#pragma unroll
+    for (int q = 0; q < NQ; ++q) {
+        nbid[q] = s_nbid[q];
+        top = nbid[q] > top ? nbid[q] : top;
+    }
+    const int last = top < max_blocks - 1 ? top : (int) max_blocks - 1;
+    if (2 * (int) blockIdx.x * SCORE_WARPS > last) return;   // CTA-uniform: its first block pair is past every query
+    const int lane = threadIdx.x & 31, j = lane & 15, half = lane >> 4;
+    float4 qr[NQ][IDX_HEADS][2];
+#pragma unroll
+    for (int q = 0; q < NQ; ++q)
+#pragma unroll
+        for (int h = 0; h < IDX_HEADS; ++h)
+#pragma unroll
+            for (int c = 0; c < 2; ++c)
+                qr[q][h][c] = *reinterpret_cast<const float4*>(q_idx + (q * IDX_HEADS + h) * IDX_DIM + (c * 16 + j) * 4);
+    // the score of one query against the key chunks k0 (dims 4j..) and k1 (dims 64 + 4j..), in every lane of the row
+    auto score = [&](const float4 (&qq)[IDX_HEADS][2], float4 k0, float4 k1) {
+        float s = 0.0f;
+#pragma unroll
+        for (int h = 0; h < IDX_HEADS; ++h) {
+            const float4 a = qq[h][0], b = qq[h][1];
+            const float d0 = k0.x * a.x + k0.y * a.y + k0.z * a.z + k0.w * a.w;
+            const float d1 = k1.x * b.x + k1.y * b.y + k1.z * b.z + k1.w * b.w;
+            float d = d0 + d1;
+            d = row_xor_add<8>(d);
+            d = row_xor_add<4>(d);
+            d = row_xor_add<2>(d);
+            d = row_xor_add<1>(d);
+            s += d > 0.0f ? d : 0.0f;
+        }
+        return s;
+    };
+    const int gw = (int) blockIdx.x * SCORE_WARPS + (int) (threadIdx.x >> 5);
+    if (gw == 0) {   // the tail blocks: the dead key
+        const float4 k0 = *reinterpret_cast<const float4*>(dead + j * 4), k1 = *reinterpret_cast<const float4*>(dead + 64 + j * 4);
+#pragma unroll
+        for (int q = 0; q < NQ; ++q) {
+            float s = score(qr[q], k0, k1);
+            if (lane == 0 && nbid[q] < max_blocks) {
+                if (s_nkv[q] % R != 0) s += 1e9f;
+                out[q * max_blocks + nbid[q]] = s;
+            }
+        }
+    }
+    const int stride = (int) gridDim.x * SCORE_WARPS;
+    for (int p = gw; 2 * p <= last; p += stride) {
+        const int b = 2 * p + half;                    // this row's block; past `last` it reads `last` and stores nothing
+        const float* kp = pooled + (int64_t) (b <= last ? b : last) * IDX_DIM;
+        const float4 k0 = *reinterpret_cast<const float4*>(kp + j * 4), k1 = *reinterpret_cast<const float4*>(kp + 64 + j * 4);
+#pragma unroll
+        for (int q = 0; q < NQ; ++q) {
+            const float s = score(qr[q], k0, k1);
+            if (j == 0 && b < nbid[q]) out[q * max_blocks + b] = s;
+        }
+    }
+#endif
+}
+#endif
