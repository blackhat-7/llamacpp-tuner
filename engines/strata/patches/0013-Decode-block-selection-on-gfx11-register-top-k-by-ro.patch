+#if defined(__HIPCC__)
+// The gfx11 decode selection kernels are wave32 code, built for the gfx11 WMMA list (gfx_arch.hpp).  Per device (a
+// layer split runs several): 0 no such code, 1 gfx1100, 2 another gfx11 part of the list.
+static int sel_gfx11_kind() {
+    static int kind[64] = {};   // kind + 1 once known
+    int dev = 0;
+    if (cudaGetDevice(&dev) != cudaSuccess || dev < 0 || dev >= 64) { cudaGetLastError(); return 0; }
+    if (kind[dev] == 0) {
+        cudaDeviceProp prop;
+        int k = 0;
+        if (cudaGetDeviceProperties(&prop, dev) == cudaSuccess && gfx_arch_is_gfx11_wmma(prop.gcnArchName))
+            k = gfx_arch_is(prop.gcnArchName, "gfx1100") ? 1 : 2;
+        cudaGetLastError();
+        kind[dev] = k + 1;
+    }
+    return kind[dev] - 1;
+}
+// A switch's value: -1 unset, 0 off, 1 on.  Unset: on for gfx1100 (a 7900 XTX: the same ids, faster at every context;
+// 205K cells, four queries: 303 -> 75 us a layer), off for the other gfx11 parts (unmeasured; =1 turns them on).
+static int sel_env(const char* name) {
+    const char* v = std::getenv(name);
+    return v == nullptr || *v == '\0' ? -1 : (v[0] != '0' ? 1 : 0);
+}
+static bool sel_on(int env) {
+    const int k = sel_gfx11_kind();
+    return k != 0 && (env == 1 || (env == -1 && k == 1));
+}
+static bool scores_dpp_device() {   // STRATA_SCORES_DPP: block_scores_dpp_kernel
+    static const int env = sel_env("STRATA_SCORES_DPP");
+    return sel_on(env);
+}
+static bool topk_rows_device() {    // STRATA_TOPK_ROWS: block_topk_rows_kernel
+    static const int env = sel_env("STRATA_TOPK_ROWS");
+    return sel_on(env);
+}
+#endif
