From: blackhat-7 <44942105+blackhat-7@users.noreply.github.com>
Date: Sun, 1 Nov 2026 05:35:33 +0530
Subject: [PATCH 11/33] PLE table: MADV_WILLNEED prefetch of a window's rows on
 Linux (--ple-io mmap)

Port of opt7/integrate 6ecfbdb4 onto v0.2.9: prefetch_rows (the draft layer's and the verify window's rows, issued
before the reads), issue and gather ask for each row's page with madvise(MADV_WILLNEED) when the table is mapped -
the Linux analog of the PrefetchVirtualMemory calls v0.2.9 makes on Windows only, so rows the page cache dropped come
back in parallel instead of one SSD read at a time on the token path. A hint: it cannot change a value.
v0.2.9's own prompt-side gather (a WILLNEED hint per 4,096-row window, the PleReader for direct I/O) replaces our
pread prompt gather (a3e6bc13, 1539c87a), which is not ported.
Measured on 0.1.43 (r4b): the user's side model holding RAM, server, --ple-io mmap: code 107.7 -> 131.1 t/s, prose
60.0 -> 95.9, edit 111.4 -> 117.6.
---
 src/kernels/ngram.cpp | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/src/kernels/ngram.cpp b/src/kernels/ngram.cpp
index c91e34c06..310fcf49e 100644
--- a/src/kernels/ngram.cpp
+++ b/src/kernels/ngram.cpp
@@ -37,6 +37,20 @@ namespace strata::kernels {
 namespace {
 /// The A/B arm.  Host-token-path only, so it needs no atomics; see the note on `ple_prefetch_enable`.
 bool g_ple_prefetch = true;
+
+#if !defined(_WIN32)
+/// Linux's `PrefetchVirtualMemory` (the note in `PleTable::gather`): ask for every row's page before the reads, so
+/// rows the page cache dropped come back in parallel instead of one SSD read at a time.  A hint, like the Windows call.
+void willneed_rows(const uint8_t* data, uint64_t n_rows, uint32_t rb, const uint32_t* rows, size_t n) {
+    constexpr uintptr_t kPage = 4096;
+    for (size_t i = 0; i < n; ++i) {
+        if (rows[i] >= n_rows) continue;
+        const uintptr_t a = (uintptr_t) (data + (size_t) rows[i] * rb);
+        const uintptr_t p0 = a & ~(kPage - 1), p1 = (a + rb - 1) & ~(kPage - 1);
+        (void) madvise((void*) p0, p1 - p0 + kPage, MADV_WILLNEED);
+    }
+}
+#endif
 }  // namespace
 
 void ple_prefetch_enable(bool on) { g_ple_prefetch = on; }
@@ -498,6 +512,8 @@ void PleTable::prefetch_rows(const uint32_t* rows16) {
         }
         if (n > 0) (void) PrefetchVirtualMemory(GetCurrentProcess(), n, ranges, 0);
     }
+#else
+    if (impl_->data != nullptr && g_ple_prefetch) willneed_rows(impl_->data, impl_->n_rows, impl_->rb, rows16, PLE_N_HEADS);
 #endif
 }
 
@@ -577,6 +593,8 @@ bool PleTable::issue(const uint32_t* rows16) {
         }
         if (n > 0) (void) PrefetchVirtualMemory(GetCurrentProcess(), n, ranges, 0);
     }
+#else
+    if (impl_->data != nullptr && g_ple_prefetch) willneed_rows(impl_->data, impl_->n_rows, impl_->rb, impl_->rows, PLE_N_HEADS);
 #endif
     impl_->pending = true;
     return true;
@@ -766,6 +784,8 @@ void PleTable::gather(const uint32_t* rows16, float* out2560) const {
         }
         if (n > 0) (void) PrefetchVirtualMemory(GetCurrentProcess(), n, ranges, 0);
     }
+#else
+    if (impl_->data != nullptr && g_ple_prefetch) willneed_rows(impl_->data, impl_->n_rows, impl_->rb, rows16, PLE_N_HEADS);
 #endif
     // HEAD-SLOWEST, which is what `ggml_get_rows` does and what the source's own comment says: head h's 160
     // values occupy [h*160, (h+1)*160).  A head-fastest layout would put element (d, h) at d*16 + h and needs
