     // STRATA_X_NV_DELAY_US (measurement only): this card's layer this much longer, for causal profiling
     static const int nv_delay = [] { const char* e = std::getenv("STRATA_X_NV_DELAY_US"); return e ? std::atoi(e) : 0; }();
     if (nv_delay > 0) strata::kernels::spin_delay(nv_delay, S.s);
