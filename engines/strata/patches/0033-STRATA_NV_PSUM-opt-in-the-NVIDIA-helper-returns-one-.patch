+        float* sums = S.d_out + (size_t) CAP * S.h;
+        psum_rows<<<dim3((unsigned) ((S.h / 4 + 255) / 256), (unsigned) n_tok), 256, 0, S.s>>>(
+            (const float4*) S.d_out, (const Meta*) S.d_meta, (float4*) sums, rows, S.h / 4);
+        back = sums;
