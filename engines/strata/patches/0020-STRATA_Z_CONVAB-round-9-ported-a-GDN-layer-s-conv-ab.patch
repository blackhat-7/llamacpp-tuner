new file mode 100644
index 000000000..8f99493c5
--- /dev/null
+++ b/src/kernels/cuda/gdn_conv_ab.cuh
@@ -0,0 +1,148 @@
+// The GDN conv + L2 norm and the a/b projections (STRATA_GDN_AB_ILP) as block bodies: gdn_conv_ab_ilp_kernel
+// (verify_kernels.cu) runs them, and STRATA_Z_CONVAB runs the same source as front blocks of the z GEMV (native_mmvq.cu,
+// iq_kernels.cu), so both compute the same bits.
+#pragma once
+
+#include "strata/kernels/native_mmvq.hpp"
+#include <cuda_runtime.h>
+#include <cstdint>
+
+namespace strata::kernels {
+namespace {
+constexpr int kConvS = 128;   // channels a conv block (its threads)
+
+// `commit` (one token): the history then keeps it - [hist1, hist2, x_0], each thread its channel's, after reading them
+__device__ __forceinline__ void gdn_conv_l2_body(const int bx, const int by, float* hist, const float* __restrict__ qkv,
+                                                              const float* __restrict__ w, float* __restrict__ h,
+                                                              int C, int qk_heads, float eps, int t_begin, bool commit) {
+    __shared__ float part[kConvS / 32];
+    const int t = t_begin + by;
+    const int c = bx * kConvS + threadIdx.x;
+    // the window of token t: [hist0, hist1, hist2, x_0, ..., x_t], its last four entries
+    float win[3];
+#pragma unroll
+    for (int j = 0; j < 3; ++j) {
+        const int src = t + j;          // index into [hist(3) | x...]
+        win[j] = src < 3 ? hist[c * 3 + src] : qkv[(size_t) (src - 3) * C + c];
+    }
+    const float v0 = win[0], v1 = win[1], v2 = win[2], x = qkv[(size_t) t * C + c];
+    if (commit) {
+        hist[c * 3] = v1;
+        hist[c * 3 + 1] = v2;
+        hist[c * 3 + 2] = x;
+    }
+    float sum = v0 * w[c * 4] + v1 * w[c * 4 + 1] + v2 * w[c * 4 + 2] + x * w[c * 4 + 3];
+    float y = sum / (1.0f + __expf(-sum));
+    if ((int) bx < qk_heads) {
+        float sq = y * y;
+        for (int o = 16; o > 0; o >>= 1) sq += __shfl_xor_sync(0xffffffffu, sq, o);
+        if ((threadIdx.x & 31) == 0) part[threadIdx.x >> 5] = sq;
+        __syncthreads();
+        const float ss = part[0] + part[1] + part[2] + part[3];
+        y *= rsqrtf(ss + eps);
+    }
+    h[(size_t) t * C + c] = y;
+}
+
+// a lane's 8 weights of one uint4 against x[0..8), in gdn_ab_body's FMA order
+__device__ __forceinline__ float gdn_ab_dot8(const uint4 wv, const float4 xa, const float4 xb, float a) {
+    a = fmaf(__uint_as_float(wv.x << 16), xa.x, a); a = fmaf(__uint_as_float(wv.x & 0xffff0000u), xa.y, a);
+    a = fmaf(__uint_as_float(wv.y << 16), xa.z, a); a = fmaf(__uint_as_float(wv.y & 0xffff0000u), xa.w, a);
+    a = fmaf(__uint_as_float(wv.z << 16), xb.x, a); a = fmaf(__uint_as_float(wv.z & 0xffff0000u), xb.y, a);
+    a = fmaf(__uint_as_float(wv.w << 16), xb.z, a); a = fmaf(__uint_as_float(wv.w & 0xffff0000u), xb.w, a);
+    return a;
+}
+
+// the lanes' partial dots of one row -> gate or beta for every token
+template <int MAX_T, bool EXACT_T>
+__device__ __forceinline__ void gdn_ab_finish(const float (&acc)[MAX_T], int lane, bool is_beta, int r,
+                                              const float* __restrict__ dt, const float* __restrict__ ssm_a,
+                                              float* __restrict__ gate, float* __restrict__ beta, int h_v, int T) {
+#pragma unroll
+    for (int t = 0; t < MAX_T; ++t) {
+        if (!EXACT_T && t >= T) break;
+        float a = acc[t];
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) a += __shfl_xor_sync(0xffffffffu, a, o);
+        if (lane != 0) continue;
+        if (is_beta) {
+            beta[(size_t) t * h_v + r] = 1.0f / (1.0f + __expf(-a));
+        } else {
+            const float v = a + dt[r];
+            const float sp = v > 20.0f ? v : log1pf(__expf(v));
+            gate[(size_t) t * h_v + r] = sp * ssm_a[r];
+        }
+    }
+}
+
+// STRATA_GDN_AB_ILP=1 (on by default on gfx1100, strata/core/arch_defaults.hpp): gdn_ab_body with one warp per (row,
+// token) instead of one per row, for n = 256 * IT.  gdn_ab_body's loop runs to a kernel argument, so each of a lane's
+// IT steps waits for its own loads: IT memory latencies in a row (6.7 us for 0.5 MB on a 7900 XTX).  Here a lane
+// loads its IT weight chunks and its token's 2 * IT x chunks at once, then runs that token's fmaf chain: the chain
+// gdn_ab_body's lane runs for that token (the tokens' chains never mix), followed by the same butterfly and epilogue,
+// so gate and beta are bitwise the same.  grid (rows / 2, T), 64 threads.  The conv + a/b of a verify layer, 36 layers
+// of cold weights in a graph, T 2..4: 8.4-9.4 -> 6.6-6.8 us a layer (4.2-5.0 inside STRATA_FUSE_CONVAB's launch).
+template <int IT>
+__device__ __forceinline__ void gdn_ab_body_ilp(const int bx, const int t, const float* __restrict__ x,
+                                                const uint16_t* __restrict__ wa, const uint16_t* __restrict__ wb,
+                                                const float* __restrict__ dt, const float* __restrict__ ssm_a,
+                                                float* __restrict__ gate, float* __restrict__ beta, int h_v) {
+    constexpr int n = 256 * IT;
+    const int row = bx * 2 + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+    if (row >= 2 * h_v) return;
+    const bool is_beta = row >= h_v;
+    const int r = is_beta ? row - h_v : row;
+    const uint4* w4 = reinterpret_cast<const uint4*>((is_beta ? wb : wa) + (size_t) r * n) + lane;
+    const float4* x4 = reinterpret_cast<const float4*>(x + (size_t) t * n) + 2 * lane;
+    uint4 wv[IT];
+    float4 xa[IT], xb[IT];
+#pragma unroll
+    for (int i = 0; i < IT; ++i) {
+        wv[i] = __ldg(w4 + 32 * i);
+        xa[i] = __ldg(x4 + 64 * i);
+        xb[i] = __ldg(x4 + 64 * i + 1);
+    }
+    float acc[1] = {0.0f};
+#pragma unroll
+    for (int i = 0; i < IT; ++i) acc[0] = gdn_ab_dot8(wv[i], xa[i], xb[i], acc[0]);
+    gdn_ab_finish<1, true>(acc, lane, is_beta, r, dt, ssm_a, gate + (size_t) t * h_v, beta + (size_t) t * h_v, h_v, 1);
+}
+constexpr int kAbIlpIt = 10;   // n_embd 2560 (Qwen3.8 Flash-Next); another width keeps gdn_ab_body
+
+
+// one block of gdn_conv_ab_ilp_kernel's grid: the a/b blocks first, then the conv blocks
+__device__ __forceinline__ void gdn_conv_ab_ilp_block(int bx, int by, float* hist, const float* __restrict__ qkv,
+                                                      const float* __restrict__ w, float* __restrict__ h, int C,
+                                                      int qk_heads, float eps, int t_begin, bool commit,
+                                                      const float* __restrict__ x, const uint16_t* __restrict__ wa,
+                                                      const uint16_t* __restrict__ wb, const float* __restrict__ dt,
+                                                      const float* __restrict__ ssm_a, float* __restrict__ gate,
+                                                      float* __restrict__ beta, int h_v) {
+    const int ab_blocks = (2 * h_v + 1) / 2;
+    if (bx >= ab_blocks)
+        gdn_conv_l2_body(bx - ab_blocks, by, hist, qkv, w, h, C, qk_heads, eps, t_begin, commit);
+    else if (threadIdx.x < 64)
+        gdn_ab_body_ilp<kAbIlpIt>(bx, by, x, wa, wb, dt, ssm_a, gate, beta, h_v);
+}
+
+// GEMV front roles: a GEMV kernel's blocks [0, role.blocks) run role.run(blockIdx.x) and return; the rest are the GEMV's
+// own grid. NoRole has no blocks, so its kernels are the plain GEMVs.
+struct NoRole {
+    static constexpr int blocks = 0;
+    __device__ void run(int) const {}
+};
+struct ConvAbRole {   // STRATA_Z_CONVAB: gdn_conv_ab_ilp_kernel's (ab + conv, n_tok) grid, flattened row by row
+    GdnConvAbArgs a;
+    int per;      // a/b + conv blocks a token
+    int blocks;   // per * n_tok
+    __device__ __forceinline__ void run(int b) const {
+        gdn_conv_ab_ilp_block(b % per, b / per, a.hist, a.qkv, a.conv_w, a.h, a.channels, a.qk_heads, a.eps, a.t_begin,
+                              a.commit, a.x, a.wa, a.wb, a.dt, a.ssm_a, a.gate, a.beta, a.h_v);
+    }
+};
+inline ConvAbRole conv_ab_role(const GdnConvAbArgs& a) {
+    const int per = (2 * a.h_v + 1) / 2 + a.channels / kConvS;
+    return ConvAbRole{a, per, per * a.n_tok};
+}
+}  // namespace
+}  // namespace strata::kernels
