+// STRATA_Z_CONVAB: gdn_conv_ab_multi's inputs (the model's shape: 10240 channels, 48 value heads, 2560 inputs) and two
+// output sets, one for the plain call and one for the conv/ab blocks in front of a GEMV
+struct ConvAb {
+    static constexpr int C = 10240, HV = 48, NE = 2560, QKH = 32;
+    float *hist = nullptr, *qkv = nullptr, *cw = nullptr, *x = nullptr, *dt = nullptr, *sa = nullptr;
+    uint16_t *wa = nullptr, *wb = nullptr;
+    float* out[2][3] = {};   // [plain, role][h, gate, beta]
+    bool init(std::mt19937& rng) {
+        std::normal_distribution<float> nd(0.f, 1.f);
+        auto up = [&](float** d, std::size_t n, float scale) {
+            std::vector<float> v(n);
+            for (auto& f : v) f = scale * nd(rng);
+            return ck(cudaMalloc(d, n * 4), "malloc convab") && ck(cudaMemcpy(*d, v.data(), n * 4, cudaMemcpyHostToDevice), "copy convab");
+        };
+        auto up16 = [&](uint16_t** d, std::size_t n) {
+            std::vector<uint16_t> v(n);
+            for (auto& h : v) {
+                const float f = 0.05f * nd(rng);
+                uint32_t u;
+                std::memcpy(&u, &f, 4);
+                h = (uint16_t) (u >> 16);
+            }
+            return ck(cudaMalloc(d, n * 2), "malloc convab16") && ck(cudaMemcpy(*d, v.data(), n * 2, cudaMemcpyHostToDevice), "copy16");
+        };
+        bool ok = up(&hist, (std::size_t) C * 3, 1.f) && up(&qkv, (std::size_t) 6 * C, 1.f) && up(&cw, (std::size_t) C * 4, 0.5f) &&
+                  up(&x, (std::size_t) 6 * NE, 1.f) && up(&dt, HV, 1.f) && up(&sa, HV, 1.f) && up16(&wa, (std::size_t) HV * NE) &&
+                  up16(&wb, (std::size_t) HV * NE);
+        for (auto& o : out)
+            for (int k = 0; k < 3; ++k) ok = ok && ck(cudaMalloc(&o[k], (std::size_t) 6 * (k == 0 ? C : HV) * 4), "malloc out");
+        return ok;
+    }
+    GdnConvAbArgs args(int which, int T) const {
+        return GdnConvAbArgs{hist, qkv, cw, out[which][0], C, QKH, 1e-6f, 0, false, x, wa, wb, dt, sa, out[which][1],
+                             out[which][2], HV, T};
+    }
+    long long diff(int T) const {   // bits that differ between the two output sets
+        long long d = 0;
