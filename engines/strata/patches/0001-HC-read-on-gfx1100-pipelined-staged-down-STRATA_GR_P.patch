+// the staged read of n_tok <= 6 tokens as gr_one_kernel; false = not here (the caller launches the three kernels)
+bool launch_one(const GrMulti& m, cudaStream_t st) {
+    static const bool no_multi_gr = [] {
+        const char* no = std::getenv("STRATA_NO_MULTI_GR");
+        return no != nullptr && no[0] != '\0' && no[0] != '0';
+    }();
+    if (m.T > 6 || no_multi_gr || !gr_one_on() || m.a[0].s_down != nullptr ||
+        (m.a[0].q8_mixed != nullptr && !qfuse_hc_local()))
+        return false;
+    int dev = 0;
+    if (cudaGetDevice(&dev) != cudaSuccess || dev < 0 || dev >= 64) return false;
+    unsigned* cnt = nullptr;
+    {
+        std::lock_guard<std::mutex> lk(g_one_mu);
+        OnePool& p = g_one[dev];
+        if (!p.base || p.off) return false;
+        size_t i = 0;
+        while (i < p.xn.size() && p.xn[i] != m.xn) ++i;
+        if (i == p.xn.size()) {
+            if ((int) i + 1 >= kOneSlots) return false;
+            p.xn.push_back(m.xn);
+        }
+        cnt = p.base + kOneSlotU * (i + 1);
+    }
+    unsigned* err = one_err(dev);
+    const unsigned blocks = (unsigned) (m.T * HC + DOWN_BLOCKS + 1 + ONE_UP_BLOCKS);
+    switch (m.T) {
+        case 1: gr_one_kernel<1><<<blocks, THREADS, one_smem(1), st>>>(m, cnt, err); break;
+        case 2: gr_one_kernel<2><<<blocks, THREADS, one_smem(2), st>>>(m, cnt, err); break;
+        case 3: gr_one_kernel<3><<<blocks, THREADS, one_smem(3), st>>>(m, cnt, err); break;
+        case 4: gr_one_kernel<4><<<blocks, THREADS, one_smem(4), st>>>(m, cnt, err); break;
+        case 5: gr_one_kernel<5><<<blocks, THREADS, one_smem(5), st>>>(m, cnt, err); break;
+        default: gr_one_kernel<6><<<blocks, THREADS, one_smem(6), st>>>(m, cnt, err); break;
+    }
+    return true;
+}
+
+void launch_down_pipe(const GrMulti& c, int ct, cudaStream_t st) {
+    const size_t smem = down_pipe_smem(ct);
+    switch (ct) {
+        case 1: gr_down_pipe_kernel<1><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+        case 2: gr_down_pipe_kernel<2><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+        case 3: gr_down_pipe_kernel<3><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+        case 4: gr_down_pipe_kernel<4><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+        case 5: gr_down_pipe_kernel<5><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+        default: gr_down_pipe_kernel<6><<<DOWN_BLOCKS + 1, THREADS, smem, st>>>(c); break;
+    }
+}
