+// gr_one_kernel's counters: per device, a slot per activations scratch (two reads in flight at once never share one),
+// slot 0 the timeouts.  Allocated by fused_gr_check before any graph is captured; no slot = the three kernels.
+constexpr int kOneSlots = 64, kOneSlotU = 16;   // 64 B a slot
+struct OnePool {
+    unsigned* base = nullptr;
+    std::vector<const float*> xn;
+    bool off = false;   // the check rejected it on this card
+};
+OnePool g_one[64];
+std::mutex g_one_mu;
