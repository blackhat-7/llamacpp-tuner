+template <int T>
+__global__ void __launch_bounds__(THREADS) gr_one_kernel(GrMulti m, unsigned* cnt, unsigned* err) {
+    extern __shared__ __align__(16) float4 one_smem4[];
+    constexpr int NN = T * HC, ND = DOWN_BLOCKS + 1;
+    const int b = blockIdx.x;
+    if (b < NN) one_norm<T>(m, b, cnt, err, reinterpret_cast<float*>(one_smem4));
+    else if (b < NN + ND) one_down<T>(m, b - NN, cnt, err, one_smem4);
+    else one_up<T>(m, b - NN - ND, cnt, err, reinterpret_cast<float*>(one_smem4));
+}
+constexpr size_t one_smem(int T) {
+    const size_t up = (size_t) (T * LR + T * HC + T * HC * ONE_COLS + T * ONE_COLS) * sizeof(float);
+    return down_pipe_smem(T) > up ? down_pipe_smem(T) : up;
+}
