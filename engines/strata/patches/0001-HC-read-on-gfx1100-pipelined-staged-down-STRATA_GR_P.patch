+#if defined(__HIPCC__) && !defined(STRATA_HIP_GFX906)
+// ======================== gfx1100: the staged down projection, pipelined (STRATA_GR_PIPE) ========================
+// The staged down kernel's rows, tiles, lanes and sums in the same order (the same bits), with the memory latency
+// hidden.  On gfx11 __syncthreads() waits for every outstanding global load before its barrier (the workgroup release
+// fence is s_waitcnt vmcnt(0) in WGP mode), so the staged kernel's weight prefetch landed at the next barrier: each of
+// its 8 tiles exposed a DRAM round trip, and its staging copy waited for one load at a time.  Here the barriers fence
+// shared memory only, a tile's activations are loaded into registers a tile ahead and its weights two tiles ahead.
+// The final sums use DPP instead of ds_bpermute (the same xor pairs, so the same bits).
+__device__ __forceinline__ void lds_sync() {
+    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
+    __builtin_amdgcn_s_barrier();
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
+}
+
+// warp_sum's butterfly: xor 16 (permlanex16), then 8, 4, 2, 1 (DPP row_xmask)
+__device__ __forceinline__ float warp_sum_dpp(float v) {
+    v += __int_as_float((int) __builtin_amdgcn_permlanex16((unsigned) __float_as_int(v), (unsigned) __float_as_int(v),
+                                                           0x76543210u, 0xfedcba98u, false, false));
+    v += __int_as_float(__builtin_amdgcn_update_dpp(0, __float_as_int(v), 0x168, 0xf, 0xf, false));
+    v += __int_as_float(__builtin_amdgcn_update_dpp(0, __float_as_int(v), 0x164, 0xf, 0xf, false));
+    v += __int_as_float(__builtin_amdgcn_update_dpp(0, __float_as_int(v), 0x162, 0xf, 0xf, false));
+    v += __int_as_float(__builtin_amdgcn_update_dpp(0, __float_as_int(v), 0x161, 0xf, 0xf, false));
+    return v;
+}
+
+// gr_down_staged_kernel<T, true> pipelined.  A wait for a load is a wait for every load issued before it, so the loads
+// go out in the order they are needed: tile h + 1's activations, then tile h + 2's weights.
+template <int T>
+__global__ void __launch_bounds__(THREADS) gr_down_pipe_kernel(GrMulti m) {
+    extern __shared__ __align__(16) float4 hbuf[];      // 2 buffers x (the staged kernel's [T][2 planes][160] + pad)
+    constexpr int TF4 = T * (H_TILE / 4);                // float4 of a tile, every token
+    constexpr int SPT = (TF4 + THREADS - 1) / THREADS;   // of them a thread stages
+    constexpr int BUF = SPT * THREADS;                   // a buffer: the tile, then the pad the spare slots fill
+    constexpr int PD = 2;                                // tiles of weights in flight
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    const bool inject_block = (int) blockIdx.x >= DOWN_BLOCKS;
+    const int row = inject_block ? warp : (int) blockIdx.x * WARPS + warp;
+    const bool active = !(inject_block && (m.a[0].w_inject == nullptr || row >= HC));
+    // an idle warp (the inject block's spare rows) still loads row 0 of w_down, unused: a load under a branch makes
+    // every later wait count it as possibly missing, so the waits drain the prefetch
+    const uint4* w4 = reinterpret_cast<const uint4*>(active ? (inject_block ? m.a[0].w_inject : m.a[0].w_down) +
+                                                                  (size_t) row * D
+                                                            : m.a[0].w_down) + lane;
+    // slot s: float4 i = t + s THREADS of the tile, token k's float4 s4; a slot past the tile copies its last float4
+    // into the pad (no branch, so the slots stay in registers)
+    int src[SPT], dst[SPT];
+#pragma unroll
+    for (int s = 0; s < SPT; ++s) {
+        const int i = t + s * THREADS, ic = i < TF4 ? i : TF4 - 1, k = ic / (H_TILE / 4), s4 = ic - k * (H_TILE / 4);
+        src[s] = k * (D / 4) + s4;
+        dst[s] = i < TF4 ? k * (H_TILE / 4) + (s4 & 1) * (H_TILE / 8) + (s4 >> 1) : i;
+    }
+    using f4v = float __attribute__((ext_vector_type(4)));   // not float4: a struct copy goes through the stack
+    f4v* hb = reinterpret_cast<f4v*>(hbuf);
+    const f4v* xs = reinterpret_cast<const f4v*>(m.xn);
+    f4v sreg[SPT];
+    uint4 wv[PD + 1][HQ];
+    float acc[T];
+#pragma unroll
+    for (int k = 0; k < T; ++k) acc[k] = 0.0f;
+#pragma unroll
+    for (int s = 0; s < SPT; ++s) sreg[s] = xs[src[s]];
+#pragma unroll
+    for (int h = 0; h < PD; ++h)
+#pragma unroll
+        for (int q = 0; q < HQ; ++q) wv[h][q] = __ldg(w4 + h * (H_TILE / 8) + 32 * q);
+#pragma unroll
+    for (int s = 0; s < SPT; ++s) hb[dst[s]] = sreg[s];
+#pragma unroll
+    for (int s = 0; s < SPT; ++s) sreg[s] = xs[H_TILE / 4 + src[s]];
+    lds_sync();
+#pragma unroll
+    for (int h = 0; h < N_HTILES; ++h) {
+        if (h + 1 < N_HTILES) {                          // tile h + 1 into the buffer every warp left at the barrier
+#pragma unroll
+            for (int s = 0; s < SPT; ++s) hb[((h + 1) & 1) * BUF + dst[s]] = sreg[s];
+        }
+        if (h + 2 < N_HTILES) {
+#pragma unroll
+            for (int s = 0; s < SPT; ++s) sreg[s] = xs[(h + 2) * (H_TILE / 4) + src[s]];
+        }
+        if (h + PD < N_HTILES) {
+#pragma unroll
+            for (int q = 0; q < HQ; ++q)
+                wv[(h + PD) % (PD + 1)][q] = __ldg(w4 + (h + PD) * (H_TILE / 8) + 32 * q);
+        }
+        if (active) {
+            const float4* cur = hbuf + (h & 1) * BUF;
+#pragma unroll
+            for (int q = 0; q < HQ; ++q) {
+                const int j = lane + 32 * q;
+                const Bf16x8 wq = unpack8(wv[h % (PD + 1)][q]);
+#pragma unroll
+                for (int k = 0; k < T; ++k) {
+                    const float4* pk = cur + k * (H_TILE / 4);
+                    acc[k] += dot8u(wq, pk[j], pk[H_TILE / 8 + j]);
+                }
+            }
+        }
+        lds_sync();
+    }
+    if (!active) return;
+#pragma unroll
+    for (int k = 0; k < T; ++k) {
+        const float s = warp_sum_dpp(acc[k]);
+        if (lane != k) continue;
+        if (inject_block) {
+            m.a[k].inject_out[row] = s;
+        } else {
+            const float x = s / (float) HC;
+            m.a[k].lo[row] = x / (1.0f + __expf(-x));
+        }
+    }
+}
+
+// gr_down_pipe_kernel<T>'s two padded buffers
+constexpr size_t down_pipe_smem(int T) { return (size_t) 2 * ((T * (H_TILE / 4) + THREADS - 1) / THREADS) * THREADS * sizeof(float4); }
+
+// ======================== gfx1100: the staged read in one kernel (STRATA_GR_ONE) ========================
+// gr_norm_split_fast_kernel, gr_down_pipe_kernel<T> and gr_up_q32_kernel<T> as roles of one launch, by block: [0, T*HC)
+// the norm of one (token, stream) each, the next DOWN_BLOCKS + 1 the down projection, the last ONE_UP_BLOCKS the up
+// projection of 32 columns x 4 streams.  Each value is computed with those kernels' operations in their order (the
+// same bits; fused_gr_check compares it with the plain read).  The down blocks load their first weight tiles and the
+// up blocks all of theirs (6.5 MB, in registers) before they wait for the role before them, so the weights stream
+// while the norm and the down projection run, and two of the read's three launches are gone.  A role waits on a
+// counter of the role before it; roles are in block order, so a block only waits for blocks dispatched before it.
+// cnt: [0] norm blocks done, [1] down blocks done, [2] up blocks past their wait; zero between launches (norm block 0
+// resets them once the last up block passed its wait).  A wait gives up after ~1M polls and counts in *err.
+constexpr int ONE_COLS = 32, ONE_UP_BLOCKS = N / ONE_COLS;   // 80
+
+__device__ __forceinline__ void one_wait(const unsigned* p, unsigned v, unsigned* err) {
+    if (threadIdx.x == 0) {
+        unsigned it = 0;
+        while (__hip_atomic_load(p, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT) < v) {
+            __builtin_amdgcn_s_sleep(1);
+            if (++it == (1u << 20)) { atomicAdd(err, 1u); break; }
+        }
+    }
+    lds_sync();
+    asm volatile("buffer_gl0_inv\n\tbuffer_gl1_inv" ::: "memory");   // the producers' data, not this CU's stale copy
+}
+__device__ __forceinline__ void one_signal(unsigned* p) {
+    __threadfence();
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        __threadfence();
+        atomicAdd(p, 1u);
+    }
+}
+// warp_sum's stages 4, 2, 1 inside each 8 lanes
+__device__ __forceinline__ float xor8_dpp(float v) {
+    v += __int_as_float(__builtin_amdgcn_update_dpp(0, __float_as_int(v), 0x164, 0xf, 0xf, false));
+    v += __int_as_float(__builtin_amdgcn_update_dpp(0, __float_as_int(v), 0x162, 0xf, 0xf, false));
+    v += __int_as_float(__builtin_amdgcn_update_dpp(0, __float_as_int(v), 0x161, 0xf, 0xf, false));
+    return v;
+}
+
+// gr_norm_split_fast_kernel for (token, stream) b
+template <int T>
+__device__ __forceinline__ void one_norm(const GrMulti& m, int b, unsigned* cnt, unsigned* err, float* sm) {
+    float* part = sm;
+    float* s_rs = sm + WARPS;
+    const int kt = b / HC, c = b - kt * HC;
+    const FusedGrArgs& a = m.a[kt];
+    float* xn = m.xn + (size_t) kt * D;
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    const float gw = a.apply ? 2.0f * sigmoidf_(a.inj_prev[c] / (float) HC) : 0.0f;
+    constexpr int KS = 3;
+    int k0 = (c * N - 4 * t + THREADS * 4 - 1) / (THREADS * 4);
+    if (k0 < 0) k0 = 0;
+    float4 r[KS], g[KS];
+    bool ok[KS];
+#pragma unroll
+    for (int j = 0; j < KS; ++j) {
+        const int i = t * 4 + (k0 + j) * THREADS * 4;
+        ok[j] = i < (c + 1) * N;
+        if (ok[j]) {
+            r[j] = *reinterpret_cast<const float4*>(a.R + i);
+            g[j] = *reinterpret_cast<const float4*>(a.w_norm + i);
+            if (a.apply) {
+                const float4 bb = *reinterpret_cast<const float4*>(a.bo_prev + (i - c * N));
+                r[j].x = fmaf(bb.x, gw, r[j].x); r[j].y = fmaf(bb.y, gw, r[j].y);
+                r[j].z = fmaf(bb.z, gw, r[j].z); r[j].w = fmaf(bb.w, gw, r[j].w);
+            }
+        }
+    }
+    float ss = 0.0f;
+#pragma unroll
+    for (int j = 0; j < KS; ++j) {
+        if (ok[j]) {
+            // the contraction the other norm kernels compile to, spelled out: inlined here the compiler picks another
+            const float sq = fmaf(r[j].w, r[j].w, fmaf(r[j].z, r[j].z, fmaf(r[j].x, r[j].x, r[j].y * r[j].y)));
+            ss += sq;
+            r[j] = make_float4(r[j].x * g[j].x, r[j].y * g[j].y, r[j].z * g[j].z, r[j].w * g[j].w);
+        }
+    }
+    const float v = warp_sum(ss);
+    if (lane == 0) part[warp] = v;
+    __syncthreads();
+    if (t == 0) {
+        float s = 0.0f;
+        for (int w = 0; w < WARPS; ++w) s += part[w];
+        s_rs[0] = rsqrtf(s / (float) N + a.eps);
+        a.rs[c] = s_rs[0];
+    }
+    __syncthreads();
+    const float rs = s_rs[0];
+#pragma unroll
+    for (int j = 0; j < KS; ++j)
+        if (ok[j])
+            *reinterpret_cast<float4*>(xn + t * 4 + (k0 + j) * THREADS * 4) =
+                make_float4(r[j].x * rs, r[j].y * rs, r[j].z * rs, r[j].w * rs);
+    one_signal(cnt);
+    if (b == 0 && t == 0) {   // idle from here: reset the counters once no block reads them any more
+        unsigned it = 0;
+        while (__hip_atomic_load(cnt + 2, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT) < (unsigned) ONE_UP_BLOCKS) {
+            __builtin_amdgcn_s_sleep(2);
+            if (++it == (1u << 20)) { atomicAdd(err, 1u); break; }
+        }
+        atomicExch(cnt + 0, 0u);
+        atomicExch(cnt + 1, 0u);
+        atomicExch(cnt + 2, 0u);
+    }
+}
+
+// gr_down_pipe_kernel<T> for down block bd, its first PD weight tiles loaded before the wait for the norm
+template <int T>
+__device__ __forceinline__ void one_down(const GrMulti& m, int bd, unsigned* cnt, unsigned* err, float4* hbuf) {
+    constexpr int TF4 = T * (H_TILE / 4);
+    constexpr int SPT = (TF4 + THREADS - 1) / THREADS;
+    constexpr int BUF = SPT * THREADS;
+    constexpr int PD = 2;
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    const bool inject_block = bd >= DOWN_BLOCKS;
+    const int row = inject_block ? warp : bd * WARPS + warp;
+    const bool active = !(inject_block && (m.a[0].w_inject == nullptr || row >= HC));
+    const uint4* w4 = reinterpret_cast<const uint4*>(active ? (inject_block ? m.a[0].w_inject : m.a[0].w_down) +
+                                                                  (size_t) row * D
+                                                            : m.a[0].w_down) + lane;
+    int src[SPT], dst[SPT];
+#pragma unroll
+    for (int s = 0; s < SPT; ++s) {
+        const int i = t + s * THREADS, ic = i < TF4 ? i : TF4 - 1, k = ic / (H_TILE / 4), s4 = ic - k * (H_TILE / 4);
+        src[s] = k * (D / 4) + s4;
+        dst[s] = i < TF4 ? k * (H_TILE / 4) + (s4 & 1) * (H_TILE / 8) + (s4 >> 1) : i;
+    }
+    using f4v = float __attribute__((ext_vector_type(4)));
+    f4v* hb = reinterpret_cast<f4v*>(hbuf);
+    const f4v* xs = reinterpret_cast<const f4v*>(m.xn);
+    f4v sreg[SPT];
+    uint4 wv[PD + 1][HQ];
+    float acc[T];
+#pragma unroll
+    for (int k = 0; k < T; ++k) acc[k] = 0.0f;
+#pragma unroll
+    for (int h = 0; h < PD; ++h)
+#pragma unroll
+        for (int q = 0; q < HQ; ++q) wv[h][q] = __ldg(w4 + h * (H_TILE / 8) + 32 * q);
+    one_wait(cnt, T * HC, err);
+#pragma unroll
+    for (int s = 0; s < SPT; ++s) sreg[s] = xs[src[s]];
+#pragma unroll
+    for (int s = 0; s < SPT; ++s) hb[dst[s]] = sreg[s];
+#pragma unroll
+    for (int s = 0; s < SPT; ++s) sreg[s] = xs[H_TILE / 4 + src[s]];
+    lds_sync();
+#pragma unroll
+    for (int h = 0; h < N_HTILES; ++h) {
+        if (h + 1 < N_HTILES) {
+#pragma unroll
+            for (int s = 0; s < SPT; ++s) hb[((h + 1) & 1) * BUF + dst[s]] = sreg[s];
+        }
+        if (h + 2 < N_HTILES) {
+#pragma unroll
+            for (int s = 0; s < SPT; ++s) sreg[s] = xs[(h + 2) * (H_TILE / 4) + src[s]];
+        }
+        if (h + PD < N_HTILES) {
+#pragma unroll
+            for (int q = 0; q < HQ; ++q)
+                wv[(h + PD) % (PD + 1)][q] = __ldg(w4 + (h + PD) * (H_TILE / 8) + 32 * q);
+        }
+        if (active) {
+            const float4* cur = hbuf + (h & 1) * BUF;
+#pragma unroll
+            for (int q = 0; q < HQ; ++q) {
+                const int j = lane + 32 * q;
+                const Bf16x8 wq = unpack8(wv[h % (PD + 1)][q]);
+#pragma unroll
+                for (int k = 0; k < T; ++k) {
+                    const float4* pk = cur + k * (H_TILE / 4);
+                    acc[k] += dot8u(wq, pk[j], pk[H_TILE / 8 + j]);
+                }
+            }
+        }
+        lds_sync();
+    }
+    if (active) {
+#pragma unroll
+        for (int k = 0; k < T; ++k) {
+            const float s = warp_sum_dpp(acc[k]);
+            if (lane != k) continue;
+            if (inject_block) {
+                m.a[k].inject_out[row] = s;
+            } else {
+                const float x = s / (float) HC;
+                m.a[k].lo[row] = x / (1.0f + __expf(-x));
+            }
+        }
+    }
+    one_signal(cnt + 1);
+}
+
+// gr_up_q32_kernel<T> for columns [32 bu, 32 bu + 32): a column's stream row is 8 lanes, lane j holding the q32 kernel's
+// lanes j, j + 8, j + 16, j + 24 and chunk 32 + j, so its butterfly's stages 16 and 8 are the in-lane sums below
+template <int T>
+__device__ __forceinline__ void one_up(const GrMulti& m, int bu, unsigned* cnt, unsigned* err, float* sm) {
+    float (*lo)[LR] = reinterpret_cast<float (*)[LR]>(sm);
+    float (*rsS)[HC] = reinterpret_cast<float (*)[HC]>(sm + T * LR);
+    float (*g)[HC][ONE_COLS] = reinterpret_cast<float (*)[HC][ONE_COLS]>(sm + T * LR + T * HC);
+    float (*ms)[ONE_COLS] = reinterpret_cast<float (*)[ONE_COLS]>(sm + T * LR + T * HC + T * HC * ONE_COLS);
+    const int t = threadIdx.x, j = t & 7, grp = t >> 3, lane = t & 31, warp = t >> 5;
+    const int d0 = bu * ONE_COLS;
+    uint4 w[HC][5];
+#pragma unroll
+    for (int c = 0; c < HC; ++c) {
+        const uint4* w4 = reinterpret_cast<const uint4*>(m.a[0].w_up + (size_t) (c * N + d0 + grp) * LR);
+#pragma unroll
+        for (int q = 0; q < 4; ++q) w[c][q] = __ldg(w4 + j + 8 * q);
+        w[c][4] = __ldg(w4 + 32 + j);
+    }
+    float rv[HC] = {}, wn[HC] = {}, bo[HC] = {}, ip[HC] = {};
+    bool apply = false;
+    if (j < T) {
+        const FusedGrArgs& a = m.a[j];
+        apply = a.apply;
+#pragma unroll
+        for (int c = 0; c < HC; ++c) {
+            const int i = c * N + d0 + grp;
+            rv[c] = a.R[i];
+            wn[c] = a.w_norm[i];
+            if (apply) { bo[c] = a.bo_prev[d0 + grp]; ip[c] = a.inj_prev[c]; }
+        }
+    }
+    one_wait(cnt + 1, DOWN_BLOCKS + 1, err);
+    if (t == 0) atomicAdd(cnt + 2, 1u);
+    for (int i = t; i < T * LR; i += THREADS) lo[i / LR][i % LR] = m.a[i / LR].lo[i % LR];
+    if (t < T * HC) rsS[t / HC][t % HC] = m.a[t / HC].rs[t % HC];
+    __syncthreads();
+    float mine[HC] = {};
+#pragma unroll
+    for (int k = 0; k < T; ++k) {
+        const float4* l4 = reinterpret_cast<const float4*>(lo[k]);
+        const float4 a0 = l4[2 * j], a1 = l4[2 * j + 1], b0 = l4[2 * (j + 8)], b1 = l4[2 * (j + 8) + 1];
+        const float4 c0 = l4[2 * (j + 16)], c1 = l4[2 * (j + 16) + 1], e0 = l4[2 * (j + 24)], e1 = l4[2 * (j + 24) + 1];
+        const float4 f0 = l4[2 * (32 + j)], f1 = l4[2 * (32 + j) + 1];
+#pragma unroll
+        for (int c = 0; c < HC; ++c) {
+            const float p0 = dot8u(unpack8(w[c][0]), a0, a1) + dot8u(unpack8(w[c][4]), f0, f1);   // q32 lane j
+            const float p1 = dot8u(unpack8(w[c][1]), b0, b1);                                    // lane j + 8
+            const float p2 = dot8u(unpack8(w[c][2]), c0, c1);                                    // lane j + 16
+            const float p3 = dot8u(unpack8(w[c][3]), e0, e1);                                    // lane j + 24
+            const float s = xor8_dpp((p0 + p2) + (p1 + p3));
+            if (j == k) mine[c] = s;
+        }
+    }
+    if (j < T) {
+#pragma unroll
+        for (int c = 0; c < HC; ++c) {
+            float x0 = rv[c];
+            if (apply) {
+                x0 = fmaf(bo[c], 2.0f * sigmoidf_(ip[c] / (float) HC), x0);
+                m.a[j].R_out[c * N + d0 + grp] = x0;
+            }
+            const float x = x0 * wn[c] * rsS[j][c];
+            g[j][c][grp] = x * sigmoidf_(mine[c]);
+        }
+    }
+    __syncthreads();
+    for (int i = t; i < T * ONE_COLS; i += THREADS) {
+        const int k = i / ONE_COLS, col = i - k * ONE_COLS;
+        float s = 0.0f;
+#pragma unroll
+        for (int c = 0; c < HC; ++c) s += g[k][c][col];
+        const float v = s / (float) HC;
+        m.a[k].mixed[d0 + col] = v;
+        ms[k][col] = v;
+    }
+    if (m.a[0].q8_mixed != nullptr) {
+        __syncthreads();
+        if (warp < T) {
+            const float xi = ms[warp][lane];
+            float amax = fabsf(xi), sum = xi;
+#pragma unroll
+            for (int o = 16; o > 0; o >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, o));
+#pragma unroll
+            for (int o = 16; o > 0; o >>= 1) sum += __shfl_xor_sync(0xffffffffu, sum, o);
+            const float d = q8_1_finite(amax / 127.0f);
+            const int8_t q = q8_1_quant(xi, d, amax);
+            GrQ81* y = reinterpret_cast<GrQ81*>(m.a[warp].q8_mixed) + d0 / 32;
+            y->qs[lane] = q;
+            if (lane == 0) y->ds = q8_1_ds(d, sum);
+        }
+    }
+}
