+void one_setup() {
+    int dev = 0;
+    if (cudaGetDevice(&dev) != cudaSuccess || dev < 0 || dev >= 64) return;
+    std::lock_guard<std::mutex> lk(g_one_mu);
+    OnePool& p = g_one[dev];
+    if (p.base) return;
+    const size_t bytes = sizeof(unsigned) * kOneSlots * kOneSlotU;
+    if (cudaFuncSetAttribute(gr_one_kernel<5>, cudaFuncAttributeMaxDynamicSharedMemorySize, (int) one_smem(5)) != cudaSuccess ||
+        cudaFuncSetAttribute(gr_one_kernel<6>, cudaFuncAttributeMaxDynamicSharedMemorySize, (int) one_smem(6)) != cudaSuccess ||
+        cudaMalloc((void**) &p.base, bytes) != cudaSuccess || cudaMemset(p.base, 0, bytes) != cudaSuccess) {
+        (void) cudaGetLastError();
+        if (p.base) (void) cudaFree(p.base);
