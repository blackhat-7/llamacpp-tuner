index 000000000..6c4fecaad
--- /dev/null
+++ b/include/strata/kernels/cpu/umwait.hpp
@@ -0,0 +1,47 @@
+// include/strata/kernels/cpu/umwait.hpp - how the expert pool's parked workers and the host's doorbell wait pass the
+// time until the write they wait for.
+//
+// A pool worker computes experts for about a third of a decode round and waits the rest: for the next phase, the next
+// layer, the next window.  A `_mm_pause` spin keeps its core in C0 at full clock all that time.  Measured on an
+// i5-13600K (6P+8E), 14 threads waiting the way the pool does: pause spins draw ~55 W at the wall over the idle
+// machine, UMWAIT in C0.2 ~20 W less (C0.1 only ~4 W less).  Under a package power limit that power is taken from the
+// cores doing the work, and it is heat.  An OS sleep is no answer: its wake-up costs tens of microseconds against
+// phases a few microseconds to a few hundred apart (a short STRATA_POOL_SPIN_US measured -22% decode).
+//
+// UMWAIT (WAITPKG: Intel Tremont, Alder Lake and later) rests the core in C0.2 until the monitored cache line is
+// written, an interrupt arrives or the OS's time limit expires (Linux: 100,000 TSC cycles, ~29 us).  Measured there:
+// a wake costs 0.18 us on a P-core against 0.08 us for a pause spin (0.03 us on an E-core), and a GPU's store to the
+// mapped host memory the doorbell lives in (hipHostMalloc) wakes it as promptly as a spin sees the store.
+#pragma once
+
+#include <cstdint>
+#include <immintrin.h>
+
+namespace strata::kernels::cpu {
+
+/// STRATA_UMWAIT=1 (on by default on gfx1100: arch_defaults.cpp) on Linux with a WAITPKG CPU: the waits below rest
+/// in C0.2.  STRATA_UMWAIT=0, another OS or CPU: `_mm_pause` spins.
+bool umwait_enabled();
+/// Arm the monitor on `p`'s cache line.  Only with `umwait_enabled()`.
+void umonitor_line(const volatile void* p);
+/// Rest until the monitored line is written, an interrupt or the time limit.  Only with `umwait_enabled()`.
+void umwait_line();
+
+/// One poll of a loop that waits for a write to `p`'s cache line: one UMWAIT when enabled, else one `_mm_pause`.
+/// `waiting()` is checked again once the monitor is armed, so a write that landed just before is not slept through.
+/// It can return before the write (an interrupt, the time limit): the caller loops, as it does around the pause.
+template <class Waiting>
+inline void wait_poll(const volatile void* p, Waiting waiting) {
+    if (umwait_enabled()) {
+        umonitor_line(p);
+        if (waiting()) umwait_line();
+    } else {
+        _mm_pause();
+    }
+}
+
+/// How many polls a wait loop lets pass between looks at the clock: 1024 pauses (~33 us on a P-core) or 16 UMWAITs
+/// (at most ~0.5 ms), so the loops' timeouts and periodic checks keep their cadence in both modes.
+inline uint32_t wait_clock_mask() { return umwait_enabled() ? 15u : 1023u; }
+
+}  // namespace strata::kernels::cpu
