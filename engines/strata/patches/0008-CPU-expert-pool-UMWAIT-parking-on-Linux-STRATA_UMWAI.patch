 namespace strata::kernels::cpu {
 
+bool umwait_enabled() {
+    static const bool on = [] {
+#if defined(STRATA_HAVE_WAITPKG)
+        unsigned a = 0, b = 0, c = 0, d = 0;
+        if (!__get_cpuid_count(7, 0, &a, &b, &c, &d) || !((c >> 5) & 1u)) return false;   // CPUID.7.0:ECX[5] WAITPKG
+        const char* v = std::getenv("STRATA_UMWAIT");
+        return v != nullptr && std::atoi(v) != 0;
+#else
+        return false;
+#endif
+    }();
+    return on;
+}
+
+#if defined(STRATA_HAVE_WAITPKG)
+__attribute__((target("waitpkg"))) void umonitor_line(const volatile void* p) { _umonitor((void*) p); }
+// control 0 = C0.2.  The deadline (~37 us at 3.5 GHz) only matters where the OS sets no shorter limit.
+__attribute__((target("waitpkg"))) void umwait_line() { _umwait(0u, __rdtsc() + (1ull << 17)); }
+#else
+void umonitor_line(const volatile void*) {}
+void umwait_line() { _mm_pause(); }
+#endif
