+void ExpertPool::prof_phase(int m, uint64_t start, uint64_t end) {
+    for (ThreadProf& p : prof_) {
+        if (p.first != 0) {
+            p.wake[m] += p.first - start;
+            p.tail[m] += end - p.last;
+            ++p.phases[m];
+        }
+        p.first = 0;
+    }
+    prof_ns_[m] += end - start;
+    ++prof_n_[m];
+}
+
+void ExpertPool::prof_report() const {
+    for (int m = 0; m < 2; ++m) {
+        if (prof_n_[m] == 0) continue;
+        const double ph = (double) prof_ns_[m] / (double) prof_n_[m];
+        uint64_t busy = 0;
+        for (const ThreadProf& p : prof_) busy += p.busy[m];
+        std::fprintf(stderr, "pool prof %s: %llu phases, %.1f us each; threads busy %.1f%% of the phase time\n",
+                     m == 0 ? "gate/up" : "down", (unsigned long long) prof_n_[m], ph / 1e3,
+                     100.0 * (double) busy / ((double) prof_ns_[m] * (double) prof_.size()));
+        for (size_t i = 0; i < prof_.size(); ++i) {
+            const ThreadProf& p = prof_[i];
+            const int cpu = i == 0 ? topo_.host_core : (i - 1 < topo_.worker_cores.size() ? topo_.worker_cores[i - 1] : -1);
+            const double np = p.phases[m] ? (double) p.phases[m] : 1.0;
+            std::fprintf(stderr, "  %s cpu %2d: busy %5.1f%%  in %5.1f%% of phases  %4.2f tasks  %5.2f us/task  wake %5.2f us  "
+                                 "idle after its last task %6.2f us\n",
+                         i == 0 ? "host  " : "worker", cpu, 100.0 * (double) p.busy[m] / (double) prof_ns_[m],
+                         100.0 * (double) p.phases[m] / (double) prof_n_[m], (double) p.tasks[m] / np,
+                         p.tasks[m] ? (double) p.busy[m] / (double) p.tasks[m] / 1e3 : 0.0,
+                         (double) p.wake[m] / np / 1e3, (double) p.tail[m] / np / 1e3);
+        }
+    }
+}
