-// The bytes of part `p` that fall in one block; 0 for an empty part.  Parts 0-3 hold the same number of bytes for
-// every cell, the pooled part one row per kIndexBlock cells.  False when the part does not divide evenly.
-bool chunk_bytes(const Layer& l, size_t p, uint64_t& out) {
-    out = 0;
-    if (!l.sizes[p]) return true;
-    const int64_t units = p == 4 ? l.pooled_rows : l.cells;
-    if (units <= 0 || l.sizes[p] % (uint64_t) units) return false;
-    out = l.sizes[p] / (uint64_t) units * (uint64_t) (p == 4 ? kBlockTokens / kIndexBlock : kBlockTokens);
+// Parts 0-3 hold the same number of bytes for every cell, the pooled part one row per kIndexBlock cells.
+int64_t units(const Layer& l, size_t p) { return p == 4 ? l.pooled_rows : l.cells; }
+bool divides(const Layer& l) {
+    for (size_t p = 0; p < 5; ++p)
+        if (l.sizes[p] && (units(l, p) <= 0 || l.sizes[p] % (uint64_t) units(l, p))) return false;
     return true;
 }
+// The bytes of part `p` that fall in one block (0: an empty part), for a layer that divides().
+uint64_t per_block(const Layer& l, size_t p) {
+    if (!l.sizes[p]) return 0;
+    return l.sizes[p] / (uint64_t) units(l, p) * (uint64_t) (p == 4 ? kBlockTokens / kIndexBlock : kBlockTokens);
+}
 
