+// Whether the launchers instantiate an N-column kernel with role X (a KvRole serves one column count only).
+template <class X, int N>
+constexpr bool role_takes = true;
+// STRATA_QSA_KV_ROLE: two small g11 GEMVs of the same input and column count (QSA's k and v, 512 rows each) as front
+// blocks of another GEMV (q): blocks [0, k.blocks) run k's g11 rows as a k.blocks grid would, the next v.blocks v's.
+// One instantiation per (k, v) type pair, so q's kernel keeps max(q, k, v) registers.
+struct KvMat {
+    const void* w;
+    float* y;
+    int blocks;
+};
+template <int NC, class GK, class GV>
+struct KvRole {
+    KvMat k, v;
+    const Q81Block* x;
+    int n_out;    // rows of k and of v
+    int blocks;   // k.blocks + v.blocks
+    __device__ __forceinline__ void run(int b) const {
+        if (b < k.blocks)
+            g11_rows<GK, NC, 10, false>(static_cast<const typename GK::Block*>(k.w), x, k.y, n_out, b, k.blocks);
+        else
+            g11_rows<GV, NC, 10, false>(static_cast<const typename GV::Block*>(v.w), x, v.y, n_out, b - k.blocks, v.blocks);
+    }
+};
+template <int NC, class GK, class GV, int N>
+constexpr bool role_takes<KvRole<NC, GK, GV>, N> = NC == N;
+
