+// STRATA_QSA_KV_ROLE: 512-row k / v weights of each g11 type (random bytes, sane scales), outputs for the role call
+struct KvW {
+    int type;
+    void* w;
+};
+std::vector<KvW> g_kv;
+float *g_ky = nullptr, *g_vy = nullptr, *g_kref = nullptr, *g_vref = nullptr;
+bool kv_init(std::mt19937& rng) {
+    const int types[4][3] = {{23, 136, 0}, {12, 144, 0}, {13, 176, 0}, {14, 210, 208}};   // type, block bytes, scale at
+    for (const auto& t : types) {
+        const std::size_t nb = 512u * 10u, bytes = nb * (std::size_t) t[1];
+        std::vector<uint8_t> w(bytes);
+        for (auto& b : w) b = (uint8_t) (rng() & 0xff);
+        for (std::size_t k = 0; k < nb; ++k) {
+            const uint16_t h = sane_half(rng);
+            std::memcpy(&w[k * (std::size_t) t[1] + (std::size_t) t[2]], &h, 2);
+            if (t[0] == 12 || t[0] == 13) {
+                const uint16_t h2 = sane_half(rng);
+                std::memcpy(&w[k * (std::size_t) t[1] + 2], &h2, 2);
+            }
+        }
+        void* d = nullptr;
+        if (!ck(cudaMalloc(&d, bytes), "malloc kv") || !ck(cudaMemcpy(d, w.data(), bytes, cudaMemcpyHostToDevice), "copy kv")) return false;
+        g_kv.push_back({t[0], d});
+    }
+    for (float** p : {&g_ky, &g_vy, &g_kref, &g_vref})
+        if (!ck(cudaMalloc(p, 4u * 512u * 4u), "malloc kvy")) return false;
+    return true;
+}
 
