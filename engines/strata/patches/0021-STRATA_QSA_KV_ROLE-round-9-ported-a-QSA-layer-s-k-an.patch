+#if defined(__HIPCC__)
+template <class GK, class GV>
+bool kv_role_mmvq(int q_type, const void* wq, float* yq, int n_q, KvMat k, KvMat v, const void* x_q8_1, int n_kv,
+                  int n_in, int ncols, void* stream) {
+    const auto* x = static_cast<const Q81Block*>(x_q8_1);
+    const int b = k.blocks + v.blocks;
+    switch (ncols) {
+    case 2: return g11_mmvq(q_type, wq, x_q8_1, yq, n_in, n_q, 2, stream, KvRole<2, GK, GV>{k, v, x, n_kv, b});
+    case 3: return g11_mmvq(q_type, wq, x_q8_1, yq, n_in, n_q, 3, stream, KvRole<3, GK, GV>{k, v, x, n_kv, b});
+    case 4: return g11_mmvq(q_type, wq, x_q8_1, yq, n_in, n_q, 4, stream, KvRole<4, GK, GV>{k, v, x, n_kv, b});
+    }
+    return false;
+}
+#endif
+bool native_mmvq_kv_role(int q_type, const void* wq, float* yq, int n_q, int k_type, const void* wk, float* yk,
+                         int v_type, const void* wv, float* yv, int n_kv, const void* x_q8_1, int n_in, int ncols,
+                         void* stream) {
+#if defined(__HIPCC__)
+    // k and v must be calls native_mmvq gives to g11_shape (2560 inputs, below r4's 2048 rows); the light g11 types only
+    // (Q4_K / Q5_K bodies would cost q's kernel waves)
+    if (ncols < 2 || ncols > 4 || n_in != 2560 || n_kv >= 2048 || !g11_on() || !g11_device() || !wk || !wv || !yk || !yv)
+        return false;
+    if (q_type == 14 && ncols == 4) return false;   // r4_q6k<4>: 120 -> 122+ VGPRs, 12 -> 10 waves a SIMD
+    const int kb = int(g11_blocks(n_kv, ncols));
+    const KvMat k{wk, yk, kb}, v{wv, yv, kb};
+    const auto go = [&](auto gk, auto gv) {
+        return kv_role_mmvq<decltype(gk), decltype(gv)>(q_type, wq, yq, n_q, k, v, x_q8_1, n_kv, n_in, ncols, stream);
+    };
+    if (k_type == 14 && v_type == 14) return go(G11Q6K{}, G11Q6K{});
+    if (k_type == 14 && v_type == 23) return go(G11Q6K{}, G11IQ4XS{});
+    if (k_type == 23 && v_type == 14) return go(G11IQ4XS{}, G11Q6K{});
+    if (k_type == 23 && v_type == 23) return go(G11IQ4XS{}, G11IQ4XS{});
+    return false;
+#else
+    return false;
+#endif
+}
