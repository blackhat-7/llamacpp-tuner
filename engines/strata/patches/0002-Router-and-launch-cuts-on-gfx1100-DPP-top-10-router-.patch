+        for (int i = 0; i < R; ++i)
+#pragma unroll
+            for (int k = 0; k < NT; ++k) partials[i][k][t] = 0.0f;
+    }
+    __syncthreads();
+    float acc[R][NT];
+#pragma unroll
+    for (int i = 0; i < R; ++i)
+#pragma unroll
+        for (int k = 0; k < NT; ++k) acc[i][k] = 0.0f;
+    for (int pair = t; pair < n_in / 2; pair += BLOCK_SIZE) {
