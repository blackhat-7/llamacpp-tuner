+// src/kernels/router_tail_parity.cpp - STRATA_ROUTER_TAIL's one launch against the three it replaces: the router GEMV
+// (bf16_gemv_fp32_mmvf_multi), the top-10 (native_router_top10_multi) and the doorbell (doorbell_publish_res).
+// Logits, ids, weights, the published ids and activations and the ring must be bitwise the same, for T = 1..4 rows,
+// on random rows, on all-zero activations (every logit ties: the lowest ids win) and on duplicated weight rows
+// (pairs of equal logits), each over many launches of one captured graph (the ticket must come back to zero).
+//
+//     build/router_tail_parity
+#include "strata/kernels/bf16_gemv.hpp"
+#include "strata/kernels/elementwise.hpp"
+#include "strata/kernels/native_router.hpp"
+#include "strata/kernels/verify_kernels.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+namespace K = strata::kernels;
+
+#define CK(x) do { cudaError_t e_ = (x); if (e_ != cudaSuccess) { std::fprintf(stderr, "%s: %s\n", #x, cudaGetErrorString(e_)); std::exit(1); } } while (0)
+
+namespace {
+
+constexpr int N = 2560, NE = 512, KK = 10, REPS = 50;
+
+struct Mapped {
+    float* x = nullptr; int32_t* ids = nullptr; uint32_t* seq = nullptr;     // host views
+    float* dx = nullptr; int32_t* dids = nullptr; uint32_t* dseq = nullptr;  // device views
+    explicit Mapped(int T) {
+        CK(cudaHostAlloc((void**) &x, (size_t) T * N * 4, cudaHostAllocMapped));
+        CK(cudaHostAlloc((void**) &ids, (size_t) T * KK * 4, cudaHostAllocMapped));
+        CK(cudaHostAlloc((void**) &seq, 64, cudaHostAllocMapped));
+        CK(cudaHostGetDevicePointer((void**) &dx, x, 0));
+        CK(cudaHostGetDevicePointer((void**) &dids, ids, 0));
+        CK(cudaHostGetDevicePointer((void**) &dseq, seq, 0));
+        std::memset(x, 0, (size_t) T * N * 4);
+        std::memset(ids, 0xff, (size_t) T * KK * 4);
+        *seq = 0;
+    }
+};
+
+// 0: random rows, 1: all-zero activations, 2: random rows with every odd weight row a copy of the one before
+bool run_case(int T, int kind, unsigned seed) {
+    std::mt19937 rng(seed);
+    std::normal_distribution<float> nd(0.f, 1.f);
+    std::vector<uint16_t> w((size_t) NE * N);
+    for (auto& v : w) {
+        const float f = 0.05f * nd(rng);
+        uint32_t u;
+        std::memcpy(&u, &f, 4);
+        v = (uint16_t) ((u + 0x7fff + ((u >> 16) & 1)) >> 16);
+    }
+    if (kind == 2)
+        for (int r = 1; r < NE; r += 2) std::memcpy(&w[(size_t) r * N], &w[(size_t) (r - 1) * N], (size_t) N * 2);
+    std::vector<float> x((size_t) T * N);
+    for (auto& v : x) v = kind == 1 ? 0.f : nd(rng);
+    uint16_t* dw; float* dxin; float *lg[2], *wt[2]; int32_t* id[2]; unsigned* ticket;
+    CK(cudaMalloc((void**) &dw, w.size() * 2));
+    CK(cudaMemcpy(dw, w.data(), w.size() * 2, cudaMemcpyHostToDevice));
+    CK(cudaMalloc((void**) &dxin, x.size() * 4));
+    CK(cudaMemcpy(dxin, x.data(), x.size() * 4, cudaMemcpyHostToDevice));
+    for (int v = 0; v < 2; ++v) {
+        CK(cudaMalloc((void**) &lg[v], (size_t) T * NE * 4));
+        CK(cudaMalloc((void**) &wt[v], (size_t) T * KK * 4));
+        CK(cudaMalloc((void**) &id[v], (size_t) T * KK * 4));
+        CK(cudaMemset(lg[v], 0, (size_t) T * NE * 4));
+    }
+    CK(cudaMalloc((void**) &ticket, 4));
+    CK(cudaMemset(ticket, 0, 4));
+    Mapped m[2] = {Mapped(T), Mapped(T)};
+    cudaStream_t st;
+    CK(cudaStreamCreateWithFlags(&st, cudaStreamNonBlocking));
+    // the reference: the engine's three launches (d_res null: every expert a miss, so the activations are published)
+    cudaGraph_t g[2];
+    cudaGraphExec_t ex[2];
+    CK(cudaStreamBeginCapture(st, cudaStreamCaptureModeThreadLocal));
+    K::bf16_gemv_fp32_mmvf_multi(dxin, N, dw, lg[0], NE, N, NE, T, st);
+    K::native_router_top10_multi(lg[0], id[0], wt[0], T, st);
+    K::doorbell_publish_res(dxin, id[0], nullptr, NE, (int64_t) T * N, (int64_t) T * KK, m[0].dx, m[0].dids, m[0].dseq, st);
+    CK(cudaStreamEndCapture(st, &g[0]));
+    CK(cudaStreamBeginCapture(st, cudaStreamCaptureModeThreadLocal));
+    const bool launched = K::native_router_tail(dxin, dw, lg[1], id[1], wt[1], m[1].dx, m[1].dids, m[1].dseq, ticket, T, N, st);
+    CK(cudaStreamEndCapture(st, &g[1]));
+    if (!launched) {
+        std::printf("router_tail_parity: not available on this build/device (T=%d)\n", T);
+        return true;
+    }
+    for (int v = 0; v < 2; ++v) CK(cudaGraphInstantiate(&ex[v], g[v], nullptr, nullptr, 0));
+    for (int r = 0; r < REPS; ++r)
+        for (int v = 0; v < 2; ++v) CK(cudaGraphLaunch(ex[v], st));
+    CK(cudaStreamSynchronize(st));
+    std::vector<float> l0((size_t) T * NE), l1((size_t) T * NE), w0((size_t) T * KK), w1((size_t) T * KK);
+    std::vector<int32_t> i0((size_t) T * KK), i1((size_t) T * KK);
+    unsigned tk = 1;
+    CK(cudaMemcpy(l0.data(), lg[0], l0.size() * 4, cudaMemcpyDeviceToHost));
+    CK(cudaMemcpy(l1.data(), lg[1], l1.size() * 4, cudaMemcpyDeviceToHost));
+    CK(cudaMemcpy(w0.data(), wt[0], w0.size() * 4, cudaMemcpyDeviceToHost));
+    CK(cudaMemcpy(w1.data(), wt[1], w1.size() * 4, cudaMemcpyDeviceToHost));
+    CK(cudaMemcpy(i0.data(), id[0], i0.size() * 4, cudaMemcpyDeviceToHost));
+    CK(cudaMemcpy(i1.data(), id[1], i1.size() * 4, cudaMemcpyDeviceToHost));
+    CK(cudaMemcpy(&tk, ticket, 4, cudaMemcpyDeviceToHost));
+    const bool ok = !std::memcmp(l0.data(), l1.data(), l0.size() * 4) && !std::memcmp(w0.data(), w1.data(), w0.size() * 4) &&
+                    i0 == i1 && !std::memcmp(m[0].x, m[1].x, (size_t) T * N * 4) &&
+                    !std::memcmp(m[0].ids, m[1].ids, (size_t) T * KK * 4) && !std::memcmp(m[0].ids, i0.data(), i0.size() * 4) &&
+                    !std::memcmp(m[0].x, x.data(), x.size() * 4) && *m[0].seq == REPS && *m[1].seq == REPS && tk == 0;
+    std::printf("T=%d %-10s seed %u: %s (ring %u/%u, ticket %u, ids row 0:", T,
+                kind == 0 ? "random" : kind == 1 ? "zero x" : "dup rows", seed, ok ? "bitwise equal" : "DIFFERENT",
+                *m[0].seq, *m[1].seq, tk);
+    for (int k = 0; k < KK; ++k) std::printf(" %d", i1[k]);
+    std::printf(")\n");
+    for (int v = 0; v < 2; ++v) {
+        CK(cudaGraphExecDestroy(ex[v]));
+        CK(cudaGraphDestroy(g[v]));
+        CK(cudaFree(lg[v])); CK(cudaFree(wt[v])); CK(cudaFree(id[v]));
+        CK(cudaFreeHost(m[v].x)); CK(cudaFreeHost(m[v].ids)); CK(cudaFreeHost(m[v].seq));
+    }
+    CK(cudaFree(dw)); CK(cudaFree(dxin)); CK(cudaFree(ticket));
+    CK(cudaStreamDestroy(st));
+    return ok;
+}
+
+// STRATA_RT_BENCH=1: the time of one router tail in a graph of 48 launches on 48 different weight matrices (126 MB,
+// more than the 96 MB Infinity Cache: the weights come from VRAM as in the engine), against 48 empty kernels
+void bench(int T) {
+    constexpr int L = 48, REP = 20;
+    std::mt19937 rng(1234u + (unsigned) T);
+    std::uniform_int_distribution<int> ud(-3000, 3000);
+    std::vector<uint16_t> w((size_t) NE * N);
+    for (auto& v : w) v = (uint16_t) (0x3c00 + ud(rng));   // bf16 around 0.0078 +- a few binades
+    std::vector<float> x((size_t) T * N);
+    for (auto& v : x) v = (float) ud(rng) / 3000.f;
+    std::vector<uint16_t*> dw(L);
+    for (int l = 0; l < L; ++l) {
+        CK(cudaMalloc((void**) &dw[l], w.size() * 2));
+        CK(cudaMemcpy(dw[l], w.data(), w.size() * 2, cudaMemcpyHostToDevice));
+    }
+    float *dx, *lg, *wt; int32_t* id; unsigned* ticket;
+    CK(cudaMalloc((void**) &dx, x.size() * 4));
+    CK(cudaMemcpy(dx, x.data(), x.size() * 4, cudaMemcpyHostToDevice));
+    CK(cudaMalloc((void**) &lg, (size_t) T * NE * 4));
+    CK(cudaMalloc((void**) &wt, (size_t) T * KK * 4));
+    CK(cudaMalloc((void**) &id, (size_t) T * KK * 4));
+    CK(cudaMalloc((void**) &ticket, 4));
+    CK(cudaMemset(ticket, 0, 4));
+    Mapped m(T);
+    cudaStream_t st;
+    CK(cudaStreamCreateWithFlags(&st, cudaStreamNonBlocking));
+    cudaGraph_t g[2];
+    cudaGraphExec_t ex[2];
+    CK(cudaStreamBeginCapture(st, cudaStreamCaptureModeThreadLocal));
+    for (int l = 0; l < L; ++l) K::native_router_tail(dx, dw[l], lg, id, wt, m.dx, m.dids, m.dseq, ticket, T, N, st);
+    CK(cudaStreamEndCapture(st, &g[0]));
+    CK(cudaStreamBeginCapture(st, cudaStreamCaptureModeThreadLocal));
+    for (int l = 0; l < L; ++l) K::gpu_noop(st);
+    CK(cudaStreamEndCapture(st, &g[1]));
+    cudaEvent_t a, b;
+    CK(cudaEventCreate(&a));
+    CK(cudaEventCreate(&b));
+    float us[2];
+    for (int v = 0; v < 2; ++v) {
+        CK(cudaGraphInstantiate(&ex[v], g[v], nullptr, nullptr, 0));
+        for (int r = 0; r < 3; ++r) CK(cudaGraphLaunch(ex[v], st));
+        CK(cudaEventRecord(a, st));
+        for (int r = 0; r < REP; ++r) CK(cudaGraphLaunch(ex[v], st));
+        CK(cudaEventRecord(b, st));
+        CK(cudaEventSynchronize(b));
+        float ms = 0.f;
+        CK(cudaEventElapsedTime(&ms, a, b));
+        us[v] = ms * 1000.f / (REP * L);
+    }
+    const char* rows = std::getenv("STRATA_ROUTER_TAIL_ROWS");
+    std::printf("bench T=%d rows %s: router tail %.2f us a launch, empty kernel %.2f us (ring %u)\n", T, rows ? rows : "1",
+                us[0], us[1], *m.seq);
+    for (int v = 0; v < 2; ++v) { CK(cudaGraphExecDestroy(ex[v])); CK(cudaGraphDestroy(g[v])); }
+    for (int l = 0; l < L; ++l) CK(cudaFree(dw[l]));
+    CK(cudaFree(dx)); CK(cudaFree(lg)); CK(cudaFree(wt)); CK(cudaFree(id)); CK(cudaFree(ticket));
+    CK(cudaFreeHost(m.x)); CK(cudaFreeHost(m.ids)); CK(cudaFreeHost(m.seq));
+    CK(cudaEventDestroy(a)); CK(cudaEventDestroy(b));
+    CK(cudaStreamDestroy(st));
+}
+
+}  // namespace
+
+int main() {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    K::native_router_set_enabled(true);
+    if (const char* b = std::getenv("STRATA_RT_BENCH"); b != nullptr && b[0] == '1') {
+        for (int T = 1; T <= 4; ++T) bench(T);
+        return 0;
+    }
+    bool ok = true;
+    for (int T = 1; T <= 4; ++T)   // T = 1: STRATA_T1_FUSE's one-token windows
+        for (int kind = 0; kind < 3; ++kind)
+            for (unsigned seed = 1; seed <= (kind == 1 ? 1u : 4u); ++seed) ok &= run_case(T, kind, seed * 7919u + (unsigned) T);
+    std::printf("router_tail_parity: %s\n", ok ? "OK" : "FAILED");
+    return ok ? 0 : 1;
+}
