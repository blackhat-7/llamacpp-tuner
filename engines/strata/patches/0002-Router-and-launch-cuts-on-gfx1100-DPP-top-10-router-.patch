+template <int BLOCK_SIZE, int NT, int R>
+__device__ __forceinline__ void mmvf_multi_rows_block(const float* __restrict__ x, int64_t ldx, const uint16_t* __restrict__ w,
+                                                      float* __restrict__ y, int64_t ldy, int n_in, int r0) {
