+            }
+        }
+    }
+#pragma unroll
+    for (int i = 0; i < R; ++i)
+#pragma unroll
+        for (int k = 0; k < NT; ++k) acc[i][k] = mmvf_warp_sum(acc[i][k]);
+    if constexpr (BLOCK_SIZE > 32) {
+        if ((t & 31) == 0)
+#pragma unroll
+            for (int i = 0; i < R; ++i)
+#pragma unroll
+                for (int k = 0; k < NT; ++k) partials[i][k][t / 32] = acc[i][k];
+        __syncthreads();
+        if (t < 32)
+#pragma unroll
+            for (int i = 0; i < R; ++i)
+#pragma unroll
+                for (int k = 0; k < NT; ++k) acc[i][k] = mmvf_warp_sum(partials[i][k][t]);
+    }
+    if (t == 0)
+#pragma unroll
+        for (int i = 0; i < R; ++i)
+#pragma unroll
+            for (int k = 0; k < NT; ++k) y[(size_t) k * ldy + r0 + i] = acc[i][k];
+}
