+#if defined(__HIPCC__)
+namespace {
+// gfx1100 dense IQ3_S (native_mmvq's r4 family): eight lanes a row, four rows a wave, the grid in LDS. The exact layout
+// (mmvq_multi_kernel, a warp a row) gives lane l = 8 q + r the superblocks q + 4 j at iqs 2 r; lane r of a row group
+// holds every q, one running sum each, so a row's sums are the same; the xor tree is q ^ 2 and q ^ 1 in-lane, then
+// lane ^ 4, ^ 2 and ^ 1.
+template <int NC, int BPR>
+__launch_bounds__(128) __global__ void iq3s_r4_kernel(const block_iq3_s* __restrict__ w, const block_q8_1* __restrict__ x,
+                                                      float* __restrict__ y, int n_out) {
+    __shared__ uint32_t grid[512];
+    for (int k = int(threadIdx.x); k < 512; k += 128) grid[k] = iq3s_grid[k];
+    __syncthreads();
+    const int lane = int(threadIdx.x) & 31;
+    const int g = lane >> 3, r = lane & 7;
+    const int groups = (n_out + 3) / 4;
+    for (int rg = int(blockIdx.x) * 4 + (int(threadIdx.x) >> 5); rg < groups; rg += int(gridDim.x) * 4) {
+        const int row = rg * 4 + g;
+        const block_iq3_s* wr = w + (size_t) min(row, n_out - 1) * BPR;
+        float s[4][NC];
+#pragma unroll
+        for (int q = 0; q < 4; ++q)
+#pragma unroll
+            for (int c = 0; c < NC; ++c) s[q][c] = 0.0f;
+#pragma unroll 1
+        for (int j = 0; j * 4 < BPR; ++j) {
+#pragma unroll
+            for (int q = 0; q < 4; ++q) {
+                const int kbx = 4 * j + q;
+                if (kbx < BPR) {
+                    const block_iq3_s* b = wr + kbx;
+                    uint2 qs8;
+                    __builtin_memcpy(&qs8, b->qs + 8 * r, 8);
+                    const uint32_t qh = b->qh[r];
+                    uint32_t sg;
+                    __builtin_memcpy(&sg, b->signs + 4 * r, 4);
+                    const int ls = 1 + 2 * ((b->scales[r / 2] >> (4 * (r & 1))) & 0x0f);
+                    const float dw = __half2float(b->d);
+                    int gq[8];
+#pragma unroll
+                    for (int l0 = 0; l0 < 8; l0 += 2) {
+                        const uint32_t word = l0 < 4 ? qs8.x : qs8.y;
+                        const uint32_t b0 = (word >> (8 * (l0 & 3))) & 0xff, b1 = (word >> (8 * ((l0 & 3) + 1))) & 0xff;
+                        iq_signed8(grid[b0 | ((qh << (8 - l0)) & 0x100)], grid[b1 | ((qh << (7 - l0)) & 0x100)],
+                                   (sg >> (4 * l0)) & 0xff, gq[l0], gq[l0 + 1]);
+                    }
+#pragma unroll
+                    for (int c = 0; c < NC; ++c) {
+                        const block_q8_1* xb = x + c * BPR * 8 + kbx * 8 + r;
+                        int4 u0, u1;
+                        __builtin_memcpy(&u0, xb->qs, 16);
+                        __builtin_memcpy(&u1, xb->qs + 16, 16);
+                        int sumi = 0;
+                        sumi = ggml_cuda_dp4a(gq[0], u0.x, sumi);
+                        sumi = ggml_cuda_dp4a(gq[1], u0.y, sumi);
+                        sumi = ggml_cuda_dp4a(gq[2], u0.z, sumi);
+                        sumi = ggml_cuda_dp4a(gq[3], u0.w, sumi);
+                        sumi = ggml_cuda_dp4a(gq[4], u1.x, sumi);
+                        sumi = ggml_cuda_dp4a(gq[5], u1.y, sumi);
+                        sumi = ggml_cuda_dp4a(gq[6], u1.z, sumi);
+                        sumi = ggml_cuda_dp4a(gq[7], u1.w, sumi);
+                        s[q][c] = __builtin_fmaf(dw * __low2float(xb->ds), float(__mul24(sumi, ls)), s[q][c]);
+                    }
+                }
+                __builtin_amdgcn_sched_barrier(0);   // a superblock's activations stay in its own iteration
+            }
+        }
+        if (row < n_out) {
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                float t = (s[0][c] + s[2][c]) + (s[1][c] + s[3][c]);
+                t += __shfl_xor(t, 4, 32);
+                t += __shfl_xor(t, 2, 32);
+                t += __shfl_xor(t, 1, 32);
+                if (r == c) y[(size_t) c * n_out + row] = t;
+            }
+        }
+    }
+}
+template <int BPR>
+void iq3s_r4_launch(const block_iq3_s* w, const block_q8_1* x, float* y, int n_out, int ncols, unsigned blocks,
+                    cudaStream_t s) {
+    switch (ncols) {
+#define STRATA_R4(N) case N: iq3s_r4_kernel<N, BPR><<<blocks, 128, 0, s>>>(w, x, y, n_out); break;
+        STRATA_R4(1) STRATA_R4(2) STRATA_R4(3) STRATA_R4(4) STRATA_R4(5) STRATA_R4(6)
+#undef STRATA_R4
+    }
+}
+}  // namespace
+
+bool iq3s_r4_mmvq(const void* w, const void* x_q8_1, float* y, int n_in, int n_out, int ncols, unsigned blocks,
+                  void* stream) {
+    if (ncols < 1 || ncols > 6 || (n_in != 2560 && n_in != 6144)) return false;
+    const auto* W = (const block_iq3_s*) w;
+    const auto* X = (const block_q8_1*) x_q8_1;
+    const auto s = (cudaStream_t) stream;
+    if (n_in == 2560) iq3s_r4_launch<10>(W, X, y, n_out, ncols, blocks, s);
+    else iq3s_r4_launch<24>(W, X, y, n_out, ncols, blocks, s);
+    return true;
+}
+#endif
+
 void iq_dequant_f16(int t, const void* src, int64_t n, uint16_t* dst, void* stream, const float* scale) {
     if (n % 256 != 0 || !is_iq(t)) { std::fprintf(stderr, "iq_dequant_f16: bad arguments\n"); std::exit(1); }
     dequant_flat_kernel<__half><<<(unsigned) (n / 256), 32, 0, (cudaStream_t) stream>>>(t, src, (__half*) dst, scale);
