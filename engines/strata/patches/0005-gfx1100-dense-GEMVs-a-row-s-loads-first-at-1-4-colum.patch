+// src/kernels/mmvq_g11_parity.cpp - native_mmvq's gfx1100 kernels (g11 and r4, native_mmvq_g11_tune) against its own
+// kernels (iq_mmvq's for IQ3_S), bitwise, for 1-6 columns and several grids; --bench times both per call (graphs of
+// calls cycling through weight copies, so no call reads another's weights from cache).
+//
+//     build/mmvq_g11_parity [--bench]
+//
+// The same Q8_1 bytes feed both paths. Weights are random bytes with the block scales rewritten as normal fp16 values,
+// so every output is finite (a NaN would compare equal whatever produced it). On a card other than gfx1100 the
+// kernels are not used and the test only checks that.
+#include "strata/kernels/iq_kernels.hpp"
+#include "strata/kernels/native_mmvq.hpp"
+
+#include <cuda_runtime.h>
