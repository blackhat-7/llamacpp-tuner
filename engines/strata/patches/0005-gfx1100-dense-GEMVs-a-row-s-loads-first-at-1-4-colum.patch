+struct Case {
+    const char* name;
+    int type, n_in, n_out, block_bytes, scale_at[2];
+};
+// the engine's dense shapes (qkv 10240 / gate 6144 / out 2560 / q 12288 / k,v 512 / shared 640), odd row counts and the
+// vocabulary heads (the model's is Q5_K; the others cover the head kernels of every type)
+const Case CASES[] = {
+    {"IQ4_XS 2560x10240", 23, 2560, 10240, 136, {0, -1}},  {"IQ4_XS 2560x6144", 23, 2560, 6144, 136, {0, -1}},
+    {"IQ4_XS 6144x2560", 23, 6144, 2560, 136, {0, -1}},    {"IQ4_XS 2560x12288", 23, 2560, 12288, 136, {0, -1}},
+    {"IQ4_XS 2560x512", 23, 2560, 512, 136, {0, -1}},      {"IQ4_XS 2560x640", 23, 2560, 640, 136, {0, -1}},
+    {"IQ4_XS head 2560x248320", 23, 2560, 248320, 136, {0, -1}},
+    {"Q4_K 2560x10240", 12, 2560, 10240, 144, {0, 2}},     {"Q4_K 2560x6144", 12, 2560, 6144, 144, {0, 2}},
+    {"Q4_K 6144x2560", 12, 6144, 2560, 144, {0, 2}},       {"Q4_K 2560x12288", 12, 2560, 12288, 144, {0, 2}},
+    {"Q4_K 2560x640", 12, 2560, 640, 144, {0, 2}},         {"Q4_K 2560x2051 odd", 12, 2560, 2051, 144, {0, 2}},
+    {"Q4_K head 2560x248320", 12, 2560, 248320, 144, {0, 2}},
+    {"Q5_K 2560x10240", 13, 2560, 10240, 176, {0, 2}},     {"Q5_K 2560x6144", 13, 2560, 6144, 176, {0, 2}},
+    {"Q5_K 6144x2560", 13, 6144, 2560, 176, {0, 2}},       {"Q5_K 2560x640", 13, 2560, 640, 176, {0, 2}},
+    {"Q5_K head 2560x248320", 13, 2560, 248320, 176, {0, 2}},
+    {"Q6_K 2560x10240", 14, 2560, 10240, 210, {208, -1}},  {"Q6_K 2560x6144", 14, 2560, 6144, 210, {208, -1}},
+    {"Q6_K 6144x2560", 14, 6144, 2560, 210, {208, -1}},    {"Q6_K 2560x12288", 14, 2560, 12288, 210, {208, -1}},
+    {"Q6_K 2560x512", 14, 2560, 512, 210, {208, -1}},      {"Q6_K 6144x2051 odd", 14, 6144, 2051, 210, {208, -1}},
+    {"Q6_K head 2560x248320", 14, 2560, 248320, 210, {208, -1}}, {"Q5_K head 2560x99999 odd", 13, 2560, 99999, 176, {0, 2}},
+    {"Q5_K 6144x2051 odd", 13, 6144, 2051, 176, {0, 2}},   {"IQ4_XS 2560x2051 odd", 23, 2560, 2051, 136, {0, -1}},
+    {"IQ3_S 2560x6144", 21, 2560, 6144, 110, {0, -1}},     {"IQ3_S 6144x2560", 21, 6144, 2560, 110, {0, -1}},
+    {"IQ3_S 2560x12288", 21, 2560, 12288, 110, {0, -1}},   {"IQ3_S 2560x2051 odd", 21, 2560, 2051, 110, {0, -1}},
+};
+
+uint16_t sane_half(std::mt19937& rng) {
+    const uint32_t r = rng();
+    return (uint16_t) (((r >> 31) << 15) | ((5u + (r >> 10) % 5u) << 10) | (r & 0x3ffu));
+}
+bool ck(cudaError_t e, const char* what) {
+    if (e == cudaSuccess) return true;
+    std::printf("CUDA: %s: %s\n", what, cudaGetErrorString(e));
+    return false;
+}
+// microseconds a call: a captured graph of `launches` calls, median of 6 replays
+double time_calls(cudaStream_t s, int launches, const std::function<void(int)>& call) {
+    cudaGraph_t g;
+    cudaGraphExec_t ge;
+    if (!ck(cudaStreamBeginCapture(s, hipStreamCaptureModeGlobal), "capture")) return 0;
+    for (int i = 0; i < launches; ++i) call(i);
+    if (!ck(cudaStreamEndCapture(s, &g), "end capture") || !ck(cudaGraphInstantiate(&ge, g, nullptr, nullptr, 0), "instantiate"))
+        return 0;
+    cudaEvent_t e0, e1;
+    cudaEventCreate(&e0);
+    cudaEventCreate(&e1);
+    std::vector<float> t;
+    for (int rep = 0; rep < 7; ++rep) {
+        cudaEventRecord(e0, s);
+        cudaGraphLaunch(ge, s);
+        cudaEventRecord(e1, s);
+        cudaEventSynchronize(e1);
+        float ms = 0;
+        cudaEventElapsedTime(&ms, e0, e1);
+        if (rep > 0) t.push_back(ms);
+    }
+    std::sort(t.begin(), t.end());
+    cudaGraphExecDestroy(ge);
+    cudaGraphDestroy(g);
+    cudaEventDestroy(e0);
+    cudaEventDestroy(e1);
+    return 1000.0 * t[t.size() / 2] / launches;
+}
+
+int run_case(const Case& c, bool bench, cudaStream_t s) {
+    const std::size_t wbytes = native_mmvq_weight_bytes(c.type, c.n_in, c.n_out);
+    std::mt19937 rng(77u + (unsigned) c.type * 31u + (unsigned) c.n_out);
+    std::vector<uint8_t> w(wbytes);
+    for (auto& b : w) b = (uint8_t) (rng() & 0xff);
+    const std::size_t n_blocks = (std::size_t) c.n_out * (std::size_t) (c.n_in / 256);
+    if (n_blocks * (std::size_t) c.block_bytes != wbytes) {
+        std::printf("%s: weight bytes mismatch\n", c.name);
+        return 1;
+    }
+    for (std::size_t k = 0; k < n_blocks; ++k)
+        for (int at : c.scale_at)
+            if (at >= 0) {
+                const uint16_t h = sane_half(rng);
+                std::memcpy(&w[k * (std::size_t) c.block_bytes + (std::size_t) at], &h, 2);
+            }
+    const int copies = bench ? (int) std::max<std::size_t>(1, std::min<std::size_t>(64, (320u << 20) / wbytes + 1)) : 1;
+    std::vector<void*> dw(copies, nullptr);
+    for (int i = 0; i < copies; ++i)
+        if (!ck(cudaMalloc(&dw[i], wbytes), "malloc w") || !ck(cudaMemcpy(dw[i], w.data(), wbytes, cudaMemcpyHostToDevice), "copy w"))
+            return 1;
+    int bad = 0;
+    for (int T = 1; T <= 6; ++T) {
+        std::vector<float> x((std::size_t) T * c.n_in);
+        std::normal_distribution<float> nd(0.f, 1.f);
+        for (auto& v : x) v = nd(rng);
+        float* dx = nullptr;
+        void* xq = nullptr;
+        float *yref = nullptr, *yg = nullptr;
+        const std::size_t ybytes = (std::size_t) T * c.n_out * 4;
+        if (!ck(cudaMalloc(&dx, x.size() * 4), "malloc x") || !ck(cudaMalloc(&xq, native_q8_1_bytes(c.n_in, T)), "malloc xq") ||
+            !ck(cudaMalloc((void**) &yref, ybytes), "malloc yref") || !ck(cudaMalloc((void**) &yg, ybytes), "malloc yg"))
+            return 1;
+        ck(cudaMemcpy(dx, x.data(), x.size() * 4, cudaMemcpyHostToDevice), "copy x");
+        quantize_q8_1_rows(dx, T, c.n_in, xq, s);
+        native_mmvq_g11_tune(0, 0);
+        native_mmvq(c.type, dw[0], xq, yref, c.n_in, c.n_out, T, s);
+        ck(cudaStreamSynchronize(s), "ref");
+        std::vector<uint32_t> a((std::size_t) T * c.n_out), b(a.size());
+        ck(cudaMemcpy(a.data(), yref, ybytes, cudaMemcpyDeviceToHost), "read ref");
+        for (int grid : {0, 1, 7, 96}) {
+            native_mmvq_g11_tune(1, grid);
+            cudaMemsetAsync(yg, 0xff, ybytes, s);
+            native_mmvq(c.type, dw[0], xq, yg, c.n_in, c.n_out, T, s);
+            ck(cudaStreamSynchronize(s), "g11");
+            ck(cudaMemcpy(b.data(), yg, ybytes, cudaMemcpyDeviceToHost), "read g11");
+            long long diff = 0, nonfinite = 0;
+            for (std::size_t i = 0; i < a.size(); ++i) {
+                float fa;
+                std::memcpy(&fa, &a[i], 4);
+                nonfinite += !std::isfinite(fa);
+                diff += a[i] != b[i];
+            }
+            if (diff != 0 || nonfinite != 0) {
+                ++bad;
+                std::printf("FAIL %-24s T=%d grid=%d: %lld bits differ, %lld non-finite of %zu\n", c.name, T, grid, diff,
+                            nonfinite, a.size());
+            }
+        }
+        if (bench && std::strstr(c.name, "odd") == nullptr) {
+            const int launches = std::max(copies, wbytes > (100u << 20) ? 8 : 64);
+            native_mmvq_g11_tune(0, 0);
+            const double ref = time_calls(s, launches, [&](int i) { native_mmvq(c.type, dw[i % copies], xq, yref, c.n_in, c.n_out, T, s); });
+            std::printf("BENCH %-24s T=%d  native %7.1f us |", c.name, T, ref);
+            for (int grid : {0, 384, 1536}) {
+                native_mmvq_g11_tune(1, grid);
+                const double t = time_calls(s, launches, [&](int i) { native_mmvq(c.type, dw[i % copies], xq, yg, c.n_in, c.n_out, T, s); });
+                std::printf(" g11/%d %7.1f", grid, t);
+            }
+            std::printf(" us (%.0f MB)\n", wbytes / 1e6);
+        }
+        native_mmvq_g11_tune(-1, 0);
+        cudaFree(dx);
+        cudaFree(xq);
+        cudaFree(yref);
+        cudaFree(yg);
+    }
+    for (void* p : dw) cudaFree(p);
+    return bad;
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    const bool bench = argc > 1 && std::string(argv[1]) == "--bench";
+    cudaStream_t s;
+    cudaStreamCreateWithFlags(&s, cudaStreamNonBlocking);
+    const char* only = std::getenv("MMVQ_G11_ONLY");   // only the cases whose name contains this
+    int bad = 0;
+    for (const Case& c : CASES)
+        if (only == nullptr || std::strstr(c.name, only) != nullptr) bad += run_case(c, bench, s);
+    std::printf("%s\n", bad ? "mmvq_g11_parity: FAIL" : "mmvq_g11_parity: OK (every case, T 1-6, four grids, bitwise)");
+    return bad ? 1 : 0;
+}
