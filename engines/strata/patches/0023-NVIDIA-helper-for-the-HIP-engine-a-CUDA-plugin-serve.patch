index 000000000..a3bf09cb0
--- /dev/null
+++ b/include/strata/core/nv_helper_abi.h
@@ -0,0 +1,59 @@
+// include/strata/core/nv_helper_abi.h - the cross-vendor expert helper: an NVIDIA card serving a HIP engine's
+// --expert-cache-device1 tier.  HIP and CUDA cannot share a build, so the CUDA side is a plugin
+// (libstrata_nvhelper.so, built by tools/nvhelper/build.sh) that the HIP engine loads with dlopen when
+// STRATA_NV_HELPER names it.  Everything crosses through pinned host memory, as the same-make helpers do.
+// Plain C: the two sides are built by different compilers.
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SNV_ABI 5
+
+/// One layer's expert format (strata::kernels::cpu::NativeFmt's fields the GPU kernels read).
+typedef struct SnvFmt {
+    int gu_type, d_type;
+    int64_t n_embd, n_ff;
+    int had_gu, had_d, had_block;
+} SnvFmt;
+
+typedef struct SnvApi {
+    int abi;
+    /// Card number as CUDA counts it; spin = busy-wait syncs (the layer waits on this card).  Fills *free_bytes.
+    int (*preflight)(int device, int spin, size_t* free_bytes);
+    /// pool_bytes of VRAM for expert slots, staging for cap_rows rows of h floats, meta_bytes of group metadata.
+    int (*open)(int device, uint64_t pool_bytes, int cap_rows, int h, int ff, uint64_t meta_bytes);
+    void (*close)(void);
+    uint64_t (*pool_base)(void);   ///< device address of slot offset 0, for the metadata's blob pointers
+    float* (*host_x)(void);        ///< pinned: the layer's activations, n_tok x h
+    float* (*host_out)(void);      ///< pinned: the computed rows, packed in metadata order
+    void* (*host_meta)(void);      ///< pinned: the group metadata, copied to the card at each launch
+    int (*fill)(uint64_t off, const void* src, uint64_t bytes, int wait);
+    /// Pin host memory for the card's copy engine (the expert arena), so swap fills are DMA, not staged.
+    int (*register_host)(void* p, uint64_t bytes);
+    /// The adaptive tier: queue a slot fill on the card's own copy stream (beside the experts' launches)...
+    int (*swap_fill)(uint64_t off, const void* src, uint64_t bytes);
+    /// ...and 1 once every queued swap fill has landed, 0 while one is in flight, -1 on an error.
+    int (*swap_done)(void);
+    int (*read)(uint64_t off, void* dst, uint64_t bytes);   ///< card -> host, waits
+    int (*set_signs)(const float* sx, int h, const float* sh, int ff);
+    /// Run the grouped experts on host_x, write host_out.  x_q8: host_x holds the n_tok rows as q8_1 blocks (the
+    /// engine quantized them), else as floats the card quantizes.  Returns at once; wait() joins.
+    int (*launch)(const SnvFmt* fmt, int n_tok, int groups, int rows, int x_q8);
+    int (*wait)(void);
+    /// STRATA_NV_TIMING=1: the card's own time from a launch's first copy to its last write, summed over the launches
+    /// waited for (cudaEvent stamps; 0 when off).
+    double (*gpu_ms)(void);
+    const char* (*last_error)(void);
+} SnvApi;
+
+/// The plugin's one exported symbol.
+const SnvApi* snv_api(void);
+
+#ifdef __cplusplus
+}
+#endif
