+namespace {
+// q8_1 blocks of `n_tok` rows of H floats, bit for bit the GPU's quantize_q8_1_rows (iq_kernels.cu, IEEE division):
+// d = amax / 127 and the block sum taken in its warp's XOR-butterfly order (lane j + lane j^16, then ^8, ^4, ^2, ^1;
+// a + b == b + a, so every lane holds lane 0's sum), both kept finite as fp16 (q8_1_finite.hpp); codes roundf'ed.
+__attribute__((target("avx2,f16c"))) void quantize_q8_1_host(const float* x, int64_t n_tok, void* out) {
+    struct Blk { uint16_t d, s; int8_t qs[32]; };
+    static_assert(sizeof(Blk) == 36, "block_q8_1");
+    const __m256 sign = _mm256_set1_ps(-0.0f), half = _mm256_set1_ps(0.5f), one = _mm256_set1_ps(1.0f);
+    const __m256 hmax = _mm256_set1_ps(65504.0f);
+    auto finite = [](float v) { return std::fabs(v) > 65504.0f ? std::copysign(65504.0f, v) : v; };
+    auto* b = (Blk*) out;
+    for (int64_t i = 0; i < n_tok * H / 32; ++i, ++b) {
+        const float* p = x + i * 32;
+        const __m256 v0 = _mm256_loadu_ps(p), v1 = _mm256_loadu_ps(p + 8), v2 = _mm256_loadu_ps(p + 16),
+                     v3 = _mm256_loadu_ps(p + 24);
+        __m256 m = _mm256_max_ps(_mm256_max_ps(_mm256_andnot_ps(sign, v0), _mm256_andnot_ps(sign, v1)),
+                                 _mm256_max_ps(_mm256_andnot_ps(sign, v2), _mm256_andnot_ps(sign, v3)));
+        m = _mm256_max_ps(m, _mm256_permute2f128_ps(m, m, 1));
+        m = _mm256_max_ps(m, _mm256_shuffle_ps(m, m, 0x4E));
+        m = _mm256_max_ps(m, _mm256_shuffle_ps(m, m, 0xB1));
+        const float amax = _mm256_cvtss_f32(m);
+        __m256 t = _mm256_add_ps(_mm256_add_ps(v0, v2), _mm256_add_ps(v1, v3));    // ^16, then ^8
+        t = _mm256_add_ps(t, _mm256_permute2f128_ps(t, t, 1));                      // ^4
+        t = _mm256_add_ps(t, _mm256_shuffle_ps(t, t, 0x4E));                        // ^2
+        t = _mm256_add_ps(t, _mm256_shuffle_ps(t, t, 0xB1));                        // ^1
+        const float d = std::fabs(amax / 127.0f) > 65504.0f ? 65504.0f : amax / 127.0f;
+        const __m256 dv = _mm256_set1_ps(d), lim = _mm256_set1_ps(127.0f);
+        __m256i q[4];
+        const __m256 vs[4] = {v0, v1, v2, v3};
+        for (int k = 0; k < 4; ++k) {
+            const __m256 y = _mm256_div_ps(vs[k], dv);
+            __m256 r = _mm256_round_ps(y, _MM_FROUND_TO_ZERO | _MM_FROUND_NO_EXC);   // roundf: half away from zero
+            const __m256 up = _mm256_cmp_ps(_mm256_andnot_ps(sign, _mm256_sub_ps(y, r)), half, _CMP_GE_OQ);
+            r = _mm256_add_ps(r, _mm256_and_ps(up, _mm256_or_ps(one, _mm256_and_ps(sign, y))));
+            r = _mm256_min_ps(_mm256_max_ps(r, _mm256_sub_ps(_mm256_setzero_ps(), lim)), lim);
+            q[k] = _mm256_cvtps_epi32(amax == 0.0f ? _mm256_setzero_ps() : r);
+        }
+        const __m256i w01 = _mm256_packs_epi32(q[0], q[1]), w23 = _mm256_packs_epi32(q[2], q[3]);
+        const __m256i b8 = _mm256_permutevar8x32_epi32(_mm256_packs_epi16(w01, w23), _mm256_setr_epi32(0, 4, 1, 5, 2, 6, 3, 7));
+        _mm256_storeu_si256((__m256i*) b->qs, b8);
+        (void) hmax;
+        b->d = _cvtss_sh(d, _MM_FROUND_TO_NEAREST_INT);
+        b->s = _cvtss_sh(finite(_mm256_cvtss_f32(t)), _MM_FROUND_TO_NEAREST_INT);
+    }
