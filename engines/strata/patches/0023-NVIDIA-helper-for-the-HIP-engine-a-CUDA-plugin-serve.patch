diff --git a/src/core/nv_helper_plugin.cu b/src/core/nv_helper_plugin.cu
new file mode 100644
index 000000000..c12119ef3
--- /dev/null
+++ b/src/core/nv_helper_plugin.cu
@@ -0,0 +1,251 @@
+// src/core/nv_helper_plugin.cu - the CUDA side of the cross-vendor expert helper (nv_helper_abi.h).  Built into
+// libstrata_nvhelper.so by the CUDA configuration (target strata_nvhelper); a HIP engine loads it to compute the
+// experts an NVIDIA card holds.  It runs the same kernels the CUDA engine's RemoteExperts runs, on one stream.
+#include "strata/core/nv_helper_abi.h"
+#include "strata/kernels/iq_kernels.hpp"
+#include "strata/kernels/window_limits.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+namespace {
+constexpr int CAP = strata::kernels::kWindowMaxT * 10;   // a window's rows x top-10, as RemoteExperts sizes it
+
+// RemoteExperts' metadata layout (remote_experts.cpp), filled by the HIP side in host_meta().
+struct Meta {
+    unsigned long long ptr[CAP];
+    int32_t start[CAP + 1];
+    int32_t dst[CAP];
+    int32_t tok[CAP];
+    int32_t count;
+};
+
+struct State {
+    int dev = -1, h = 0, ff = 0;
+    cudaStream_t s = nullptr, rs = nullptr, fs = nullptr;
+    cudaEvent_t fill_ev = nullptr, t0 = nullptr, t1 = nullptr, tq = nullptr, tg = nullptr;   // STRATA_NV_TIMING
+    double gpu_ms = 0, q_ms = 0, g_ms = 0, c_ms = 0;
+    bool fills_queued = false;
+    uint8_t* pool = nullptr;
+    float *h_x = nullptr, *h_out = nullptr, *z_x = nullptr, *z_out = nullptr, *d_xr = nullptr, *d_out = nullptr;
+    void *h_meta = nullptr, *z_meta = nullptr, *d_meta = nullptr, *d_scratch = nullptr;
+    uint8_t* d_q8 = nullptr;
+    const float *d_sx = nullptr, *d_sh = nullptr;
+    std::string err;
+} S;
+
+// A layer's inputs onto the card in one pass over the link: the metadata's used entries and the q8_1 rows.  The
+// grouped kernels then read card memory; read in place, every block would cross the link again for them.
+__global__ void stage_in(const Meta* __restrict__ hm, Meta* __restrict__ dm, const int4* __restrict__ hx,
+                         int4* __restrict__ dx, int groups, int rows, int nx16) {
+    const int t = blockIdx.x * blockDim.x + threadIdx.x, nt = gridDim.x * blockDim.x;
+    for (int i = t; i < nx16; i += nt) dx[i] = hx[i];
+    for (int i = t; i < groups; i += nt) dm->ptr[i] = hm->ptr[i];
+    for (int i = t; i <= groups; i += nt) dm->start[i] = hm->start[i];
+    for (int i = t; i < rows; i += nt) { dm->dst[i] = hm->dst[i]; dm->tok[i] = hm->tok[i]; }
+    if (t == 0) dm->count = hm->count;
+}
+
+// The rows to the host in 16-byte stores: the down kernel writes one float per warp, and 4-byte writes over the
+// chipset's PCIe x4 link cost several times the whole layer's compute.
+__global__ void rows_to_host(const float4* __restrict__ src, float4* __restrict__ dst, int n4) {
+    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n4; i += gridDim.x * blockDim.x) dst[i] = src[i];
+}
+
+bool ok(cudaError_t e, const char* what) {
+    if (e == cudaSuccess) return true;
+    S.err = std::string(what) + ": " + cudaGetErrorString(e);
+    cudaGetLastError();
+    return false;
+}
+
+int p_preflight(int device, int spin, size_t* free_bytes) {
+    // The layer waits on this card from the CPU pool's critical path: spin instead of sleeping (only possible
+    // before the context exists).
+    if (spin) cudaInitDevice(device, cudaDeviceScheduleSpin | cudaDeviceMapHost, 0);
+    cudaGetLastError();
+    size_t total = 0;
+    if (!ok(cudaSetDevice(device), "cudaSetDevice") || !ok(cudaMemGetInfo(free_bytes, &total), "cudaMemGetInfo"))
+        return -1;
+    return 0;
+}
+
+
+void p_close() {
+    if (S.dev < 0) return;
+    cudaSetDevice(S.dev);
+    if (S.s) cudaStreamSynchronize(S.s);
+    if (S.rs) cudaStreamSynchronize(S.rs);
+    if (S.fs) cudaStreamSynchronize(S.fs);
+    for (void* p : {(void*) S.pool, S.d_meta, (void*) S.d_scratch, (void*) S.d_q8, (void*) S.d_xr, (void*) S.d_out})
+        if (p) cudaFree(p);
+    for (void* p : {(void*) S.h_x, (void*) S.h_out, S.h_meta})
+        if (p) cudaFreeHost(p);
+    if (S.s) cudaStreamDestroy(S.s);
+    if (S.rs) cudaStreamDestroy(S.rs);
+    if (S.fs) cudaStreamDestroy(S.fs);
+    if (S.fill_ev) cudaEventDestroy(S.fill_ev);
+    if (S.t0) cudaEventDestroy(S.t0);
+    if (S.t1) cudaEventDestroy(S.t1);
+    if (S.tq) cudaEventDestroy(S.tq);
+    if (S.tg) cudaEventDestroy(S.tg);
+    S = State{};
+}
+
+int p_open(int device, uint64_t pool_bytes, int cap_rows, int h, int ff, uint64_t meta_bytes) {
+    p_close();
+    if (cap_rows != CAP || meta_bytes != sizeof(Meta)) {
+        S.err = "the engine and the plugin were built with different window sizes (STRATA_VERIFY_MAX_T)";
+        return -1;
+    }
+    S.dev = device;
+    S.h = h;
+    S.ff = ff;
+    const size_t scratch = strata::kernels::native_expert_scratch_bytes(CAP, ff);
+    const bool good =
+        ok(cudaSetDevice(device), "cudaSetDevice") &&
+        ok(cudaStreamCreateWithFlags(&S.s, cudaStreamNonBlocking), "stream") &&
+        ok(cudaStreamCreateWithFlags(&S.rs, cudaStreamNonBlocking), "read stream") &&
+        ok(cudaStreamCreateWithFlags(&S.fs, cudaStreamNonBlocking), "swap stream") &&
+        ok(cudaEventCreateWithFlags(&S.fill_ev, cudaEventDisableTiming), "swap event") &&
+        ok(cudaMalloc((void**) &S.pool, pool_bytes), "expert slots") &&
+        ok(cudaHostAlloc((void**) &S.h_x, (size_t) CAP * h * sizeof(float), cudaHostAllocPortable | cudaHostAllocMapped), "input staging") &&
+        ok(cudaHostAlloc((void**) &S.h_out, (size_t) CAP * h * sizeof(float), cudaHostAllocPortable | cudaHostAllocMapped), "result staging") &&
+        ok(cudaHostAlloc(&S.h_meta, sizeof(Meta), cudaHostAllocPortable | cudaHostAllocMapped), "metadata staging") &&
+        ok(cudaHostGetDevicePointer(&S.z_meta, S.h_meta, 0), "mapped metadata") &&
+        ok(cudaMalloc(&S.d_meta, sizeof(Meta)), "group metadata") &&
+        ok(cudaHostGetDevicePointer((void**) &S.z_x, S.h_x, 0), "mapped input") &&
+        ok(cudaHostGetDevicePointer((void**) &S.z_out, S.h_out, 0), "mapped result") &&
+        ok(cudaMalloc((void**) &S.d_q8, (size_t) CAP * (h / 32) * 36), "activation") &&
+        ok(cudaMalloc((void**) &S.d_xr, (size_t) CAP * h * sizeof(float)), "rotated input") &&
+        ok(cudaMalloc((void**) &S.d_out, (size_t) CAP * h * sizeof(float)), "result") &&
+        ok(cudaMalloc(&S.d_scratch, scratch), "scratch");
+    const char* tv = std::getenv("STRATA_NV_TIMING");
+    if (good && tv != nullptr && tv[0] == '1') {
+        cudaEventCreate(&S.t0);
+        cudaEventCreate(&S.t1);
+        cudaEventCreate(&S.tq);
+        cudaEventCreate(&S.tg);
+    }
+    if (!good) {
+        const std::string e = S.err;
+        p_close();
+        S.err = e;
+        return -1;
+    }
+    return 0;
+}
+
+int p_fill(uint64_t off, const void* src, uint64_t bytes, int wait) {
+    cudaSetDevice(S.dev);
+    if (!ok(cudaMemcpyAsync(S.pool + off, src, bytes, cudaMemcpyHostToDevice, S.s), "slot fill")) return -1;
+    return wait && !ok(cudaStreamSynchronize(S.s), "slot fill wait") ? -1 : 0;
+}
+
+int p_register_host(void* p, uint64_t bytes) {
+    return ok(cudaHostRegister(p, bytes, cudaHostRegisterPortable), "cudaHostRegister") ? 0 : -1;
+}
+
+int p_swap_fill(uint64_t off, const void* src, uint64_t bytes) {
+    cudaSetDevice(S.dev);
+    if (!ok(cudaMemcpyAsync(S.pool + off, src, bytes, cudaMemcpyHostToDevice, S.fs), "swap fill")) return -1;
+    S.fills_queued = true;
+    return 0;
+}
+
+int p_swap_done() {
+    cudaSetDevice(S.dev);
+    if (S.fills_queued) {   // the event after the last batch: one query answers for all of them
+        if (!ok(cudaEventRecord(S.fill_ev, S.fs), "swap event")) return -1;
+        S.fills_queued = false;
+    }
+    const cudaError_t e = cudaEventQuery(S.fill_ev);
+    if (e == cudaErrorNotReady) { cudaGetLastError(); return 0; }
+    return ok(e, "swap wait") ? 1 : -1;
+}
+
+int p_read(uint64_t off, void* dst, uint64_t bytes) {
+    cudaSetDevice(S.dev);
+    return ok(cudaMemcpyAsync(dst, S.pool + off, bytes, cudaMemcpyDeviceToHost, S.rs), "slot read") &&
+                   ok(cudaStreamSynchronize(S.rs), "slot read wait")
+               ? 0 : -1;
+}
+
+int p_set_signs(const float* sx, int h, const float* sh, int ff) {
+    cudaSetDevice(S.dev);
+    S.d_sx = strata::kernels::hadamard_device_signs(sx, h);
+    S.d_sh = strata::kernels::hadamard_device_signs(sh, ff);
+    return ok(cudaGetLastError(), "hadamard signs") ? 0 : -1;
+}
+
+// No copy-engine work on this path (kernels move the bytes), so the adaptive tier's slot fills never queue in front
+// of a layer.
+int p_launch(const SnvFmt* f, int n_tok, int groups, int rows, int x_q8) {
+    cudaSetDevice(S.dev);
+    if (S.t0) cudaEventRecord(S.t0, S.s);
+    const int nx16 = x_q8 ? n_tok * (S.h / 32) * 36 / 16 : 0;
+    stage_in<<<8, 256, 0, S.s>>>((const Meta*) S.z_meta, (Meta*) S.d_meta, (const int4*) S.z_x, (int4*) S.d_q8,
+                                 groups, rows, nx16);
+    if (!x_q8) {   // floats from pinned host memory (zero-copy), quantized here
+        const float* xe = S.z_x;
+        if (f->had_gu) {
+            strata::kernels::hadamard_rows(xe, S.d_xr, n_tok, S.h, f->had_block, S.d_sx, S.s);
+            xe = S.d_xr;
+        }
+        strata::kernels::quantize_q8_1_rows(xe, n_tok, S.h, S.d_q8, S.s);
+    }
+    if (S.tq) cudaEventRecord(S.tq, S.s);
+    auto L = strata::kernels::native_expert_layout(f->gu_type, f->d_type, f->n_embd, f->n_ff);
+    if (f->had_d) {
+        L.had_block = f->had_block;
+        L.d_signs = S.d_sh;
+    }
+    auto* m = (Meta*) S.d_meta;
+    strata::kernels::native_expert_grouped(L, m->ptr, m->start, &m->count, m->dst, m->tok, groups, rows, S.d_q8,
+                                           S.d_scratch, S.d_out, S.s);
+    if (S.tg) cudaEventRecord(S.tg, S.s);
+    const int n4 = rows * S.h / 4;
+    rows_to_host<<<std::min(64, (n4 + 255) / 256), 256, 0, S.s>>>((const float4*) S.d_out, (float4*) S.z_out, n4);
+    if (S.t1) cudaEventRecord(S.t1, S.s);
+    return ok(cudaGetLastError(), "expert launch") ? 0 : -1;
+}
+
+int p_wait() {
+    cudaError_t e;
+    while ((e = cudaStreamQuery(S.s)) == cudaErrorNotReady) {
+    }
+    if (!ok(e, "expert wait")) return -1;
+    if (S.t1) {
+        float ms = 0;
+        if (cudaEventElapsedTime(&ms, S.t0, S.t1) == cudaSuccess) S.gpu_ms += ms;
+        if (cudaEventElapsedTime(&ms, S.t0, S.tq) == cudaSuccess) S.q_ms += ms;
+        if (cudaEventElapsedTime(&ms, S.tq, S.tg) == cudaSuccess) S.g_ms += ms;
+        if (cudaEventElapsedTime(&ms, S.tg, S.t1) == cudaSuccess) S.c_ms += ms;
+        cudaGetLastError();
+    }
+    return 0;
+}
+
+const SnvApi kApi = {
+    SNV_ABI, p_preflight, p_open, p_close,
+    [] { return (uint64_t) (uintptr_t) S.pool; },
+    [] { return S.h_x; },
+    [] { return S.h_out; },
+    [] { return S.h_meta; },
+    p_fill, p_register_host, p_swap_fill, p_swap_done, p_read, p_set_signs, p_launch, p_wait,
+    [] {
+        if (S.gpu_ms > 0)   // STRATA_NV_TIMING: the split, once, where the engine prints its totals
+            std::fprintf(stderr, "strata nvhelper: card ms: quantize %.1f, experts %.1f, rows out %.1f, total %.1f\n",
+                         S.q_ms, S.g_ms, S.c_ms, S.gpu_ms);
+        return S.gpu_ms;
+    },
+    [] { return S.err.c_str(); },
+};
+} // namespace
