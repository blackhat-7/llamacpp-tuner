@@ -0,0 +1,64 @@
+// include/strata/spec/draft_cum.hpp - the cumulative draft stop (opt-in; it changes which drafts are verified only).
+//
+// --spec-min-p ends the MTP part of a verify window at the first draft whose own probability is below it.
+// STRATA_SPEC_CUM=S also ends it where the estimated chance that every draft so far holds falls below S: the product
+// of acc(p) over the drafts, where acc(p) = p, or with STRATA_SPEC_CUM_ACC=a0,..,a7 the acceptance measured for drafts
+// in the probability bands < 0.3, 0.5, 0.7, 0.8, 0.9, 0.95, 0.99 and above (the draft layer is overconfident in its
+// middle bands).  STRATA_SPEC_CUM_ADAPT=1 (Basalt 47f6192f) lowers S toward 0.25 within a request while its drafts
+// hold more often than acc predicts.  MtpDrafter::draft stops after the first draft the window would not keep.
+#pragma once
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+
+namespace strata::spec {
+
+struct DraftCum {
+    double s = 0.0;   // the threshold; 0 = off (the min_p rule alone)
+    bool table = false;
+    float tab[8] = {};
+    bool adapt = false;
+
+    double acc(float p) const {
+        if (!table) return p;
+        const float edge[7] = {0.3f, 0.5f, 0.7f, 0.8f, 0.9f, 0.95f, 0.99f};
+        int b = 0;
+        while (b < 7 && p >= edge[b]) ++b;
+        return tab[b];
+    }
+
+    static const DraftCum& env() {
+        static const DraftCum d = [] {
+            DraftCum c;
+            if (const char* e = std::getenv("STRATA_SPEC_CUM")) c.s = std::atof(e);
+            if (const char* e = std::getenv("STRATA_SPEC_CUM_ACC"))
+                c.table = std::sscanf(e, "%f,%f,%f,%f,%f,%f,%f,%f", &c.tab[0], &c.tab[1], &c.tab[2], &c.tab[3], &c.tab[4],
+                                      &c.tab[5], &c.tab[6], &c.tab[7]) == 8;
+            const char* a = std::getenv("STRATA_SPEC_CUM_ADAPT");
+            c.adapt = a != nullptr && std::atoi(a) != 0;
+            return c;
+        }();
+        return d;
+    }
+};
+
+// STRATA_SPEC_CUM_ADAPT: a request's threshold.  The accepted drafts and the ones acc predicted decay per window; as
+// their ratio goes from 0.9 to 1.1 the threshold falls from S to min(S, 0.25).  Set before the drafts it sizes.
+struct DraftCumAdapt {
+    double cur = DraftCum::env().s, obs = 0.0, exp = 0.0;
+
+    void observe(const float* probs, int n, int accepted) {
+        const DraftCum& dc = DraftCum::env();
+        if (!dc.adapt || !(dc.s > 0.0) || n <= 0) return;
+        double c = 1.0, e = 0.0;
+        for (int j = 0; j < n; ++j) { c *= dc.acc(probs[j]); e += c; }
+        obs = obs * 0.97 + accepted;
+        exp = exp * 0.97 + e;
+        if (exp < 0.5) return;
+        const double t = std::clamp((obs / exp - 0.9) / 0.2, 0.0, 1.0);
+        cur = dc.s + t * (std::min(0.25, dc.s) - dc.s);
+    }
+};
+
+}  // namespace strata::spec
