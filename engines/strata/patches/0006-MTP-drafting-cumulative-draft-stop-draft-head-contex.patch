+// probabilities move in their last bits (drafts only; the verify decides every token).
+bool mtp_mix_fused() {
+    static const bool on = [] { const char* v = std::getenv("STRATA_MTP_MIX_FUSED"); return v != nullptr && v[0] == '1'; }();
