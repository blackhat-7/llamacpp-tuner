+    for (int32_t t : xlist_) in_sub_[(size_t) t] = 0;
+    for (int32_t t : xpend_) in_sub_[(size_t) t] = 0;
+    std::fill(dvocab_host_.begin() + xbase_, dvocab_host_.end(), -1);
+    xlist_.clear();
+    xpend_.clear();
+    n_xused_ = 0;
+    for (int64_t i = 0; i < n; ++i) ctx_note(prompt[i]);
