+// The MTP window's size: draft i stays while its probability is at least min_p and the estimated chance that every
+// draft up to it holds is at least th (strata/spec/draft_cum.hpp; MtpDrafter::draft stops at the same draft).  th 0 is
+// the plain min_p rule.
+int mtp_window(const float* dprob, int S_mtp, float min_p, double th) {
+    const strata::spec::DraftCum& dc = strata::spec::DraftCum::env();
