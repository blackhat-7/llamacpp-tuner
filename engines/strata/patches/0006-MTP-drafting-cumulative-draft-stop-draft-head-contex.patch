+bool mtp_fuse() {
+#if defined(STRATA_USE_HIP)
+    static const bool on = [] {
+        if (const char* v = std::getenv("STRATA_MTP_FUSE")) return std::atoi(v) != 0;
+        int dev = 0;
+        cudaDeviceProp p;
+        return cudaGetDevice(&dev) == cudaSuccess && cudaGetDeviceProperties(&p, dev) == cudaSuccess &&
+               strata::kernels::gfx_arch_is(p.gcnArchName, "gfx1100");
+    }();
+    return on;
+#else
+    return false;
+#endif
+}
+// STRATA_MTP_MIX_FUSED=1 (r7): the final mixer as the fused hyper-connection read (fused_gr_read_multi, as the layer's
