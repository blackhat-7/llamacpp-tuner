+int checks = 0;
+void check(bool value, const char* description) {
+    ++checks;
+    if (!value) { std::fprintf(stderr, "FAIL: %s\n", description); std::exit(1); }
+}
+
+// A byte of layer `l`, part `p` at `offset`: the same for every conversation, so a longer one starts with the bytes of a
+// shorter one - except the indexer's last (spare) row, which depends on the length.
+uint8_t byte_at(size_t l, size_t p, uint64_t offset, uint64_t salt) {
+    uint64_t x = (l + 1) * 0x9E3779B97F4A7C15ull ^ (p + 7) * 0xC2B2AE3D27D4EB4Full ^ (offset + salt) * 0x165667B19E3779F9ull;
+    x ^= x >> 29; x *= 0xBF58476D1CE4E5B9ull; x ^= x >> 32;
+    return (uint8_t) x;
+}
+
+// n tokens, 3 K/V layers (the last one the "draft"), the checkpoints at `marks`.
+SavedConversation make(size_t n, std::vector<size_t> marks, int32_t token_salt = 0, bool with_image = false) {
+    SavedConversation s;
+    for (size_t i = 0; i < s.geometry.size(); ++i) s.geometry[i] = (int64_t) i + 3;
+    s.layer_lo = 0; s.layer_hi = 36;
+    s.live.ids.resize(n);
+    for (size_t i = 0; i < n; ++i) s.live.ids[i] = (int32_t) ((i * 7 + 3) % 50000) + token_salt;
+    if (with_image) s.live.imgs = {{100, 0xABCDEFull}};
+    auto fill = [](std::vector<uint8_t>& v, size_t bytes, uint64_t salt) {
+        v.resize(bytes);
+        for (size_t i = 0; i < bytes; ++i) v[i] = byte_at(99, 0, i, salt);
+    };
+    auto state = [&](ConversationCheckpoint& c, uint64_t salt) {
+        fill(c.gdn, 300000, salt); fill(c.ple, 5000, salt + 1); fill(c.tails, 70000, salt + 2);
+        fill(c.dead, 33, salt + 3); fill(c.block_pos, 8, salt + 4);
+    };
+    state(s.live, n + (uint64_t) token_salt * 1000003);
+    s.live.used = 1000 + n;
+    for (size_t m : marks) {
+        ConversationCheckpoint c;
+        c.ids.assign(s.live.ids.begin(), s.live.ids.begin() + (std::ptrdiff_t) m);
+        if (with_image && m > 100) c.imgs = s.live.imgs;
+        state(c, m);   // a checkpoint's bytes depend on where it is, not on the conversation
+        c.used = m;
+        s.checkpoints.push_back(std::move(c));
+    }
+    const int64_t cells = (int64_t) ((n + 3) / 4 * 4), rows = (int64_t) (n / 4 + 1);
+    for (size_t l = 0; l < 3; ++l) {
+        ConversationKv k;
+        k.format = 2; k.cells = cells; k.heads = 2; k.head_dim = 64; k.page_size = 4; k.pooled_rows = rows; k.idx_dim = 128;
+        const size_t sizes[5] = {(size_t) cells * 128, (size_t) cells * 128, (size_t) cells * 4, (size_t) cells * 4,
+                                 (size_t) rows * 512};
+        ConversationBuffer* bufs[5] = {&k.k, &k.v, &k.k_scale, &k.v_scale, &k.pooled};
+        for (size_t p = 0; p < 5; ++p) {
+            bufs[p]->resize(sizes[p]);
+            bufs[p]->visit(0, sizes[p], [&](uint8_t* d, size_t c, size_t at) {
+                for (size_t i = 0; i < c; ++i) {
+                    // the last pooled row is the moving spare row
+                    const bool spare = p == 4 && at + i >= sizes[4] - 512;
+                    d[i] = byte_at(l, p, at + i, (uint64_t) token_salt * 1000003 + (spare ? n : 0));
+                }
+                return true;
+            });
+        }
+        s.kv.push_back(std::move(k));
+    }
+    return s;
+}
+
+SavedConversation copy_of(const SavedConversation& s) { return s; }
+
+bool same_checkpoint(const ConversationCheckpoint& a, const ConversationCheckpoint& b) {
+    return a.ids == b.ids && a.imgs == b.imgs && a.gdn == b.gdn && a.ple == b.ple && a.tails == b.tails &&
+           a.dead == b.dead && a.block_pos == b.block_pos && a.used == b.used;
+}
+bool same(const SavedConversation& a, const SavedConversation& b) {
+    if (a.geometry != b.geometry || a.layer_lo != b.layer_lo || a.layer_hi != b.layer_hi || a.cvec != b.cvec ||
+        !same_checkpoint(a.live, b.live) || a.checkpoints.size() != b.checkpoints.size() || a.kv.size() != b.kv.size())
+        return false;
+    for (size_t i = 0; i < a.checkpoints.size(); ++i)
+        if (!same_checkpoint(a.checkpoints[i], b.checkpoints[i])) return false;
+    for (size_t i = 0; i < a.kv.size(); ++i) {
+        const auto &x = a.kv[i], &y = b.kv[i];
+        if (x.format != y.format || x.cells != y.cells || x.heads != y.heads || x.head_dim != y.head_dim ||
+            x.page_size != y.page_size || x.pooled_rows != y.pooled_rows || x.idx_dim != y.idx_dim || !(x.k == y.k) ||
+            !(x.v == y.v) || !(x.k_scale == y.k_scale) || !(x.v_scale == y.v_scale) || !(x.pooled == y.pooled))
+            return false;
+    }
+    return true;
+}
+
+std::vector<int32_t> prompt_of(const SavedConversation& s, size_t extra = 5, int32_t tail = 777777) {
+    auto p = s.live.ids;
+    for (size_t i = 0; i < extra; ++i) p.push_back(tail + (int32_t) i);
+    return p;
+}
