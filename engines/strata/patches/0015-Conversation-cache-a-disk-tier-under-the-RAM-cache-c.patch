@@ -0,0 +1,83 @@
+// The disk tier under the RAM conversation cache (--conversation-cache-disk-mib / --conversation-cache-disk-dir).
+//
+// A conversation that the RAM cache evicts, or that the engine still holds when it ends, is written to a folder and read
+// back when a later prompt starts with it, also after a restart.  Pure host code: no CUDA.
+//
+// On disk a conversation is one small manifest (tokens, the layout, and the hash of every part) plus immutable blob
+// files named by the hash of their bytes: one blob per 2048-token block of K/V (every layer and part together) and one
+// per saved running state.  A conversation written again a few turns on, or another that starts the same way, writes
+// only the blobs that are new: the K/V of a longer conversation starts with the bytes of the shorter one.  A file
+// appears under its final name only once complete and flushed, so a crash leaves nothing a restore can read wrongly;
+// every part is hash-checked on the way back and a conversation with a part that fails is deleted.  The folder keeps
+// to a byte budget, least recently used conversation first; a blob goes with the last conversation that uses it.
+//
+// The writer works only while the engine is idle (no request for a second, progress.hpp): the model's PLE table is
+// read from the same drive in every decode window, and writes beside those reads stall them.
+#pragma once
+
+#include "strata/core/conversation_cache.hpp"
+#include "strata/core/conversation_file.hpp"
+
+#include <chrono>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace strata::core {
+
+class ConversationDisk {
+public:
+    /// A conversation shorter than this is read again faster than it is worth writing.
+    static constexpr size_t min_tokens = 8192;
+    struct Match {
+        uint64_t id = 0;       // names the stored conversation for load()
+        int64_t tokens = 0;    // how much of the prompt it covers; 0 = none
+        uint64_t bytes = 0;    // the RAM load() allocates, for the caller's admission check
+    };
+    struct Stats {
+        size_t conversations = 0, written = 0, restored = 0, dropped = 0;
+        uint64_t disk_bytes = 0, written_bytes = 0, read_bytes = 0;
+    };
+
+    ConversationDisk();
+    ~ConversationDisk();   // ends the writer at its next step; what is still queued is dropped
+    ConversationDisk(const ConversationDisk&) = delete;
+    ConversationDisk& operator=(const ConversationDisk&) = delete;
+
+    /// Creates `dir`, takes its lock (one engine per folder), removes what a crash left and indexes the conversations
+    /// written under any identity.  Only those of `id` and of this build (the binary and its STRATA_* environment) can
+    /// be restored.  A write leaves `min_free_bytes` of the volume free.  `log` receives one line per finished write
+    /// (called from the writer thread).
+    bool open(const std::string& dir, const SessionFileIdentity& id, uint64_t budget_bytes, uint64_t min_free_bytes,
+              std::function<void(const std::string&)> log, std::string& error);
+    bool enabled() const { return impl_ != nullptr; }
+
+    /// The longest stored prefix of `prompt` (live tokens or a checkpoint, with the same pictures and control-vector
+    /// state), at most prompt.size() - 1 tokens.  Also matches a conversation still waiting to be written.
+    Match best(const std::vector<int32_t>& prompt, const std::vector<ConversationImageKey>& images, bool cvec) const;
+
+    /// Reads the whole conversation of `m` back.  `limits` bounds every count and size before it is allocated and
+    /// `limits.admit` is asked for the RAM first.  One whose write has not finished comes back from RAM (a copy; one not
+    /// yet started is taken back for good).  A part that fails its hash deletes the conversation; false with `error` then.
+    bool load(const Match& m, SavedConversation& out, const SessionReadLimits& limits, std::string& error);
+
+    /// Queues `image` for the writer thread, which owns it from here: nothing is copied.  Keeps the root checkpoint and
+    /// the deepest few, drops the stored copies it supersedes once it is complete.  False (image not consumed) when it is
+    /// too short to be worth a write, cannot be stored, or the queued images would pass `queue_cap` bytes.  The most
+    /// recently queued is written first.
+    bool put(SavedConversation&& image, uint64_t queue_cap);
+
+    /// The engine is ending: writes what is queued without waiting for it to be idle, until `deadline`; what is not
+    /// written by then is dropped (a write cut short leaves nothing a restore would read).  How many were written.
+    size_t finish(std::chrono::steady_clock::time_point deadline);
+
+    Stats stats() const;
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+
+} // namespace strata::core
