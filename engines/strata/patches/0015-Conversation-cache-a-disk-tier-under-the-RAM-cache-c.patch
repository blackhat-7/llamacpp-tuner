+};
+}
+
+int main(int argc, char** argv) {
+    const std::string base = argc > 1 ? argv[1] : "/tmp";
+    std::string tmpl = base + "/disk_test_XXXXXX";
+    check(::mkdtemp(tmpl.data()) != nullptr, "temporary folder");
+    const std::string root = tmpl;
+    auto clean = [&] { fs::remove_all(root); };
+    SessionReadLimits open_limits;
+
+    {   // a conversation goes to disk and comes back byte for byte
+        const std::string dir = root + "/a";
+        SavedConversation a = make(20000, {1024, 12000, 16000, 19000, 19500}, 0, true);
+        const SavedConversation original = copy_of(a);
+        const auto p = prompt_of(a);
+        SavedConversation expect = copy_of(original);
+        expect.checkpoints.erase(expect.checkpoints.begin() + 1);   // root + the deepest 3 are kept
+        std::string err;
+        {
+        Store st;
+        check(st.open(dir), "open an empty folder");
+        check(st.disk.best(p, a.live.imgs, true).tokens == 0, "nothing stored yet");
+        check(!st.disk.put(make(8000, {}), 1ull << 30), "a conversation under 8192 tokens is not written");
+        check(st.disk.put(std::move(a), 1ull << 30), "put");
+        const auto pending = st.disk.best(p, original.live.imgs, true);
+        check(pending.tokens == 20000, "a queued conversation already matches");
+        st.disk.finish(far());
+        check(!st.lines.empty() && st.lines.back().find("wrote 20000 tokens") != std::string::npos, "the writer logs");
+        auto m = st.disk.best(p, original.live.imgs, true);
+        check(m.tokens == 20000 && m.bytes > 0, "the stored conversation matches its own tokens");
+        check(st.disk.best(p, original.live.imgs, false).tokens == 0, "a conversation of the other control-vector state does not match");
+        check(st.disk.best(p, {}, true).tokens == 0, "pictures decide: a prompt without the stored image does not match");
+        auto diverged = original.live.ids;
+        diverged.resize(17000);
+        diverged.push_back(-5);
+        check(st.disk.best(diverged, original.live.imgs, true).tokens == 16000, "a prompt that diverges later matches the checkpoint before it");
+        check(st.disk.best(original.live.ids, original.live.imgs, true).tokens == 19500, "the whole prompt is never matched: one token starts the window");
+        SavedConversation back;
+        check(st.disk.load(m, back, open_limits, err), "load");
+        check(same(back, expect), "the loaded conversation equals the original (root and deepest 3 checkpoints)");
+        check(back.checkpoints.size() == 4, "four checkpoints");
+        check(st.disk.stats().conversations == 1, "one conversation");
+        }
+        // a stray temporary file and an orphan blob disappear at open; a restart finds the conversation
+        { std::ofstream(dir + "/tmp-0123456789abcdef") << "partial"; }
+        fs::copy_file(files(dir, "k-")[0], dir + "/k-00000000000000ff-" + fs::path(files(dir, "k-")[0]).filename().string().substr(19));
+        Store again;
+        check(again.open(dir), "reopen after a restart");
+        check(files(dir, "tmp-").empty(), "a leftover temporary file is removed");
+        check(files(dir, "k-00000000000000ff").empty(), "a blob no manifest names is removed");
+        auto m2 = again.disk.best(p, original.live.imgs, true);
+        SavedConversation back2;
+        check(m2.tokens == 20000 && again.disk.load(m2, back2, open_limits, err) && same(back2, expect), "restored after a restart, byte for byte");
+    }
+
+    {   // a longer conversation writes only what is new and replaces the shorter one
+        const std::string dir = root + "/b";
+        Store st;
+        check(st.open(dir), "open");
+        SavedConversation a = make(20000, {1024, 19000});
+        SavedConversation b = make(23000, {1024, 19000, 22000});
+        check(std::equal(a.live.ids.begin(), a.live.ids.end(), b.live.ids.begin()), "b extends a");
+        const SavedConversation b_original = copy_of(b);
+        st.disk.put(std::move(a), 1ull << 30);
+        st.disk.finish(far());
+        const auto first = st.disk.stats();
+        st.disk.put(std::move(b), 1ull << 30);
+        st.disk.finish(far());
+        const auto second = st.disk.stats();
+        check(second.conversations == 1, "the shorter copy is superseded");
+        check(second.written_bytes - first.written_bytes < first.written_bytes / 2, "the second write is mostly shared with the first");
+        std::fprintf(stderr, "dedup: first write %llu bytes, second %llu bytes, folder %llu\n",
+                     (unsigned long long) first.written_bytes, (unsigned long long) (second.written_bytes - first.written_bytes),
+                     (unsigned long long) folder_bytes(dir));
+        SavedConversation back;
+        std::string err;
+        auto m = st.disk.best(prompt_of(b_original), {}, true);
+        check(m.tokens == 23000 && st.disk.load(m, back, open_limits, err) && same(back, b_original), "the longer one loads exactly");
+        // writing the same conversation again changes nothing on disk but its manifest
+        SavedConversation again = copy_of(b_original);
+        const auto before = st.disk.stats().written_bytes;
+        st.disk.put(std::move(again), 1ull << 30);
+        st.disk.finish(far());
+        check(st.disk.stats().conversations == 1 && st.disk.stats().written_bytes - before < 100000, "the same conversation again rewrites nothing big");
+    }
+
+    {   // a part that fails its hash drops the conversation; a crash leaves nothing restorable
+        const std::string dir = root + "/c";
+        Store st;
+        check(st.open(dir), "open");
+        SavedConversation a = make(20000, {1024, 19000});
+        const auto p = prompt_of(a);
+        st.disk.put(std::move(a), 1ull << 30);
+        st.disk.finish(far());
+        auto ks = files(dir, "k-");
+        check(ks.size() > 3, "several K/V blocks");
+        {
+            std::fstream f(ks[2], std::ios::in | std::ios::out | std::ios::binary);
+            f.seekp(5000);
+            char c = 0x5a;
+            f.write(&c, 1);
+        }
+        auto m = st.disk.best(p, {}, true);
+        SavedConversation back;
+        std::string err;
+        check(m.tokens == 20000 && !st.disk.load(m, back, open_limits, err), "a flipped byte is detected");
+        check(st.disk.best(p, {}, true).tokens == 0 && st.disk.stats().conversations == 0, "the conversation is gone");
+        check(files(dir, "c-").empty() && !fs::exists(ks[2]), "its manifest and the bad blob are deleted");
+    }
+    {
+        const std::string dir = root + "/d";
+        {
+            Store st;
+            check(st.open(dir), "open");
+            st.disk.put(make(20000, {1024, 19000}), 1ull << 30);
+            st.disk.finish(far());
+        }
+        auto cs = files(dir, "c-");
+        check(cs.size() == 1, "one manifest");
+        fs::resize_file(cs[0], fs::file_size(cs[0]) - 9);   // a torn manifest
+        {
+            Store st;
+            check(st.open(dir), "reopen with a torn manifest");
+            check(st.disk.stats().conversations == 0 && files(dir, "c-").empty() && files(dir, "k-").empty() && files(dir, "s-").empty(),
+                  "a torn manifest is deleted with the blobs only it named");
+            st.disk.put(make(20000, {1024, 19000}), 1ull << 30);
+            st.disk.finish(far());
+        }
+        fs::remove(files(dir, "s-")[0]);
+        Store third;
+        check(third.open(dir) && third.disk.stats().conversations == 0, "a manifest whose blob is missing is deleted at open");
+    }
+
+    {   // the folder keeps to its budget, least recently used first; another engine's conversations are never restored
+        const std::string dir = root + "/e";
+        SavedConversation a = make(16000, {1024}, 0), b = make(16000, {1024}, 11), c = make(16000, {1024}, 23);
+        const auto pa = prompt_of(a), pb = prompt_of(b), pc = prompt_of(c);
+        Store probe;
+        check(probe.open(root + "/probe"), "probe");
+        probe.disk.put(copy_of(a), 1ull << 30);
+        probe.disk.finish(far());
+        const uint64_t one = probe.disk.stats().disk_bytes;
+        {
+        Store st;
+        check(st.open(dir, 1, one * 5 / 2), "open with room for two");
+        st.disk.put(std::move(a), 1ull << 30);
+        st.disk.put(std::move(b), 1ull << 30);
+        st.disk.finish(far());
+        check(st.disk.stats().conversations == 2, "two fit");
+        SavedConversation back;
+        std::string err;
+        check(st.disk.load(st.disk.best(pa, {}, true), back, open_limits, err), "restoring a refreshes it");
+        st.disk.put(std::move(c), 1ull << 30);
+        st.disk.finish(far());
+        check(st.disk.stats().conversations == 2 && st.disk.best(pb, {}, true).tokens == 0, "b, the least recently used, went");
+        check(st.disk.best(pa, {}, true).tokens == 16000 && st.disk.best(pc, {}, true).tokens == 16000, "a and c stay");
+        check(folder_bytes(dir) <= one * 5 / 2 + 4096, "the folder is within the budget");
+        }
+        // the budget is the whole folder: one conversation that cannot fit is not written
+        Store tiny;
+        check(tiny.open(root + "/tiny", 1, one / 4), "tiny budget");
+        tiny.disk.put(make(16000, {1024}), 1ull << 30);
+        tiny.disk.finish(far());
+        check(tiny.disk.stats().conversations == 0 && !tiny.lines.empty() && tiny.lines.back().find("not written") != std::string::npos,
+              "a conversation larger than the budget is refused, logged");
+        // another identity's conversation stays in the folder, counts against the budget and is not matched
+        Store other;
+        check(other.open(dir, 99, one * 5 / 2), "open with another identity");
+        check(other.disk.best(pa, {}, true).tokens == 0 && other.disk.stats().conversations == 2, "the others are kept, not matched");
+    }
+
+    {   // the writer waits for the engine: nothing is written during a request or within a second of one; a
+        // conversation still waiting for its write, or in the middle of it, comes back from RAM; the queue is bounded
+        const std::string dir = root + "/f";
+        Store st;
+        check(st.open(dir), "open");
+        busy(true);   // a request is running
+        SavedConversation a = make(200000, {1024}), b = make(16000, {1024}, 5), c = make(16000, {1024}, 9);
+        const auto original = copy_of(a), original_b = copy_of(b);
+        const uint64_t cap = a.bytes() + b.bytes() + 100;
+        check(st.disk.put(std::move(b), cap), "fits the queue");
+        check(st.disk.put(std::move(a), cap), "a second fits too");
+        check(!st.disk.put(std::move(c), cap), "a third does not fit the queue cap");
+        std::this_thread::sleep_for(std::chrono::milliseconds(1500));
+        check(files(dir, "k-").empty() && files(dir, "s-").empty() && files(dir, "tmp-").empty() &&
+              st.disk.stats().written == 0, "nothing is written while the engine is busy");
+        SavedConversation back_b;
+        std::string err;
+        auto mb = st.disk.best(prompt_of(original_b), {}, true);
+        check(mb.tokens == 16000 && st.disk.load(mb, back_b, open_limits, err) && same(back_b, original_b),
+              "a load of a queued one takes the image back");
+        check(st.disk.best(prompt_of(original_b), {}, true).tokens == 0, "and it is gone from the store");
+        // the request ends: a second later the writer starts; the next request stops it half way
+        const auto idle_at = std::chrono::steady_clock::now();
+        busy(false);
+        while (files(dir, "k-").size() < 2 && std::chrono::steady_clock::now() - idle_at < std::chrono::seconds(30))
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        busy(true);
+        const double started = std::chrono::duration<double>(std::chrono::steady_clock::now() - idle_at).count();
+        std::fprintf(stderr, "idle gate: the writer had 2 K/V blobs out %.3f s after the request ended\n", started);
+        check(started >= 0.9, "the writer waits for a second of idle (from its last look at the engine)");
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        const size_t blobs = files(dir, "k-").size() + files(dir, "s-").size();
+        std::this_thread::sleep_for(std::chrono::milliseconds(500));
+        check(files(dir, "k-").size() + files(dir, "s-").size() == blobs && files(dir, "c-").empty() &&
+              st.disk.stats().written == 0, "a request pauses the write half way");
+        SavedConversation back;
+        auto m = st.disk.best(prompt_of(original), {}, true);
+        check(m.tokens == 200000 && st.disk.load(m, back, open_limits, err) && same(back, original),
+              "a load of the one being written copies it from RAM");
+        busy(false);
+        st.disk.finish(far());
+        check(st.disk.stats().written == 1 && st.disk.best(prompt_of(original), {}, true).tokens == 200000, "it lands on disk");
+    }
+
+    {   // the end: finish writes what is queued at once, busy engine or not; past its deadline the rest is dropped and
+        // nothing half written stays
+        const std::string dir = root + "/i";
+        {
+            Store st;
+            check(st.open(dir), "open");
+            busy(true);
+            st.disk.put(make(16000, {1024}), 1ull << 30);
+            check(st.disk.finish(far()) == 1, "finish writes the queued one at once");
+            st.disk.put(make(200000, {1024}, 3), 1ull << 30);
+            check(st.disk.finish(std::chrono::steady_clock::now()) == 0, "a deadline that has passed writes nothing more");
+        }
+        busy(false);
+        const uint64_t left = folder_bytes(dir);
+        check(files(dir, "tmp-").empty(), "no temporary file is left");
+        Store again;
+        check(again.open(dir) && again.disk.stats().conversations == 1 && again.disk.stats().disk_bytes == left,
+              "after a restart only the finished one is there, and the cut write left no blob behind");
+    }
+
+    {   // limits are applied before anything is allocated
+        const std::string dir = root + "/g";
+        Store st;
+        check(st.open(dir), "open");
+        SavedConversation a = make(16000, {1024});
+        const auto p = prompt_of(a);
+        const auto geometry = a.geometry;
+        st.disk.put(std::move(a), 1ull << 30);
+        st.disk.finish(far());
+        SavedConversation back;
+        std::string err;
+        SessionReadLimits l;
+        l.max_tokens = 15000;
+        check(!st.disk.load(st.disk.best(p, {}, true), back, l, err) && err.find("limits") != std::string::npos, "too many tokens");
+        l = {};
+        auto other = geometry;
+        other[0] += 1;
+        l.geometry = other;
+        check(!st.disk.load(st.disk.best(p, {}, true), back, l, err), "another geometry");
+        l = {};
+        l.max_kv_bytes = {{1, 1, 1, 1, 1}};
+        check(!st.disk.load(st.disk.best(p, {}, true), back, l, err), "a K/V part over the limit");
+        l = {};
+        l.admit = [](uint64_t, std::string& why) { why = "no RAM"; return false; };
+        check(!st.disk.load(st.disk.best(p, {}, true), back, l, err) && err.find("no RAM") != std::string::npos, "the RAM check");
+        check(st.disk.stats().conversations == 1, "a refusal by limits keeps the conversation");
+    }
+
+    {   // speed of the store itself on this folder: write, hash, read
+        const std::string dir = root + "/h";
+        Store st;
+        check(st.open(dir), "open");
+        SavedConversation a = make(200000, {1024, 150000, 199000});   // ~100 MB of K/V at this toy geometry
+        const auto p = prompt_of(a);
+        const uint64_t bytes = a.bytes();
+        const auto t0 = std::chrono::steady_clock::now();
+        st.disk.put(std::move(a), ~0ull);
+        st.disk.finish(far());
+        const double w = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+        SavedConversation back;
+        std::string err;
+        const auto t1 = std::chrono::steady_clock::now();
+        check(st.disk.load(st.disk.best(p, {}, true), back, open_limits, err), "load the big one");
+        const double r = std::chrono::duration<double>(std::chrono::steady_clock::now() - t1).count();
+        std::fprintf(stderr, "speed: %.0f MiB image: write+hash %.2f s (%.0f MiB/s), read+hash+copy %.2f s (%.0f MiB/s)\n",
+                     (double) bytes / 1048576.0, w, (double) bytes / 1048576.0 / w, r, (double) bytes / 1048576.0 / r);
+    }
+
+    clean();
+    std::printf("conversation_disk_test: %d checks passed\n", checks);
+    return 0;
+}
