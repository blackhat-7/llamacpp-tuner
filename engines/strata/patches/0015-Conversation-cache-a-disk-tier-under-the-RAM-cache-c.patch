@@ -0,0 +1,1014 @@
+#include "strata/core/conversation_disk.hpp"
+
+#include "strata/core/progress.hpp"
+#include "strata/platform/aux_cpus.hpp"
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <future>
+#include <map>
+#include <mutex>
+#include <random>
+#include <set>
+#include <thread>
+
+#if !defined(_WIN32)
+#include <dirent.h>
+#include <fcntl.h>
+#include <sched.h>
+#include <sys/file.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+namespace strata::core {
+
+#if defined(_WIN32)
+// POSIX direct I/O and flock only; the Windows build has no disk tier.
+struct ConversationDisk::Impl {};
+ConversationDisk::ConversationDisk() = default;
+ConversationDisk::~ConversationDisk() = default;
+bool ConversationDisk::open(const std::string&, const SessionFileIdentity&, uint64_t, uint64_t,
+                            std::function<void(const std::string&)>, std::string& error) {
+    error = "the conversation disk tier is not supported on Windows";
+    return false;
+}
+ConversationDisk::Match ConversationDisk::best(const std::vector<int32_t>&, const std::vector<ConversationImageKey>&,
+                                               bool) const { return {}; }
+bool ConversationDisk::load(const Match&, SavedConversation&, const SessionReadLimits&, std::string&) { return false; }
+bool ConversationDisk::put(SavedConversation&&, uint64_t) { return false; }
+size_t ConversationDisk::finish(std::chrono::steady_clock::time_point) { return 0; }
+ConversationDisk::Stats ConversationDisk::stats() const { return {}; }
+#else
+
+namespace {
+
+static_assert(std::endian::native == std::endian::little, "the disk tier format is little-endian");
+using Clock = std::chrono::steady_clock;
+
+constexpr char kMagic[8] = {'S', 'T', 'R', 'D', 'S', 'K', '\0', '\2'};
+// A K/V block covers this many tokens of every layer.  A multiple of the K/V page and of the indexer's block (4 cells
+// each), so the bytes of a full block never change when the conversation grows; only the last, partial one does.
+constexpr int64_t kBlockTokens = 2048;
+constexpr int64_t kIndexBlock = 4;   // cells per pooled indexer row (qsa_real_shapes().idx_block)
+// Besides the root (the end of the system prompt) the deepest checkpoints a conversation keeps on disk: the next turn
+// resumes from one of them.
+constexpr size_t kKeepCheckpoints = 3;
+constexpr size_t kPage = 4096;       // O_DIRECT alignment, and every file's header
+constexpr size_t kChunk = 1u << 20;  // one write request: a request that comes in waits for at most one
+constexpr uint64_t kMaxManifest = 64ull << 20;
+constexpr uint64_t kSeed = 0x5354524453ull;
+// The writer goes on only once the engine has been idle this long, and looks this often while it waits.
+constexpr auto kIdle = std::chrono::seconds(1);
+constexpr auto kPoll = std::chrono::milliseconds(20);
+
+size_t round_up(size_t n) { return (n + kPage - 1) / kPage * kPage; }
+
+// ---- the layout: how a conversation's K/V maps onto blocks
+struct Layer {
+    int64_t format = 0, cells = 0, heads = 0, head_dim = 0, page_size = 0, pooled_rows = 0, idx_dim = 0;
+    std::array<uint64_t, 5> sizes{};   // k, v, k_scale, v_scale, pooled
+};
+
+// The bytes of part `p` that fall in one block; 0 for an empty part.  Parts 0-3 hold the same number of bytes for
+// every cell, the pooled part one row per kIndexBlock cells.  False when the part does not divide evenly.
+bool chunk_bytes(const Layer& l, size_t p, uint64_t& out) {
+    out = 0;
+    if (!l.sizes[p]) return true;
+    const int64_t units = p == 4 ? l.pooled_rows : l.cells;
+    if (units <= 0 || l.sizes[p] % (uint64_t) units) return false;
+    out = l.sizes[p] / (uint64_t) units * (uint64_t) (p == 4 ? kBlockTokens / kIndexBlock : kBlockTokens);
+    return true;
+}
+
+struct Slice {
+    size_t layer, part;
+    uint64_t at, n, to;   // bytes [at, at + n) of the part go to offset `to` of the block
+};
+
+// The slices of block `j`, in layer then part order; the block's size.
+uint64_t block_slices(const std::vector<Layer>& layers, uint64_t j, std::vector<Slice>& out) {
+    out.clear();
+    uint64_t to = 0;
+    for (size_t li = 0; li < layers.size(); ++li)
+        for (size_t p = 0; p < 5; ++p) {
+            uint64_t c = 0;
+            chunk_bytes(layers[li], p, c);
+            if (!c || j * c >= layers[li].sizes[p]) continue;
+            const uint64_t n = std::min(c, layers[li].sizes[p] - j * c);
+            out.push_back({li, p, j * c, n, to});
+            to += n;
+        }
+    return to;
+}
+
+uint64_t block_count(const std::vector<Layer>& layers) {
+    uint64_t n = 0;
+    for (const auto& l : layers)
+        for (size_t p = 0; p < 5; ++p) {
+            uint64_t c = 0;
+            chunk_bytes(l, p, c);
+            if (c) n = std::max(n, (l.sizes[p] + c - 1) / c);
+        }
+    return n;
+}
+
+template<class Kv> auto parts_of(Kv& k) { return std::array{&k.k, &k.v, &k.k_scale, &k.v_scale, &k.pooled}; }
+template<class C> auto state_of(C& c) { return std::array{&c.gdn, &c.ple, &c.tails, &c.dead, &c.block_pos}; }
+
+// ---- the manifest
+struct StateRef {
+    uint64_t hash = 0;
+    std::array<uint64_t, 5> sizes{};   // gdn, ple, tails, dead, block_pos
+    uint64_t bytes() const { return sizes[0] + sizes[1] + sizes[2] + sizes[3] + sizes[4]; }
+};
+struct Point {   // the live state, or a checkpoint: a prefix of the live tokens
+    uint64_t len = 0, used = 0;
+    StateRef state;
+};
+struct Manifest {
+    SessionFileIdentity id;
+    bool cvec = true;
+    decltype(SavedConversation::geometry) geometry{};
+    int64_t layer_lo = 0, layer_hi = 0;
+    std::vector<int32_t> ids;
+    std::vector<ConversationImageKey> imgs;
+    Point live;
+    std::vector<Point> checks;
+    std::vector<Layer> layers;
+    struct Block { uint64_t hash = 0, bytes = 0; };
+    std::vector<Block> blocks;
+};
+
+// One field list for both directions: Out appends every field, In reads them back (a count is checked against the
+// bytes left before its array is allocated).
+struct Out {
+    std::vector<uint8_t> b;
+    bool ok = true;
+    void raw(const void* p, size_t n) { b.insert(b.end(), static_cast<const uint8_t*>(p), static_cast<const uint8_t*>(p) + n); }
+    template<class T> void count(std::vector<T>& v, size_t) { const uint64_t n = v.size(); raw(&n, 8); }
+};
+struct In {
+    const uint8_t* p;
+    size_t left;
+    bool ok = true;
+    void raw(void* dst, size_t n) {
+        if (!ok || n > left) { ok = false; return; }
+        std::memcpy(dst, p, n);
+        p += n;
+        left -= n;
+    }
+    template<class T> void count(std::vector<T>& v, size_t each) {   // `each`: the fewest bytes one element takes
+        uint64_t n = 0;
+        raw(&n, 8);
+        if (!ok || n > left / each) { ok = false; return; }
+        v.resize((size_t) n);
+    }
+};
+
+template<class A> void fields(A& a, Manifest& m) {
+    uint64_t cvec = m.cvec ? 1 : 0;
+    a.raw(&m.id.model, 8); a.raw(&m.id.config, 8); a.raw(&cvec, 8);
+    a.raw(m.geometry.data(), sizeof m.geometry); a.raw(&m.layer_lo, 8); a.raw(&m.layer_hi, 8);
+    a.count(m.ids, 4);
+    if (a.ok) a.raw(m.ids.data(), m.ids.size() * 4);
+    a.count(m.imgs, 16);
+    for (auto& k : m.imgs) { a.raw(&k.start, 8); a.raw(&k.hash, 8); }
+    auto point = [&](Point& pt) { a.raw(&pt.len, 8); a.raw(&pt.used, 8); a.raw(&pt.state.hash, 8); a.raw(pt.state.sizes.data(), 40); };
+    point(m.live);
+    a.count(m.checks, 64);
+    for (auto& c : m.checks) point(c);
+    a.count(m.layers, 96);
+    for (auto& l : m.layers) {
+        for (int64_t* v : {&l.format, &l.cells, &l.heads, &l.head_dim, &l.page_size, &l.pooled_rows, &l.idx_dim}) a.raw(v, 8);
+        a.raw(l.sizes.data(), 40);
+    }
+    a.count(m.blocks, 16);
+    for (auto& b : m.blocks) { a.raw(&b.hash, 8); a.raw(&b.bytes, 8); }
+    if (cvec > 1) a.ok = false;
+    m.cvec = cvec == 1;
+}
+
+// The payload, and the structure the rest of the code relies on.
+bool decode(const uint8_t* p, size_t n, Manifest& m) {
+    In r{p, n};
+    fields(r, m);
+    if (!r.ok || r.left != 0 || m.live.len != m.ids.size()) return false;
+    for (const auto& c : m.checks)
+        if (c.len == 0 || c.len > m.ids.size()) return false;
+    for (const auto& l : m.layers)
+        for (size_t q = 0; q < 5; ++q) {
+            uint64_t c = 0;
+            if (!chunk_bytes(l, q, c)) return false;
+        }
+    if (m.blocks.size() != block_count(m.layers)) return false;
+    std::vector<Slice> slices;
+    for (uint64_t j = 0; j < m.blocks.size(); ++j)
+        if (block_slices(m.layers, j, slices) != m.blocks[j].bytes) return false;
+    return true;
+}
+
+std::string blob_name(char kind, uint64_t hash, uint64_t bytes) {
+    char b[48];
+    std::snprintf(b, sizeof b, "%c-%016llx-%llx", kind, (unsigned long long) hash, (unsigned long long) bytes);
+    return b;
+}
+
+// Every blob the manifest names, without repeats.
+std::vector<std::string> blobs_of(const Manifest& m) {
+    std::set<std::string> names;
+    names.insert(blob_name('s', m.live.state.hash, m.live.state.bytes()));
+    for (const auto& c : m.checks) names.insert(blob_name('s', c.state.hash, c.state.bytes()));
+    for (const auto& b : m.blocks) names.insert(blob_name('k', b.hash, b.bytes));
+    return {names.begin(), names.end()};
+}
+
+std::vector<ConversationImageKey> imgs_below(const std::vector<ConversationImageKey>& all, uint64_t tokens) {
+    std::vector<ConversationImageKey> out;
+    for (const auto& k : all)
+        if ((uint64_t) k.start < tokens) out.push_back(k);
+    return out;
+}
+
+// Whether a prompt's pictures that start before token `n` are exactly the stored ones that do.
+bool images_agree(const std::vector<ConversationImageKey>& stored, const std::vector<ConversationImageKey>& req,
+                  uint64_t n) {
+    size_t j = 0;
+    for (const auto& k : req) {
+        if ((uint64_t) k.start >= n) continue;
+        if (j == stored.size() || !(stored[j++] == k)) return false;
+    }
+    return j == stored.size() || (uint64_t) stored[j].start >= n;
+}
+
+// The checkpoints a conversation can keep on disk: a chain of prefixes of the live tokens, no stage parts.
+bool checkpoints_storable(const SavedConversation& s) {
+    for (const auto& c : s.checkpoints)
+        if (!c.stage_parts.empty() || c.ids.empty() || c.ids.size() > s.live.ids.size() ||
+            !std::equal(c.ids.begin(), c.ids.end(), s.live.ids.begin()) || c.imgs != imgs_below(s.live.imgs, c.ids.size()))
+            return false;
+    return true;
+}
+
+// `neu` holds everything `old` does apart from the tail that the client rewrote: the same conversation a turn back
+// (conversation_cache.hpp, drop_superseded).
+bool superseded(const Manifest& old, const Manifest& neu) {
+    if (old.id.model != neu.id.model || old.id.config != neu.id.config || old.cvec != neu.cvec) return false;
+    if (old.ids == neu.ids && old.imgs == neu.imgs) return true;
+    uint64_t deepest = 0;
+    for (const auto& c : old.checks) deepest = std::max(deepest, c.len);
+    if (!deepest || deepest > neu.ids.size() || !std::equal(old.ids.begin(), old.ids.begin() + (std::ptrdiff_t) deepest, neu.ids.begin()))
+        return false;
+    bool held = deepest == neu.ids.size();
+    for (const auto& c : neu.checks) held = held || c.len == deepest;
+    return held && imgs_below(old.imgs, deepest) == imgs_below(neu.imgs, deepest);
+}
+
+// ---- files
+class AlignedBuf {
+public:
+    AlignedBuf() = default;
+    AlignedBuf(const AlignedBuf&) = delete;
+    AlignedBuf& operator=(const AlignedBuf&) = delete;
+    ~AlignedBuf() { std::free(p_); }
+    // at least n bytes, rounded up to kPage, kPage-aligned, contents unspecified
+    uint8_t* get(size_t n) {
+        n = round_up(n);
+        if (n > cap_) {
+            std::free(p_);
+            cap_ = 0;
+            p_ = static_cast<uint8_t*>(std::aligned_alloc(kPage, n));
+            if (!p_) throw std::bad_alloc();
+            cap_ = n;
+        }
+        return p_;
+    }
+private:
+    uint8_t* p_ = nullptr;
+    size_t cap_ = 0;
+};
+
+struct Header {   // the first kPage bytes of every file
+    char magic[8];
+    uint64_t hash, bytes, check;   // the payload's hash and size; the hash of the fields before `check`
+};
+
+// O_DIRECT keeps the model files' pages in the page cache and avoids a write-back burst later; a filesystem that
+// refuses it (tmpfs) gets buffered I/O.
+int open_direct(const std::string& path, int flags, bool& direct) {
+    int fd = ::open(path.c_str(), flags | O_DIRECT | O_CLOEXEC, 0600);
+    direct = fd >= 0;
+    if (fd < 0 && errno == EINVAL) fd = ::open(path.c_str(), flags | O_CLOEXEC, 0600);
+    return fd;
+}
+
+void sync_dir(const std::string& dir) {
+    const int fd = ::open(dir.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (fd >= 0) { ::fsync(fd); ::close(fd); }
+}
+
+uint64_t random64() {
+    static std::mt19937_64 g{std::random_device{}()};
+    static std::mutex m;
+    std::lock_guard<std::mutex> lk(m);
+    return g();
+}
+
+// Writes the payload at buf + kPage (`bytes` of it, of hash `hash`; buf holds round_up(kPage + bytes)) as dir/name:
+// under a temporary name first, flushed, then renamed, so the name never refers to a partial file.  `go` is asked
+// before each write request; false gives up.
+bool write_file(const std::string& dir, const std::string& name, uint8_t* buf, uint64_t hash, uint64_t bytes,
+                const std::function<bool()>& go, std::string& err) {
+    Header h{};
+    std::memcpy(h.magic, kMagic, 8);
+    h.hash = hash;
+    h.bytes = bytes;
+    h.check = session_hash64(&h, offsetof(Header, check), kSeed);
+    const size_t total = kPage + (size_t) bytes, padded = round_up(total);
+    std::memset(buf, 0, kPage);
+    std::memcpy(buf, &h, sizeof h);
+    std::memset(buf + total, 0, padded - total);
+    char tmp[32];
+    std::snprintf(tmp, sizeof tmp, "/tmp-%016llx", (unsigned long long) random64());
+    const std::string tmp_path = dir + tmp;
+    bool direct = false;
+    const int fd = open_direct(tmp_path, O_WRONLY | O_CREAT | O_EXCL, direct);
+    if (fd < 0) { err = "create " + tmp_path + ": " + std::strerror(errno); return false; }
+    std::string why;
+    for (size_t at = 0; at < padded && why.empty();) {
+        const ssize_t w = go() ? ::pwrite(fd, buf + at, std::min(kChunk, padded - at), (off_t) at) : 0;
+        if (w < 0 && errno == EINTR) continue;
+        if (w <= 0) why = w == 0 ? "stopped" : std::strerror(errno);
+        else at += (size_t) w;
+    }
+    if (why.empty() && ::ftruncate(fd, (off_t) total) != 0) why = std::strerror(errno);
+    if (why.empty() && ::fdatasync(fd) != 0) why = std::strerror(errno);
+    if (!direct) ::posix_fadvise(fd, 0, 0, POSIX_FADV_DONTNEED);
+    ::close(fd);
+    if (why.empty() && ::rename(tmp_path.c_str(), (dir + "/" + name).c_str()) != 0) why = std::strerror(errno);
+    if (!why.empty()) {
+        err = "write " + name + ": " + why;
+        ::unlink(tmp_path.c_str());
+    }
+    return why.empty();
+}
+
+// Reads a file of at most `max_bytes` into buf and checks its header, size and payload hash.  The payload is at
+// buf + kPage, h.bytes long.
+bool read_file(const std::string& path, uint64_t max_bytes, AlignedBuf& buf, Header& h, std::string& err) {
+    bool direct = false;
+    const int fd = open_direct(path, O_RDONLY, direct);
+    if (fd < 0) { err = "open " + path + ": " + std::strerror(errno); return false; }
+    struct stat st;
+    bool ok = ::fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && (uint64_t) st.st_size >= kPage &&
+              (uint64_t) st.st_size <= max_bytes;
+    const size_t size = ok ? (size_t) st.st_size : 0;
+    uint8_t* p = ok ? buf.get(size) : nullptr;
+    for (size_t at = 0; ok && at < size;) {
+        const ssize_t r = ::pread(fd, p + at, std::min<size_t>(8u << 20, round_up(size - at)), (off_t) at);
+        if (r < 0 && errno == EINTR) continue;
+        ok = r > 0;
+        if (ok) at += (size_t) r;
+    }
+    if (!direct) ::posix_fadvise(fd, 0, 0, POSIX_FADV_DONTNEED);
+    ::close(fd);
+    if (ok) std::memcpy(&h, p, sizeof h);
+    if (!ok || std::memcmp(h.magic, kMagic, 8) || h.check != session_hash64(&h, offsetof(Header, check), kSeed) ||
+        kPage + h.bytes != size || session_hash64(p + kPage, (size_t) h.bytes, kSeed) != h.hash) {
+        err = path + ": unreadable or damaged";
+        return false;
+    }
+    return true;
+}
+
+// A stored conversation is bound to this build too, the binary and its STRATA_* settings: another may compute other
+// bits from the same tokens, or lay them out otherwise, and then "restored" would no longer mean "never left".
+uint64_t build_hash() {
+    SessionHasher h(kSeed);
+    std::ifstream f("/proc/self/exe", std::ios::binary);
+    std::vector<char> b(1 << 20);
+    while (f.read(b.data(), (std::streamsize) b.size()) || f.gcount() > 0) h.update(b.data(), (size_t) f.gcount());
+    std::vector<std::string> env;
+    for (char** e = environ; *e; ++e)
+        if (std::strncmp(*e, "STRATA_", 7) == 0) env.emplace_back(*e);
+    std::sort(env.begin(), env.end());
+    for (const auto& s : env) h.update(s.c_str(), s.size() + 1);
+    return h.digest();
+}
+
+// A thread the engine's host thread starts inherits its one CPU (strata/platform/aux_cpus.hpp), where it would take
+// turns with the host: spread out first.
+void leave_host_cpu() {
+    cpu_set_t all;
+    CPU_ZERO(&all);
+    for (int c = 0; c < CPU_SETSIZE; ++c) CPU_SET(c, &all);
+    (void) sched_setaffinity(0, sizeof all, &all);
+    strata::aux_cpus::pin_current_thread();
+}
+
+} // namespace
+
+// ---- the store
+struct ConversationDisk::Impl {
+    struct Part { uint64_t bytes = 0; int refs = 0; };
+    struct Entry {
+        enum State { queued, writing, ready } state = ready;
+        uint64_t used = 0, file_bytes = 0, ram = 0;   // file_bytes: the manifest's; ram: the queued image's
+        std::string name;
+        Manifest m;
+        std::shared_ptr<SavedConversation> image;   // until it is written; the writer and a load only read it
+    };
+    struct Done {
+        std::string name;
+        uint64_t file_bytes = 0, new_bytes = 0;
+        size_t new_blobs = 0, shared_blobs = 0;
+        double waited = 0;   // seconds the job stood still for the engine
+    };
+
+    std::string dir;
+    SessionFileIdentity id;
+    uint64_t budget = 0, min_free = 0;
+    std::function<void(const std::string&)> log;
+    int lock_fd = -1;
+    mutable std::mutex mu;
+    std::condition_variable cv;
+    std::map<uint64_t, Entry> entries;
+    std::map<std::string, Part> parts;
+    std::vector<uint64_t> queue;   // the last one first
+    uint64_t next_id = 1, clock = 0, used_bytes = 0, queued_bytes = 0;
+    bool stop = false, working = false, urgent = false;
+    Stats stats;
+    // the writer's own: its buffer, and the engine's heartbeat count it saw last and since when
+    AlignedBuf wbuf;
+    uint64_t beats = 0;
+    Clock::time_point quiet{};
+    std::thread writer;
+
+    ~Impl() {
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            stop = true;
+        }
+        cv.notify_all();
+        if (writer.joinable()) writer.join();
+        if (lock_fd >= 0) ::close(lock_fd);
+    }
+    std::string path(const std::string& name) const { return dir + "/" + name; }
+
+    // ---- bookkeeping, mu held
+    void release_locked(const std::vector<std::string>& names) {
+        for (const auto& n : names) {
+            auto it = parts.find(n);
+            if (it == parts.end() || --it->second.refs > 0) continue;
+            ::unlink(path(n).c_str());
+            used_bytes -= it->second.bytes;
+            parts.erase(it);
+        }
+    }
+    void drop_locked(uint64_t eid) {
+        auto it = entries.find(eid);
+        ::unlink(path(it->second.name).c_str());
+        used_bytes -= it->second.file_bytes;
+        release_locked(blobs_of(it->second.m));
+        entries.erase(it);
+        ++stats.dropped;
+    }
+    // A blob that failed its check: gone, and so is every conversation that needs it.
+    void drop_blob_locked(const std::string& name) {
+        std::vector<uint64_t> users;
+        for (auto& [eid, e] : entries) {
+            const auto names = blobs_of(e.m);
+            if (e.state == Entry::ready && std::find(names.begin(), names.end(), name) != names.end()) users.push_back(eid);
+        }
+        for (uint64_t eid : users) drop_locked(eid);
+        if (auto it = parts.find(name); it != parts.end()) {   // a job still holds it: the file goes all the same
+            ::unlink(path(name).c_str());
+            used_bytes -= it->second.bytes;
+            parts.erase(it);
+        }
+    }
+    bool evict_lru_locked() {
+        uint64_t victim = 0, oldest = UINT64_MAX;
+        for (auto& [eid, e] : entries)
+            if (e.state == Entry::ready && e.used < oldest) { oldest = e.used; victim = eid; }
+        if (!victim) return false;
+        drop_locked(victim);
+        return true;
+    }
+
+    // ---- open
+    bool scan(std::string& error) {
+        DIR* d = ::opendir(dir.c_str());
+        if (!d) { error = "cannot list " + dir + ": " + std::strerror(errno); return false; }
+        std::vector<std::string> manifests;
+        while (const dirent* e = ::readdir(d)) {
+            const std::string n = e->d_name;
+            if (n.rfind("tmp-", 0) == 0) {
+                ::unlink(path(n).c_str());   // a write that did not finish
+            } else if (n.size() > 2 && (n[0] == 'k' || n[0] == 's') && n[1] == '-') {
+                // the name carries the payload size: a file of another size is partial or foreign
+                const size_t dash = n.find('-', 2);
+                const uint64_t want = dash == std::string::npos ? 0 : kPage + std::strtoull(n.c_str() + dash + 1, nullptr, 16);
+                struct stat st;
+                if (::stat(path(n).c_str(), &st) == 0 && (uint64_t) st.st_size == want) parts[n].bytes = want;
+                else ::unlink(path(n).c_str());
+            } else if (n.rfind("c-", 0) == 0) {
+                manifests.push_back(n);
+            }
+        }
+        ::closedir(d);
+        struct Found { std::string name; int64_t mtime = 0; uint64_t size = 0; Manifest m; };
+        std::vector<Found> found;
+        AlignedBuf buf;
+        for (const auto& n : manifests) {
+            Found f;
+            f.name = n;
+            Header h;
+            std::string err;
+            struct stat st;
+            bool whole = ::stat(path(n).c_str(), &st) == 0 && read_file(path(n), kMaxManifest, buf, h, err) &&
+                         decode(buf.get(0) + kPage, (size_t) h.bytes, f.m);
+            for (const auto& b : whole ? blobs_of(f.m) : std::vector<std::string>{}) whole = whole && parts.count(b);
+            if (!whole) { ::unlink(path(n).c_str()); continue; }   // unreadable, or a blob it needs is gone
+            f.size = (uint64_t) st.st_size;
+            f.mtime = (int64_t) st.st_mtim.tv_sec * 1000000000 + st.st_mtim.tv_nsec;
+            found.push_back(std::move(f));
+        }
+        std::sort(found.begin(), found.end(), [](const Found& a, const Found& b) { return a.mtime < b.mtime; });
+        for (auto& f : found) {
+            Entry e;
+            e.used = ++clock;
+            e.name = f.name;
+            e.file_bytes = f.size;
+            e.m = std::move(f.m);
+            for (const auto& b : blobs_of(e.m)) ++parts[b].refs;
+            used_bytes += f.size;
+            entries.emplace(next_id++, std::move(e));
+        }
+        for (auto it = parts.begin(); it != parts.end();) {   // what no conversation names: a crash between its writes
+            if (it->second.refs == 0) { ::unlink(path(it->first).c_str()); it = parts.erase(it); }
+            else { used_bytes += it->second.bytes; ++it; }
+        }
+        while (used_bytes > budget && evict_lru_locked()) {}
+        return true;
+    }
+
+    // ---- the writer
+    // Whether the engine has been idle for kIdle: no request in flight and no heartbeat (a token, a prompt chunk, a
+    // batch window) since.  Writer thread, mu held.
+    bool engine_idle() {
+        Progress& p = progress();
+        const uint64_t b = p.beats.load(std::memory_order_relaxed);
+        const auto now = Clock::now();
+        if (p.busy.load(std::memory_order_relaxed) || b != beats) {
+            beats = b;
+            quiet = now;
+            return false;
+        }
+        return now - quiet >= kIdle;
+    }
+    // Waits until the writer may go on: the engine idle, or ending.  False when the store closes.
+    bool wait_turn(std::unique_lock<std::mutex>& lk, double* waited = nullptr) {
+        const auto t0 = Clock::now();
+        while (!stop && !urgent && !engine_idle()) cv.wait_for(lk, kPoll);
+        if (waited) *waited += std::chrono::duration<double>(Clock::now() - t0).count();
+        return !stop;
+    }
+
+    void run() {
+        leave_host_cpu();
+        ::setpriority(PRIO_PROCESS, (id_t) ::syscall(SYS_gettid), 19);   // hashing must not take a decode thread's core
+        std::unique_lock<std::mutex> lk(mu);
+        for (;;) {
+            cv.wait(lk, [&] { return stop || !queue.empty(); });
+            if (!wait_turn(lk)) return;
+            if (queue.empty()) continue;   // a load took it back meanwhile
+            const uint64_t eid = queue.back();
+            queue.pop_back();
+            Entry& e = entries.at(eid);
+            e.state = Entry::writing;
+            working = true;
+            std::shared_ptr<SavedConversation> image = e.image;
+            Manifest m = e.m;   // the tokens; job() adds the layout and the hashes
+            lk.unlock();
+            const auto t0 = Clock::now();
+            std::vector<std::string> held;
+            Done done;
+            std::string err;
+            bool ok = false;
+            try {
+                ok = job(*image, m, held, done, err);
+            } catch (const std::exception& x) {
+                err = x.what();
+            }
+            const size_t tokens = image->live.ids.size();
+            image.reset();
+            lk.lock();
+            queued_bytes -= e.ram;   // the image counts against the queue cap until it is gone from RAM
+            std::string line;
+            if (!ok) {
+                release_locked(held);
+                entries.erase(eid);
+                line = "disk tier: not written (" + std::to_string(tokens) + " tokens): " + err;
+            } else {
+                e.m = std::move(m);
+                e.name = done.name;
+                e.file_bytes = done.file_bytes;
+                e.used = ++clock;
+                e.state = Entry::ready;
+                e.image.reset();
+                used_bytes += done.file_bytes;
+                std::vector<uint64_t> old;
+                for (const auto& [oid, o] : entries)
+                    if (oid != eid && o.state == Entry::ready && superseded(o.m, e.m)) old.push_back(oid);
+                for (uint64_t oid : old) drop_locked(oid);
+                ++stats.written;
+                stats.written_bytes += done.new_bytes;
+                char b[320];
+                std::snprintf(b, sizeof b, "disk tier: wrote %zu tokens: %zu new and %zu shared blobs, %.0f MiB new, in "
+                              "%.1f s (%.1f s of it waiting for the engine to be idle); %zu stored, %.1f of %.1f GiB",
+                              tokens, done.new_blobs, done.shared_blobs, (double) done.new_bytes / 1048576.0,
+                              std::chrono::duration<double>(Clock::now() - t0).count(), done.waited, entries.size(),
+                              (double) used_bytes / 1073741824.0, (double) budget / 1073741824.0);
+                line = b;
+            }
+            working = false;
+            cv.notify_all();
+            if (log) {
+                lk.unlock();
+                log(line);
+                lk.lock();
+            }
+        }
+    }
+
+    // Writes the blobs of `img` the folder lacks, each as soon as it is hashed, then the manifest.  `held` ends up with
+    // a reference on every blob the manifest names, whether or not it failed half way.
+    bool job(const SavedConversation& img, Manifest& m, std::vector<std::string>& held, Done& done, std::string& err) {
+        m.geometry = img.geometry;
+        m.layer_lo = img.layer_lo;
+        m.layer_hi = img.layer_hi;
+        for (const auto& k : img.kv) {
+            Layer l{k.format, k.cells, k.heads, k.head_dim, k.page_size, k.pooled_rows, k.idx_dim, {}};
+            const auto p = parts_of(k);
+            for (size_t q = 0; q < 5; ++q) {
+                l.sizes[q] = p[q]->size();
+                uint64_t c = 0;
+                if (!chunk_bytes(l, q, c)) { err = "a K/V part does not divide into cells"; return false; }
+            }
+            m.layers.push_back(l);
+        }
+        m.blocks.resize(block_count(m.layers));
+        std::vector<Slice> slices;
+        uint64_t whole = 0;   // what the conversation's blobs take at most, shared ones included (the manifest is small)
+        auto state_sizes = [&](const ConversationCheckpoint& c, Point& pt) {
+            const auto v = state_of(c);
+            for (size_t q = 0; q < 5; ++q) pt.state.sizes[q] = v[q]->size();
+            whole += kPage + pt.state.bytes();
+        };
+        state_sizes(img.live, m.live);
+        for (size_t i = 0; i < img.checkpoints.size(); ++i) state_sizes(img.checkpoints[i], m.checks[i]);
+        for (uint64_t j = 0; j < m.blocks.size(); ++j) whole += kPage + (m.blocks[j].bytes = block_slices(m.layers, j, slices));
+        if (whole > budget) { err = "larger than the disk budget"; return false; }
+
+        const std::function<bool()> go = [&] {
+            std::unique_lock<std::mutex> lk(mu);
+            return wait_turn(lk, &done.waited);
+        };
+        std::set<std::string> seen;
+        // One blob: `gather` fills the payload; written unless the folder has it already.
+        auto blob = [&](char kind, uint64_t bytes, uint64_t& hash, const auto& gather) {
+            if (!go()) { err = "stopped"; return false; }
+            uint8_t* p = wbuf.get(kPage + (size_t) bytes);
+            if (!gather(p + kPage)) { err = "a K/V part is shorter than its layout"; return false; }
+            hash = session_hash64(p + kPage, (size_t) bytes, kSeed);
+            const std::string name = blob_name(kind, hash, bytes);
+            if (!seen.insert(name).second) return true;
+            {
+                std::lock_guard<std::mutex> lk(mu);
+                if (auto it = parts.find(name); it != parts.end()) {
+                    ++it->second.refs;
+                    held.push_back(name);
+                    ++done.shared_blobs;
+                    return true;
+                }
+                while (used_bytes + kPage + bytes > budget)
+                    if (!evict_lru_locked()) { err = "no room in the disk budget"; return false; }
+                struct statvfs sv;
+                if (::statvfs(dir.c_str(), &sv) != 0 || (uint64_t) sv.f_bavail * sv.f_frsize < kPage + bytes + min_free) {
+                    err = "the volume has less than " + std::to_string((kPage + bytes + min_free) >> 20) + " MiB free";
+                    return false;
+                }
+                used_bytes += kPage + bytes;   // taken now, so an eviction for another blob counts it
+            }
+            const bool wrote = write_file(dir, name, p, hash, bytes, go, err);
+            std::lock_guard<std::mutex> lk(mu);
+            if (!wrote) { used_bytes -= kPage + bytes; return false; }
+            parts[name] = {kPage + bytes, 1};
+            held.push_back(name);
+            ++done.new_blobs;
+            done.new_bytes += kPage + bytes;
+            return true;
+        };
+        auto state = [&](const ConversationCheckpoint& c, Point& pt) {
+            return blob('s', pt.state.bytes(), pt.state.hash, [&](uint8_t* dst) {
+                for (const auto* v : state_of(c))
+                    if (!v->empty()) { std::memcpy(dst, v->data(), v->size()); dst += v->size(); }
+                return true;
+            });
+        };
+        if (!state(img.live, m.live)) return false;
+        for (size_t i = 0; i < img.checkpoints.size(); ++i)
+            if (!state(img.checkpoints[i], m.checks[i])) return false;
+        for (uint64_t j = 0; j < m.blocks.size(); ++j) {
+            block_slices(m.layers, j, slices);
+            if (!blob('k', m.blocks[j].bytes, m.blocks[j].hash, [&](uint8_t* dst) {
+                    for (const auto& s : slices)
+                        if (!parts_of(img.kv[s.layer])[s.part]->read(dst + s.to, (size_t) s.at, (size_t) s.n)) return false;
+                    return true;
+                }))
+                return false;
+        }
+        // the manifest last, once every blob it names is in the folder for good
+        Out w;
+        fields(w, m);
+        uint8_t* p = wbuf.get(kPage + w.b.size());
+        std::memcpy(p + kPage, w.b.data(), w.b.size());
+        char name[40];
+        std::snprintf(name, sizeof name, "c-%016llx.chat", (unsigned long long) random64());
+        sync_dir(dir);
+        if (!write_file(dir, name, p, session_hash64(w.b.data(), w.b.size(), kSeed), w.b.size(), go, err)) return false;
+        sync_dir(dir);
+        done.name = name;
+        done.file_bytes = kPage + w.b.size();
+        return true;
+    }
+};
+
+ConversationDisk::ConversationDisk() = default;
+ConversationDisk::~ConversationDisk() = default;
+
+bool ConversationDisk::open(const std::string& dir, const SessionFileIdentity& id, uint64_t budget_bytes,
+                            uint64_t min_free_bytes, std::function<void(const std::string&)> log, std::string& error) {
+    if (impl_) { error = "already open"; return false; }
+    auto d = std::make_unique<Impl>();
+    d->dir = dir;
+    while (d->dir.size() > 1 && d->dir.back() == '/') d->dir.pop_back();
+    d->id = id;
+    const uint64_t build = build_hash();
+    d->id.config = session_hash64(&build, sizeof build, id.config);
+    d->budget = budget_bytes;
+    d->min_free = min_free_bytes;
+    d->log = std::move(log);
+    std::error_code ec;
+    std::filesystem::create_directories(std::filesystem::path(d->dir).parent_path(), ec);
+    if (::mkdir(d->dir.c_str(), 0700) != 0 && errno != EEXIST) {
+        error = "cannot create " + d->dir + ": " + std::strerror(errno);
+        return false;
+    }
+    d->lock_fd = ::open(d->path(".lock").c_str(), O_RDWR | O_CREAT | O_CLOEXEC, 0600);
+    if (d->lock_fd < 0 || ::flock(d->lock_fd, LOCK_EX | LOCK_NB) != 0) {
+        error = d->dir + " is in use by another engine, or cannot be locked";
+        return false;
+    }
+    if (!d->scan(error)) return false;
+    Impl* raw = d.get();
+    d->writer = std::thread([raw] { raw->run(); });
+    impl_ = std::move(d);
+    return true;
+}
+
+ConversationDisk::Match ConversationDisk::best(const std::vector<int32_t>& prompt,
+                                               const std::vector<ConversationImageKey>& images, bool cvec) const {
+    Impl& d = *impl_;
+    std::lock_guard<std::mutex> lk(d.mu);
+    Match best;
+    uint64_t best_used = 0;
+    for (const auto& [eid, e] : d.entries) {
+        const Manifest& m = e.m;
+        if (m.id.model != d.id.model || m.id.config != d.id.config || m.cvec != cvec) continue;
+        const uint64_t common = (uint64_t) (std::mismatch(m.ids.begin(), m.ids.end(), prompt.begin(), prompt.end()).first -
+                                            m.ids.begin());
+        auto consider = [&](uint64_t n) {
+            // the last prompt token always starts the next verify window
+            if (!n || n > common || n >= prompt.size() || !images_agree(m.imgs, images, n)) return;
+            if ((int64_t) n > best.tokens || ((int64_t) n == best.tokens && e.used > best_used)) {
+                best.id = eid;
+                best.tokens = (int64_t) n;
+                best_used = e.used;
+            }
+        };
+        consider(m.ids.size());
+        for (const auto& c : m.checks) consider(c.len);
+    }
+    if (best.tokens) {   // the RAM load() allocates: the image (and two blocks being read, for one on disk)
+        const Impl::Entry& e = d.entries.at(best.id);
+        if (e.state != Impl::Entry::ready) {
+            best.bytes = e.ram;
+        } else {
+            uint64_t n = e.m.ids.size() * 4 + e.m.live.state.bytes(), block = 0;
+            for (const auto& b : e.m.blocks) block = std::max(block, b.bytes);
+            for (const auto& l : e.m.layers) for (uint64_t s : l.sizes) n += s;
+            for (const auto& c : e.m.checks) n += c.state.bytes();
+            best.bytes = n + 2 * (block + kPage) + (64u << 20);
+        }
+    }
+    return best;
+}
+
+bool ConversationDisk::load(const Match& match, SavedConversation& out, const SessionReadLimits& limits,
+                            std::string& error) {
+    Impl& d = *impl_;
+    std::unique_lock<std::mutex> lk(d.mu);
+    auto it = d.entries.find(match.id);
+    if (it == d.entries.end()) { error = "the stored conversation is gone"; return false; }
+    Impl::Entry& e = it->second;
+    auto fail = [&](const std::string& why) { error = "disk tier: " + why; return false; };
+    if (e.state == Impl::Entry::queued) {   // the write has not started: the image comes back, no reason to wait
+        out = std::move(*e.image);
+        d.queue.erase(std::find(d.queue.begin(), d.queue.end(), it->first));
+        d.queued_bytes -= e.ram;
+        d.entries.erase(it);
+        return true;
+    }
+    std::string why;
+    if (limits.admit && !limits.admit(match.bytes, why)) return fail(why);
+    if (e.state == Impl::Entry::writing) {   // a copy: the writer is reading it
+        out = *e.image;
+        return true;
+    }
+    const Manifest& m = e.m;
+
+    // what this engine can restore, before anything is allocated
+    if (limits.geometry && *limits.geometry != m.geometry) return fail("saved with another model geometry");
+    if (limits.layer_range && (limits.layer_range->first != m.layer_lo || limits.layer_range->second != m.layer_hi))
+        return fail("saved with another layer range");
+    if (m.ids.size() > limits.max_tokens || m.checks.size() > limits.max_checkpoints ||
+        m.layers.size() > limits.max_kv_layers)
+        return fail("over this engine's limits");
+    auto state_fits = [&](const StateRef& r) {
+        for (size_t q = 0; q < 5; ++q)
+            if (r.sizes[q] > limits.max_state_bytes[q]) return false;
+        return true;
+    };
+    bool fits = state_fits(m.live.state);
+    for (const auto& c : m.checks) fits = fits && state_fits(c.state);
+    for (size_t li = 0; li < m.layers.size() && li < limits.max_kv_bytes.size(); ++li)
+        for (size_t q = 0; q < 5; ++q) fits = fits && m.layers[li].sizes[q] <= limits.max_kv_bytes[li][q];
+    if (!fits) return fail("a part is larger than this engine's");
+
+    SavedConversation r;
+    r.geometry = m.geometry;
+    r.layer_lo = m.layer_lo;
+    r.layer_hi = m.layer_hi;
+    r.cvec = m.cvec;
+    r.live.ids = m.ids;
+    r.live.imgs = m.imgs;
+    r.live.used = m.live.used;
+    for (const auto& c : m.checks) {
+        ConversationCheckpoint k;
+        k.ids.assign(m.ids.begin(), m.ids.begin() + (std::ptrdiff_t) c.len);
+        k.imgs = imgs_below(m.imgs, c.len);
+        k.used = c.used;
+        r.checkpoints.push_back(std::move(k));
+    }
+    for (const auto& l : m.layers) {
+        ConversationKv k;
+        k.format = (int) l.format; k.cells = l.cells; k.heads = l.heads; k.head_dim = l.head_dim;
+        k.page_size = l.page_size; k.pooled_rows = l.pooled_rows; k.idx_dim = l.idx_dim;
+        const auto p = parts_of(k);
+        for (size_t q = 0; q < 5; ++q) p[q]->resize((size_t) l.sizes[q]);
+        r.kv.push_back(std::move(k));
+    }
+
+    // Reads blob `name` into buf, checked against what the manifest says it is.
+    AlignedBuf bufs[2];
+    auto read_blob = [&](const std::string& name, uint64_t hash, uint64_t bytes, AlignedBuf& buf, std::string& err) {
+        Header h;
+        if (!read_file(d.path(name), kPage + bytes, buf, h, err)) return false;
+        if (h.hash == hash && h.bytes == bytes) return true;
+        err = name + ": not the blob its name says";
+        return false;
+    };
+    uint64_t read = 0;
+    std::string err;
+    auto bad = [&](const std::string& name) {
+        error = "disk tier: " + err;
+        d.drop_blob_locked(name);   // `m` and `e` are gone from here on
+        return false;
+    };
+    for (size_t i = 0; i <= m.checks.size(); ++i) {   // the running states: live, then each checkpoint
+        const StateRef& s = i == 0 ? m.live.state : m.checks[i - 1].state;
+        const std::string name = blob_name('s', s.hash, s.bytes());
+        if (!read_blob(name, s.hash, s.bytes(), bufs[0], err)) return bad(name);
+        read += kPage + s.bytes();
+        const uint8_t* p = bufs[0].get(0) + kPage;
+        const auto v = state_of(i == 0 ? r.live : r.checkpoints[i - 1]);
+        for (size_t q = 0; q < 5; ++q) {
+            v[q]->assign(p, p + s.sizes[q]);
+            p += s.sizes[q];
+        }
+    }
+    // the K/V: the next block is read and hashed on another thread while this one is copied out
+    std::vector<Slice> slices;
+    std::string errs[2];
+    auto fetch = [&](uint64_t j) {
+        return std::async(std::launch::async, [&, j] {
+            leave_host_cpu();
+            return read_blob(blob_name('k', m.blocks[j].hash, m.blocks[j].bytes), m.blocks[j].hash, m.blocks[j].bytes,
+                             bufs[j & 1], errs[j & 1]);
+        });
+    };
+    std::future<bool> next;
+    if (!m.blocks.empty()) next = fetch(0);
+    for (uint64_t j = 0; j < m.blocks.size(); ++j) {
+        if (!next.get()) {
+            err = errs[j & 1];
+            return bad(blob_name('k', m.blocks[j].hash, m.blocks[j].bytes));
+        }
+        if (j + 1 < m.blocks.size()) next = fetch(j + 1);
+        block_slices(m.layers, j, slices);
+        const uint8_t* src = bufs[j & 1].get(0) + kPage;
+        for (const auto& s : slices)
+            parts_of(r.kv[s.layer])[s.part]->visit((size_t) s.at, (size_t) s.n, [&](uint8_t* p, size_t n, size_t at) {
+                std::memcpy(p, src + s.to + (at - (size_t) s.at), n);
+                return true;
+            });
+        read += kPage + m.blocks[j].bytes;
+    }
+    e.used = ++d.clock;
+    ::utimensat(AT_FDCWD, d.path(e.name).c_str(), nullptr, 0);   // recency survives a restart
+    ++d.stats.restored;
+    d.stats.read_bytes += read;
+    out = std::move(r);
+    return true;
+}
+
+bool ConversationDisk::put(SavedConversation&& image, uint64_t queue_cap) {
+    Impl& d = *impl_;
+    if (image.live.ids.size() < min_tokens || !image.stage_images.empty() || !image.live.stage_parts.empty() ||
+        !checkpoints_storable(image))
+        return false;
+    const uint64_t ram = image.bytes();
+    std::lock_guard<std::mutex> lk(d.mu);
+    if (d.queued_bytes + ram > queue_cap) return false;
+    // a background copy may still be filling it (STRATA_PARK_ASYNC, STRATA_PARK_VRAM_MIB): it lands here, as it would
+    // if the image were dropped
+    image.pending.reset();
+    image.live_pending.reset();
+    for (auto& k : image.kv) k.pending.reset();
+    auto& cs = image.checkpoints;   // the root and the deepest few
+    std::stable_sort(cs.begin(), cs.end(), [](const auto& a, const auto& b) { return a.ids.size() < b.ids.size(); });
+    if (cs.size() > 1 + kKeepCheckpoints) cs.erase(cs.begin() + 1, cs.end() - (std::ptrdiff_t) kKeepCheckpoints);
+    Impl::Entry e;
+    e.state = Impl::Entry::queued;
+    e.ram = ram;
+    e.m.id = d.id;
+    e.m.cvec = image.cvec;
+    e.m.ids = image.live.ids;
+    e.m.imgs = image.live.imgs;
+    e.m.live = {image.live.ids.size(), image.live.used, {}};
+    for (const auto& c : cs) e.m.checks.push_back({c.ids.size(), c.used, {}});
+    e.image = std::make_shared<SavedConversation>(std::move(image));
+    d.queued_bytes += ram;
+    d.queue.push_back(d.next_id);
+    d.entries.emplace(d.next_id++, std::move(e));
+    d.cv.notify_all();
+    return true;
+}
+
+size_t ConversationDisk::finish(std::chrono::steady_clock::time_point deadline) {
+    Impl& d = *impl_;
+    std::unique_lock<std::mutex> lk(d.mu);
+    const size_t before = d.stats.written;
+    d.urgent = true;
+    d.cv.notify_all();
+    if (!d.cv.wait_until(lk, deadline, [&] { return d.queue.empty() && !d.working; })) {
+        d.stop = true;   // the job in hand gives up at its next write; its blobs go with it
+        d.cv.notify_all();
+    }
+    return d.stats.written - before;
+}
+
+ConversationDisk::Stats ConversationDisk::stats() const {
+    Impl& d = *impl_;
+    std::lock_guard<std::mutex> lk(d.mu);
+    Stats s = d.stats;
+    s.conversations = d.entries.size();
+    s.disk_bytes = d.used_bytes;
+    return s;
+}
