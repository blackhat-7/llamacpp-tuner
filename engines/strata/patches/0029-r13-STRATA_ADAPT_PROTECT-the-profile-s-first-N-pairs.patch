+__global__ void spin_delay_kernel(unsigned long long us) {
+#if defined(STRATA_USE_HIP)
+    const unsigned long long t0 = wall_clock64(), n = us * 100;   // gfx11: a 100 MHz constant clock
+    while (wall_clock64() - t0 < n) {}
+#else
+    unsigned long long t0, t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t0));
+    do { asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t)); } while (t - t0 < us * 1000);
+#endif
+}
+void spin_delay(int us, void* stream) { spin_delay_kernel<<<1, 1, 0, (cudaStream_t) stream>>>((unsigned long long) us); }
+
 void wait_flag_ge(const uint32_t* flag, uint32_t value, void* stream) {
     wait_flag_ge_kernel<<<1, 1, 0, (cudaStream_t) stream>>>(flag, value);
     check("wait_flag_ge");
