diff --git a/tools/mtp_q2b.py b/tools/mtp_q2b.py
new file mode 100644
index 000000000..7a1d1eeeb
--- /dev/null
+++ b/tools/mtp_q2b.py
@@ -0,0 +1,153 @@
+"""tools/mtp_q2b.py - the MTP draft layer's routed experts as experts.bin (Q2_0 blobs) with a closer Q2_0 rounding.
+
+mtp_pack.py picks each 64-weight block's scale d in [0.5, 1.0] * amax with d > 0 (relative RMS error ~0.42 on these
+experts). The Q2_0 grid {-1, 0, 1, 2} * d is asymmetric, so a NEGATIVE d puts the 2x level on the negative tail, and
+scales below amax / 2 clip the extreme weight but fit the bulk better. This searches both signs over f in
+[0.15, 1.0] * amax, then refines d by least squares for the chosen codes (two Lloyd steps), always against the stored
+fp16 scale: relative RMS error ~0.355, the same format and size. Drafts only: verification decides every token.
+
+    python tools/mtp_q2b.py --tensors <Strata-data>/mtp/tensors --out <Strata-data>/mtp/rt-q2b
+    python tools/mtp_q2b.py --tensors ... --check <Strata-data>/mtp/rt/experts.bin   (layout + error report)
+
+--tensors is the BF16 directory tools/mtp_fetch.py writes. The output directory takes dense.bin, dense.txt and
+draft_vocab.bin from an existing rt directory (copy or link them); only experts.bin is written here.
+"""
+from __future__ import annotations
+
+import argparse
+import os
+from multiprocessing import Pool
+from pathlib import Path
+
+import numpy as np
+
+H, FF, NE = 2560, 640, 512
+BLOB = 3 * (H * FF * 18 // 64)
+GU = DN = None   # BF16 memmaps, opened per process by _open
+
+
+def _open(tensors: str) -> None:
+    global GU, DN
+    t = Path(tensors)
+    GU = np.memmap(t / "mtp.layers.0.mlp.experts.gate_up_proj.bin", dtype="<u2", mode="r", shape=(NE, 2 * FF, H))
+    DN = np.memmap(t / "mtp.layers.0.mlp.experts.down_proj.bin", dtype="<u2", mode="r", shape=(NE, H, FF))
+
+
+def f32(u: np.ndarray) -> np.ndarray:
+    return (np.asarray(u).astype(np.uint32) << 16).view(np.float32)
+
+
+def quant(x: np.ndarray, fs=np.linspace(0.15, 1.0, 35, dtype=np.float32), lloyd: int = 2):
+    """x: (n, 64) float32 -> (d16 (n,) float16, codes (n, 64) uint8 0..3)"""
+    amax = np.abs(x).max(axis=1, keepdims=True)
+    best = np.full((x.shape[0], 1), np.inf, dtype=np.float32)
+    bd = np.zeros_like(amax)
+    for sgn in (1.0, -1.0):
+        for f in fs:
+            d = (amax * (f * sgn)).astype(np.float16).astype(np.float32)
+            inv = np.where(d != 0, 1.0 / np.where(d != 0, d, 1.0), 0.0)
+            q = np.clip(np.rint(x * inv), -1, 2)
+            err = ((q * d - x) ** 2).sum(axis=1, keepdims=True)
+            m = err < best
+            best = np.where(m, err, best)
+            bd = np.where(m, d, bd)
+    for _ in range(lloyd):
+        inv = np.where(bd != 0, 1.0 / np.where(bd != 0, bd, 1.0), 0.0)
+        q = np.clip(np.rint(x * inv), -1, 2)
+        qq = (q * q).sum(axis=1, keepdims=True)
+        dn = np.where(qq > 0, (q * x).sum(axis=1, keepdims=True) / np.where(qq > 0, qq, 1.0), bd)
+        dn = dn.astype(np.float16).astype(np.float32)
+        inv = np.where(dn != 0, 1.0 / np.where(dn != 0, dn, 1.0), 0.0)
+        q2 = np.clip(np.rint(x * inv), -1, 2)
+        err = ((q2 * dn - x) ** 2).sum(axis=1, keepdims=True)
+        m = err < best
+        best = np.where(m, err, best)
+        bd = np.where(m, dn, bd)
+    d16 = bd.astype(np.float16)
+    d = d16.astype(np.float32)
+    inv = np.where(d != 0, 1.0 / np.where(d != 0, d, 1.0), 0.0)
+    codes = (np.clip(np.rint(x * inv), -1, 2) + 1).astype(np.uint8)
+    return d16.reshape(-1), codes
+
+
+def rows_q2(w: np.ndarray) -> np.ndarray:
+    """(rows, n) float32 -> (rows, n // 64, 18) uint8 Q2_0 blocks (fp16 d, then 16 bytes of codes, LSB first)"""
+    r, n = w.shape
+    d16, codes = quant(w.reshape(-1, 64))
+    c = codes.reshape(-1, 16, 4)
+    packed = (c[:, :, 0] | (c[:, :, 1] << 2) | (c[:, :, 2] << 4) | (c[:, :, 3] << 6)).astype(np.uint8)
+    out = np.empty((r * n // 64, 18), dtype=np.uint8)
+    out[:, :2] = d16.view(np.uint8).reshape(-1, 2)
+    out[:, 2:] = packed
+    return out.reshape(r, n // 64, 18)
+
+
+def blob_of(gub: np.ndarray, dnb: np.ndarray) -> bytes:
+    """mtp_rt.blob_of on block arrays: gate rows 0..639 / up rows 640..1279 interleaved, codes then scales"""
+    inter = np.empty_like(gub)
+    inter[0::2] = gub[:FF]
+    inter[1::2] = gub[FF:]
+    out = b"".join([inter[:, :, 2:].tobytes(), dnb[:, :, 2:].tobytes(), inter[:, :, :2].tobytes(), dnb[:, :, :2].tobytes()])
+    assert len(out) == BLOB
+    return out
+
+
+def unblob(b: bytes):
+    """BLOB bytes -> (gate_up (1280, 2560), down (2560, 640)) float32"""
+    b = np.frombuffer(b, dtype=np.uint8)
+    ngu, nd = 2 * FF * (H // 64), H * (FF // 64)
+    cg = b[:ngu * 16].reshape(2 * FF, H // 64, 16)
+    cd = b[ngu * 16: ngu * 16 + nd * 16].reshape(H, FF // 64, 16)
+    o = ngu * 16 + nd * 16
+    sg = b[o: o + ngu * 2].copy().view(np.float16).astype(np.float32).reshape(2 * FF, H // 64, 1)
+    sd = b[o + ngu * 2: o + ngu * 2 + nd * 2].copy().view(np.float16).astype(np.float32).reshape(H, FF // 64, 1)
+
+    def dec(c, s):
+        codes = np.stack([(c >> k) & 3 for k in (0, 2, 4, 6)], axis=3).reshape(c.shape[0], c.shape[1], 64)
+        return ((codes.astype(np.float32) - 1.0) * s).reshape(c.shape[0], -1)
+
+    inter = dec(cg, sg)
+    gu = np.empty_like(inter)
+    gu[:FF] = inter[0::2]
+    gu[FF:] = inter[1::2]
+    return gu, dec(cd, sd)
+
+
+def rel(a: np.ndarray, b: np.ndarray) -> float:
+    return float(np.sqrt(((a - b) ** 2).sum() / (b ** 2).sum()))
+
+
+def one(e: int) -> bytes:
+    return blob_of(rows_q2(f32(GU[e])), rows_q2(f32(DN[e])))
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--tensors", required=True, help="the BF16 tensor directory from tools/mtp_fetch.py")
+    ap.add_argument("--out", help="directory to write experts.bin into")
+    ap.add_argument("--check", help="an existing experts.bin: compare experts 0, 1, 300 with this rounding")
+    ap.add_argument("--jobs", type=int, default=os.cpu_count() or 4)
+    a = ap.parse_args()
+    _open(a.tensors)
+    if a.check:
+        with open(a.check, "rb") as f:
+            for e in (0, 1, 300):
+                f.seek(e * BLOB)
+                gu, dn = unblob(f.read(BLOB))
+                ngu, ndn = unblob(one(e))
+                print(f"expert {e}: given rel err gate_up {rel(gu, f32(GU[e])):.4f} down {rel(dn, f32(DN[e])):.4f}; "
+                      f"this rounding gate_up {rel(ngu, f32(GU[e])):.4f} down {rel(ndn, f32(DN[e])):.4f}", flush=True)
+        return 0
+    out = Path(a.out)
+    out.mkdir(parents=True, exist_ok=True)
+    with Pool(a.jobs, initializer=_open, initargs=(a.tensors,)) as p, open(out / "experts.bin", "wb") as f:
+        for i, b in enumerate(p.imap(one, range(NE), chunksize=4)):
+            f.write(b)
+            if i % 64 == 0:
+                print("expert", i, flush=True)
+    print("wrote", out / "experts.bin")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
