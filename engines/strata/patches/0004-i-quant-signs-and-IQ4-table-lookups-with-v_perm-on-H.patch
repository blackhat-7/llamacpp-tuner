new file mode 100644
index 000000000..92063eae7
--- /dev/null
+++ b/src/kernels/cuda/iq_signs.cuh
@@ -0,0 +1,58 @@
+// src/kernels/cuda/iq_signs.cuh - the sign step of the i-quant dot products (IQ2_XXS, IQ2_XS, IQ2_S, IQ3_XXS,
+// IQ3_S): codebook bytes negated where their sign bit is set.
+//
+// llama.cpp writes it __vsub4(g ^ m, m) with m = __vcmpne4 of the sign bits, and CUDA keeps that form.  HIP has no
+// byte-SIMD compare or subtract, and hip_compat's emulation of the pair is ~15 VALU operations and a quarter-rate
+// multiply a word on gfx1100, most of the decode expert kernels' VALU time.  On HIP a 24-bit multiply spreads the
+// signs to one selector bit a byte, and v_perm_b32 picks each byte of g or of -g.  -g is computed for all four bytes
+// at once: no codebook byte is 0 (all are 1..62), so 256 - g never borrows from the next byte.  Every word is bit
+// for bit the __vsub4 one (tests/hip/iq_signs.cu checks all codebook words against all sign inputs).
+#pragma once
+
+#include <cstdint>
+
+namespace strata::kernels {
+
+#if defined(__HIPCC__)
+// g with byte k negated where bit k of n is set; n < 128, its bits 4-6 ignored.  The multiply puts copies of n at bit
+// offsets 2, 9, 16 and 23, which do not overlap, and the mask keeps bit k of copy k as bit 2 of selector byte k:
+// selector k picks byte k of g, k + 4 byte k of -g.
+__device__ __forceinline__ int iq_sign4(uint32_t g, uint32_t n) {
+    const uint32_t sel = (__umul24(n, 0x810204u) & 0x04040404u) | 0x03020100u;
+    return (int) __builtin_amdgcn_perm(0x01010100u - g, g, sel);
+}
+#endif
+
+// gx and gy with the signs of the byte s applied, bits 0-3 to gx and 4-7 to gy (IQ2_S, IQ3_S)
+__device__ __forceinline__ void iq_signed8(uint32_t gx, uint32_t gy, uint32_t s, int& qx, int& qy) {
+#if defined(__HIPCC__)
+    qx = iq_sign4(gx, s & 0x0fu);
+    qy = iq_sign4(gy, (s >> 4) & 0x0fu);
+#else
+    const int signs0 = __vcmpne4(((s & 0x03) << 7) | ((s & 0x0C) << 21), 0x00000000);
+    const int signs1 = __vcmpne4(((s & 0x30) << 3) | ((s & 0xC0) << 17), 0x00000000);
+    qx = __vsub4(gx ^ signs0, signs0);
+    qy = __vsub4(gy ^ signs1, signs1);
+#endif
+}
+
+// The same for the 7-bit sign groups of IQ2_XXS, IQ2_XS and IQ3_XXS (bits 0-6 of v, the bits above ignored), the
+// eighth sign the parity of the seven
+__device__ __forceinline__ void iq_ksigned8(uint32_t gx, uint32_t gy, uint32_t v, int& qx, int& qy) {
+#if defined(__HIPCC__)
+    // bit 3 of the high nibble is popc's bit 0: v >> 4 has 3 bits, so the sum does not carry into it
+    v &= 0x7fu;
+    qx = iq_sign4(gx, v);
+    qy = iq_sign4(gy, (v >> 4) + (__popc(v) << 3));
+#else
+    // llama.cpp's unpack_ksigns: bit 7 of the byte replaced by the parity, the byte broadcast
+    const uint8_t v8 = (uint8_t) v;
+    const uint32_t signs = (v8 ^ (__popc(v8) & 1) << 7) * 0x01010101;
+    const int signs0 = __vcmpne4(signs & 0x08040201, 0);
+    const int signs1 = __vcmpne4(signs & 0x80402010, 0);
+    qx = __vsub4(gx ^ signs0, signs0);
+    qy = __vsub4(gy ^ signs1, signs1);
+#endif
+}
+
+}  // namespace strata::kernels
