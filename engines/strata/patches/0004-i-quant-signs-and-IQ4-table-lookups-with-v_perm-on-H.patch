+// The i-quant sign step of the decode kernels (src/kernels/cuda/iq_signs.cuh) against llama.cpp's __vcmpne4 /
+// __vsub4 form, which iq_kernels.cu used before, bit for bit: every 32-bit word of the five codebooks (IQ2_XXS, IQ2_XS,
+// IQ2_S, IQ3_XXS, IQ3_S) with every sign byte, and for the 7-bit sign groups with every 10-bit input (the callers
+// pass the group with the next one's bits above it).  GPU, no model.
+#include "../../src/kernels/cuda/iq_signs.cuh"
+
+#define GGML_COMMON_DECL_CUDA
+#define GGML_COMMON_IMPL_CUDA
+#include "ggml-common.h"
+
+#include <cstdint>
+#include <cstdio>
+
+namespace {
+
+constexpr int kWords = 2 * 256 + 2 * 512 + 2 * 1024 + 256 + 512;
+
+__device__ uint32_t codebook_word(int i) {
+    if (i < 512) return ((const uint32_t*) iq2xxs_grid)[i];
+    if ((i -= 512) < 1024) return ((const uint32_t*) iq2xs_grid)[i];
+    if ((i -= 1024) < 2048) return ((const uint32_t*) iq2s_grid)[i];
+    if ((i -= 2048) < 256) return iq3xxs_grid[i];
+    return iq3s_grid[i - 256];
+}
+
+// iq_kernels.cu before iq_signs.cuh: the 7-bit groups (unpack_ksigns, its argument a uint8_t) and the sign bytes
+__device__ void ref_ksigned8(uint32_t gx, uint32_t gy, uint32_t v, int& qx, int& qy) {
+    const uint8_t v8 = (uint8_t) v;
+    const uint32_t signs = (v8 ^ (__popc(v8) & 1) << 7) * 0x01010101u;
+    const int m0 = __vcmpne4(signs & 0x08040201, 0), m1 = __vcmpne4(signs & 0x80402010, 0);
+    qx = __vsub4(gx ^ m0, m0);
+    qy = __vsub4(gy ^ m1, m1);
+}
+__device__ void ref_signed8(uint32_t gx, uint32_t gy, uint32_t s, int& qx, int& qy) {
+    const int m0 = __vcmpne4(((s & 0x03) << 7) | ((s & 0x0C) << 21), 0x00000000);
+    const int m1 = __vcmpne4(((s & 0x30) << 3) | ((s & 0xC0) << 17), 0x00000000);
+    qx = __vsub4(gx ^ m0, m0);
+    qy = __vsub4(gy ^ m1, m1);
+}
+
+// thread i: word i % kWords as both gx and gy, sign input i / kWords
+__global__ void check_signs(bool ksigns, int n_inputs, unsigned long long* bad) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= kWords * n_inputs) return;
+    const uint32_t g = codebook_word(i % kWords), v = (uint32_t) (i / kWords);
+    int ax, ay, bx, by;
+    if (ksigns) {
+        strata::kernels::iq_ksigned8(g, g, v, ax, ay);
+        ref_ksigned8(g, g, v, bx, by);
+    } else {
+        strata::kernels::iq_signed8(g, g, v, ax, ay);
+        ref_signed8(g, g, v, bx, by);
+    }
+    if (ax != bx || ay != by) atomicAdd(bad, 1ull);
+}
+
+}  // namespace
+
+int main() {
+    unsigned long long* bad = nullptr;
+    if (hipMalloc(&bad, 2 * sizeof(*bad)) != hipSuccess || hipMemset(bad, 0, 2 * sizeof(*bad)) != hipSuccess) {
+        std::fprintf(stderr, "iq_signs: no GPU memory\n");
+        return 2;
+    }
+    const int n_inputs[2] = {256, 1024};   // sign bytes; 7-bit groups with 3 more bits above
+    for (int k = 0; k < 2; ++k)
+        check_signs<<<(kWords * n_inputs[k] + 255) / 256, 256>>>(k == 1, n_inputs[k], bad + k);
+    unsigned long long h[2] = {};
+    if (hipMemcpy(h, bad, sizeof(h), hipMemcpyDeviceToHost) != hipSuccess) {
+        std::fprintf(stderr, "iq_signs: kernel failed\n");
+        return 2;
+    }
+    (void) hipFree(bad);
+    std::printf("iq_signs: sign bytes %llu of %d differ, 7-bit groups %llu of %d differ\n", h[0], kWords * n_inputs[0],
+                h[1], kWords * n_inputs[1]);
+    return h[0] || h[1] ? 1 : 0;
+}
