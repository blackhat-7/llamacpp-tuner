+// include/strata/core/remote_meta.hpp - one layer's group metadata for a helper GPU's grouped experts, as
+// RemoteExperts fills it.  The NVIDIA helper plugin (nv_helper_plugin.cu) reads the same bytes.
+#pragma once
+
+#include "strata/kernels/window_limits.hpp"
+
+#include <cstdint>
+
+namespace strata::core {
+
+inline constexpr int64_t kRemoteCap = strata::kernels::kWindowMaxT * 10;   // a window's rows x top-10
+
+// Small enough to copy as one pinned buffer per layer. The kernels read the
+// individual arrays through pointers into the same device allocation.
+struct RemoteMeta {
+    unsigned long long ptr[kRemoteCap];
+    int32_t start[kRemoteCap + 1];
+    int32_t dst[kRemoteCap];
+    int32_t tok[kRemoteCap];
+    int32_t count;
+};
+
+}  // namespace strata::core
