diff --git a/src/kernels/cuda/wait_prefetch.cuh b/src/kernels/cuda/wait_prefetch.cuh
new file mode 100644
index 000000000..3469386ce
--- /dev/null
+++ b/src/kernels/cuda/wait_prefetch.cuh
@@ -0,0 +1,48 @@
+#pragma once
+// STRATA_WAIT_PF: the prefetch blocks of a GPU wait (WaitPrefetch in verify_kernels.hpp).
+#include "strata/kernels/verify_kernels.hpp"
+
+namespace strata::kernels {
+
+// The waiting thread, once the wait is over (after its fence): the launch's prefetch blocks stop at their next chunk.
+__device__ __forceinline__ void wait_prefetch_release(WaitPrefetch* pf) { atomicAdd(&pf->gen, 1u); }
+
+// One prefetch block (b of nb): reads pf's ranges while the wait lasts.  It reads `gen` before the flag: had the
+// waiting thread bumped `gen` before that read, it had seen the flag up, so this block sees it up too and stops at
+// once; otherwise the bump is still to come and the block sees it within a chunk.  A block never runs past the wait
+// by more than one chunk (blockDim x 8 x 16 bytes).
+__device__ __forceinline__ void wait_prefetch_run(WaitPrefetch* pf, const volatile uint32_t* flag, uint32_t value,
+                                                  int b, int nb) {
+    __shared__ uint32_t s_g0;
+    __shared__ int s_up;
+    const volatile uint32_t* gen = &pf->gen;
+    if (threadIdx.x == 0) {
+        s_g0 = *gen;
+        __threadfence();   // the gen read is done before the flag read
+        s_up = *flag >= value;
+    }
+    __syncthreads();
+    if (s_up) return;
+    const uint32_t g0 = s_g0;
+    constexpr int U = 8;   // 8 independent 16-byte loads in flight per thread
+    const uint64_t bt = blockDim.x;
+    const int n = pf->n;
+    uint32_t acc = 0;
+    for (int k = 0; k < n; ++k) {
+        const uint4* p = (const uint4*) pf->p[k];
+        const uint64_t m = pf->n16[k];
+        for (uint64_t i = (uint64_t) b * bt * U + threadIdx.x; i < m; i += (uint64_t) nb * bt * U) {
+            const uint32_t g = *gen;
+            uint4 v[U];
+#pragma unroll
+            for (int u = 0; u < U; ++u) v[u] = i + u * bt < m ? p[i + u * bt] : make_uint4(0u, 0u, 0u, 0u);
+#pragma unroll
+            for (int u = 0; u < U; ++u) acc ^= v[u].x ^ v[u].y ^ v[u].z ^ v[u].w;
+            if (g != g0) goto done;
+        }
+    }
+done:
+    if (acc == 0x9e3779b9u) pf->sink = acc;
+}
+
+}  // namespace strata::kernels
