    func.call @require(%f32, %error) : (i32, buffer)
    %at64 = index.cast %at : offset to i64
    %at32 = scalar.trunci %at64 : i64 to i32
    view.store %at32, %rec[%i, 2] : i32, view<[%count]x7xi32>
