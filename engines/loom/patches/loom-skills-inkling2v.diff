+    %is1 = index.cmp eq, %ch, %c1 : index
+    %a0 = scalar.constant $A0 : f32
+    %a1 = scalar.constant $A1 : f32
+    %a2 = scalar.constant $A2 : f32
+    %b0 = scalar.constant $B0 : f32
+    %b1 = scalar.constant $B1 : f32
+    %b2 = scalar.constant $B2 : f32
