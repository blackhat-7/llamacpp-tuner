        }
        %sb0_0 = scalar.addf %sq0_0, %b0_0 : f32
        %s0_0 = scf.select %ok0, %sb0_0, %neg_inf : f32
        %sb0_1 = scalar.addf %sq0_1, %b0_1 : f32
        %s0_1 = scf.select %ok1, %sb0_1, %neg_inf : f32
        %bmc0_1 = scalar.maxnumf %s0_0, %s0_1 : f32
        %bm0_c = scalar.maxnumf %bmc0_1, %bmc0_1 : f32
        %bx0_8, %by0_8 = kernel.subgroup.shuffle<xor> %bm0_c, %i8, %i32 : f32, i32, i32
        %bm0_d = scalar.maxnumf %bm0_c, %bx0_8 : f32
        %bx0_16, %by0_16 = kernel.subgroup.shuffle<xor> %bm0_d, %i16, %i32 : f32, i32, i32
        %bm0 = scalar.maxnumf %bm0_d, %bx0_16 : f32
        %mn0 = scalar.maxnumf %m0, %bm0 : f32
        %ms0 = scalar.subf %m0, %mn0 : f32
        %al0 = scalar.expf<afn> %ms0 : f32
        %alv0 = vector.splat %al0 : vector<16xf32>
        %as0 = vector.mulf %a0, %alv0 : vector<16xf32>
        %ls0 = scalar.mulf %l0, %al0 : f32
        %ds0_0 = scalar.subf %s0_0, %mn0 : f32
        %e0_0 = scalar.expf<afn> %ds0_0 : f32
        %ll0_0 = scalar.addf %ls0, %e0_0 : f32
        %ew0_0 = scalar.mulf %e0_0, %vs0 : f32
        %ev0_0 = vector.splat %ew0_0 : vector<16xf32>
        %aa0_0 = vector.fmaf %ev0_0, %v0, %as0 : vector<16xf32>
        %ds0_1 = scalar.subf %s0_1, %mn0 : f32
        %e0_1 = scalar.expf<afn> %ds0_1 : f32
        %ll0_1 = scalar.addf %ll0_0, %e0_1 : f32
        %ew0_1 = scalar.mulf %e0_1, %vs1 : f32
        %ev0_1 = vector.splat %ew0_1 : vector<16xf32>
        %aa0_1 = vector.fmaf %ev0_1, %v1, %aa0_0 : vector<16xf32>
        %sb1_0 = scalar.addf %sq1_0, %b1_0 : f32
        %s1_0 = scf.select %ok0, %sb1_0, %neg_inf : f32
        %sb1_1 = scalar.addf %sq1_1, %b1_1 : f32
        %s1_1 = scf.select %ok1, %sb1_1, %neg_inf : f32
        %bmc1_1 = scalar.maxnumf %s1_0, %s1_1 : f32
        %bm1_c = scalar.maxnumf %bmc1_1, %bmc1_1 : f32
        %bx1_8, %by1_8 = kernel.subgroup.shuffle<xor> %bm1_c, %i8, %i32 : f32, i32, i32
        %bm1_d = scalar.maxnumf %bm1_c, %bx1_8 : f32
        %bx1_16, %by1_16 = kernel.subgroup.shuffle<xor> %bm1_d, %i16, %i32 : f32, i32, i32
        %bm1 = scalar.maxnumf %bm1_d, %bx1_16 : f32
        %mn1 = scalar.maxnumf %m1, %bm1 : f32
        %ms1 = scalar.subf %m1, %mn1 : f32
        %al1 = scalar.expf<afn> %ms1 : f32
        %alv1 = vector.splat %al1 : vector<16xf32>
        %as1 = vector.mulf %a1, %alv1 : vector<16xf32>
        %ls1 = scalar.mulf %l1, %al1 : f32
        %ds1_0 = scalar.subf %s1_0, %mn1 : f32
        %e1_0 = scalar.expf<afn> %ds1_0 : f32
        %ll1_0 = scalar.addf %ls1, %e1_0 : f32
        %ew1_0 = scalar.mulf %e1_0, %vs0 : f32
        %ev1_0 = vector.splat %ew1_0 : vector<16xf32>
        %aa1_0 = vector.fmaf %ev1_0, %v0, %as1 : vector<16xf32>
        %ds1_1 = scalar.subf %s1_1, %mn1 : f32
        %e1_1 = scalar.expf<afn> %ds1_1 : f32
        %ll1_1 = scalar.addf %ll1_0, %e1_1 : f32
        %ew1_1 = scalar.mulf %e1_1, %vs1 : f32
        %ev1_1 = vector.splat %ew1_1 : vector<16xf32>
        %aa1_1 = vector.fmaf %ev1_1, %v1, %aa1_0 : vector<16xf32>
        %sb2_0 = scalar.addf %sq2_0, %b2_0 : f32
        %s2_0 = scf.select %ok0, %sb2_0, %neg_inf : f32
        %sb2_1 = scalar.addf %sq2_1, %b2_1 : f32
        %s2_1 = scf.select %ok1, %sb2_1, %neg_inf : f32
        %bmc2_1 = scalar.maxnumf %s2_0, %s2_1 : f32
        %bm2_c = scalar.maxnumf %bmc2_1, %bmc2_1 : f32
        %bx2_8, %by2_8 = kernel.subgroup.shuffle<xor> %bm2_c, %i8, %i32 : f32, i32, i32
        %bm2_d = scalar.maxnumf %bm2_c, %bx2_8 : f32
        %bx2_16, %by2_16 = kernel.subgroup.shuffle<xor> %bm2_d, %i16, %i32 : f32, i32, i32
        %bm2 = scalar.maxnumf %bm2_d, %bx2_16 : f32
        %mn2 = scalar.maxnumf %m2, %bm2 : f32
        %ms2 = scalar.subf %m2, %mn2 : f32
        %al2 = scalar.expf<afn> %ms2 : f32
        %alv2 = vector.splat %al2 : vector<16xf32>
        %as2 = vector.mulf %a2, %alv2 : vector<16xf32>
        %ls2 = scalar.mulf %l2, %al2 : f32
        %ds2_0 = scalar.subf %s2_0, %mn2 : f32
        %e2_0 = scalar.expf<afn> %ds2_0 : f32
        %ll2_0 = scalar.addf %ls2, %e2_0 : f32
        %ew2_0 = scalar.mulf %e2_0, %vs0 : f32
        %ev2_0 = vector.splat %ew2_0 : vector<16xf32>
        %aa2_0 = vector.fmaf %ev2_0, %v0, %as2 : vector<16xf32>
        %ds2_1 = scalar.subf %s2_1, %mn2 : f32
        %e2_1 = scalar.expf<afn> %ds2_1 : f32
        %ll2_1 = scalar.addf %ll2_0, %e2_1 : f32
        %ew2_1 = scalar.mulf %e2_1, %vs1 : f32
        %ev2_1 = vector.splat %ew2_1 : vector<16xf32>
        %aa2_1 = vector.fmaf %ev2_1, %v1, %aa2_0 : vector<16xf32>
        scf.yield %mn0, %mn1, %mn2, %ll0_1, %ll1_1, %ll2_1, %aa0_1, %aa1_1, %aa2_1 : f32, f32, f32, f32, f32, f32, vector<16xf32>, vector<16xf32>, vector<16xf32>
      }
      vector.store %fa0, %acc_l[%wave, %quad, %c0_h, %d, %c0] : vector<16xf32>, view<8x4x3x8x16xf32>
      vector.store %fa1, %acc_l[%wave, %quad, %c1_h, %d, %c0] : vector<16xf32>, view<8x4x3x8x16xf32>
      vector.store %fa2, %acc_l[%wave, %quad, %c2_h, %d, %c0] : vector<16xf32>, view<8x4x3x8x16xf32>
      scf.if %is_d0 {
        view.store %fl0, %m_l[%wave, %quad, %c0_h] : f32, view<8x5x3xf32>
        view.store %fl1, %m_l[%wave, %quad, %c1_h] : f32, view<8x5x3xf32>
        view.store %fl2, %m_l[%wave, %quad, %c2_h] : f32, view<8x5x3xf32>
      }
      scf.if %is_l0 {
        view.store %fm0, %m_l[%wave, %c4, %c0_h] : f32, view<8x5x3xf32>
        view.store %fm1, %m_l[%wave, %c4, %c1_h] : f32, view<8x5x3xf32>
        view.store %fm2, %m_l[%wave, %c4, %c2_h] : f32, view<8x5x3xf32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %pm_v = buffer.view %pm[%zero] : buffer -> view<[%tokens]x24x64xf32>
      %pl_v = buffer.view %pl[%zero] : buffer -> view<[%tokens]x24x64xf32>
      %po_v = buffer.view %po[%zero] : buffer -> view<[%tokens]x24x64x128xf32>
      scf.for %idx = [%tid to %c384 step %cT] {
        %h_v = index.div %idx, %c128 : index
        %hh = index.assume %h_v [range(%h_v, 0, 2)] : index
        %dim_v = index.rem %idx, %c128 : index
        %dim = index.assume %dim_v [range(%dim_v, 0, 127)] : index
        %mm = scf.for %w = [%c0 to %nwa step %c1](%mx = %neg_inf : f32) -> (f32) {
          %wb = index.assume %w [range(%w, 0, 7)] : index
          %mw = view.load %m_l[%wb, %c4, %hh] : view<8x5x3xf32> -> f32
          %mxn = scalar.maxnumf %mx, %mw : f32
          scf.yield %mxn : f32
        }
        %ls_t, %os_t = scf.for %w = [%c0 to %nwa step %c1](%lt = %zero_f : f32, %ot = %zero_f : f32) -> (f32, f32) {
          %wb = index.assume %w [range(%w, 0, 7)] : index
          %mw = view.load %m_l[%wb, %c4, %hh] : view<8x5x3xf32> -> f32
          %dw = scalar.subf %mw, %mm : f32
          %fw = scalar.expf<afn> %dw : f32
          %cg0 = index.constant 0 : index
          %lw0 = view.load %m_l[%wb, %cg0, %hh] : view<8x5x3xf32> -> f32
          %ow0 = view.load %acc_r[%wb, %cg0, %hh, %dim] : view<8x4x3x128xf32> -> f32
          %cg1 = index.constant 1 : index
          %lw1 = view.load %m_l[%wb, %cg1, %hh] : view<8x5x3xf32> -> f32
          %ow1 = view.load %acc_r[%wb, %cg1, %hh, %dim] : view<8x4x3x128xf32> -> f32
          %cg2 = index.constant 2 : index
          %lw2 = view.load %m_l[%wb, %cg2, %hh] : view<8x5x3xf32> -> f32
          %ow2 = view.load %acc_r[%wb, %cg2, %hh, %dim] : view<8x4x3x128xf32> -> f32
          %cg3 = index.constant 3 : index
          %lw3 = view.load %m_l[%wb, %cg3, %hh] : view<8x5x3xf32> -> f32
          %ow3 = view.load %acc_r[%wb, %cg3, %hh, %dim] : view<8x4x3x128xf32> -> f32
          %lq01 = scalar.addf %lw0, %lw1 : f32
          %lq23 = scalar.addf %lw2, %lw3 : f32
          %lq = scalar.addf %lq01, %lq23 : f32
          %oq01 = scalar.addf %ow0, %ow1 : f32
          %oq23 = scalar.addf %ow2, %ow3 : f32
          %oq = scalar.addf %oq01, %oq23 : f32
          %ltn = scalar.fmaf %lq, %fw, %lt : f32
          %otn = scalar.fmaf %oq, %fw, %ot : f32
          scf.yield %ltn, %otn : f32, f32
        }
        %hdm_v = index.add %hd_base, %hh : index
        %hdm = index.assume %hdm_v [range(%hdm_v, 0, 23)] : index
        view.store %os_t, %po_v[%tok, %hdm, %sp, %dim] : f32, view<[%tokens]x24x64x128xf32>
        %dim0 = index.cmp eq, %dim, %c0 : index
        scf.if %dim0 {
          view.store %mm, %pm_v[%tok, %hdm, %sp] : f32, view<[%tokens]x24x64xf32>
          view.store %ls_t, %pl_v[%tok, %hdm, %sp] : f32, view<[%tokens]x24x64xf32>
        }
      }
    }
  }
  kernel.return
}
